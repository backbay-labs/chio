{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "Chio",
    "scopeName": "source.chio.yaml",
    "fileTypes": ["yaml", "chio-manifest.yaml", "chio-guard.yaml"],
    "patterns": [
        { "include": "#comment" },
        { "include": "#capability_keyword" },
        { "include": "#urn_code" },
        { "include": "#key" },
        { "include": "#string" },
        { "include": "#number" }
    ],
    "repository": {
        "comment": {
            "match": "#.*$",
            "name": "comment.line.number-sign.chio"
        },
        "capability_keyword": {
            "match": "\\b(capability|capabilities|policy|guard|guards|manifest|scope|allow|deny|version)\\b",
            "name": "keyword.control.chio"
        },
        "urn_code": {
            "match": "urn:chio:error:[a-z0-9_:-]+",
            "name": "constant.other.urn.chio"
        },
        "key": {
            "match": "^\\s*([A-Za-z_][A-Za-z0-9_-]*)\\s*:",
            "captures": {
                "1": { "name": "entity.name.tag.chio" }
            }
        },
        "string": {
            "begin": "\"",
            "end": "\"",
            "name": "string.quoted.double.chio",
            "patterns": [
                {
                    "match": "\\\\.",
                    "name": "constant.character.escape.chio"
                }
            ]
        },
        "number": {
            "match": "\\b-?[0-9]+(\\.[0-9]+)?\\b",
            "name": "constant.numeric.chio"
        }
    }
}
