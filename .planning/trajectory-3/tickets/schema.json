{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/ticket-manifest/v3",
  "title": "Chio trajectory-3 ticket manifest",
  "description": "Schema for .planning/trajectory-3/tickets/manifest.yml and per-phase tickets/M{nn}/P{n}.yml files. Tickets are atomic mergeable PRs sized 0.25-2 engineer-days. Inherits the trajectory-2 contract. Vendor-calendar milestones (M08, M09) include 0.25-day vendor-wait / vendor-evidence tickets that capture calendar dependencies without implying engineering work.",
  "type": "array",
  "items": { "$ref": "#/$defs/ticket" },
  "$defs": {
    "ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "milestone", "phase", "title", "status",
        "effort_days", "owner_glob", "shared_paths",
        "depends_on", "soft_deps", "gate_check",
        "worktree_branch", "agent_role", "review_required",
        "first_commit_sha", "merged_sha", "opened_ts", "merged_ts"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M(0[1-9]|10)\\.P[0-9]+(\\.[0-9]+)?\\.T[0-9]+(\\.[a-z0-9]+)?$",
          "description": "M{nn}.P{n}[.{n}].T{n}[.{k}]; .k allows splits without renumbering siblings."
        },
        "milestone": {
          "type": "string",
          "pattern": "^M(0[1-9]|10)$"
        },
        "phase": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 99 },
            { "type": "string", "pattern": "^[0-9]+(\\.[0-9]+)?$" }
          ]
        },
        "title": { "type": "string", "minLength": 8, "maxLength": 200 },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "review", "blocked", "merged", "vendor_wait", "vendor_evidence_received"]
        },
        "effort_days": { "type": "number", "minimum": 0.25, "maximum": 5 },
        "owner_glob": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "shared_paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths the orchestrator must serialize against; e.g. Cargo.lock"
        },
        "depends_on": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^M(0[1-9]|10)\\.P[0-9]+(\\.[0-9]+)?\\.T[0-9]+(\\.[a-z0-9]+)?$"
          },
          "description": "Hard dependencies; ticket cannot leave pending until each is merged."
        },
        "soft_deps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Soft dependencies; informational, not blocking. Cross-trajectory references go here."
        },
        "gate_check": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cmd"],
          "properties": {
            "cmd": { "type": "string" },
            "timeout_seconds": { "type": "integer", "minimum": 30 }
          }
        },
        "worktree_branch": {
          "type": "string",
          "pattern": "^wave/W[1-3v]/m(0[1-9]|10)/p[0-9]+(\\.[0-9]+)?\\.t[0-9]+(\\.[a-z0-9]+)?-[a-z0-9][a-z0-9-]{2,48}$"
        },
        "agent_role": {
          "type": "string",
          "enum": [
            "kernel-rust", "spec-rust", "spec-python", "spec-typescript",
            "spec-go", "fuzz-rust", "formal-tla", "formal-kani", "formal-lean",
            "wasm-rust", "provider-rust", "browser-ts",
            "supply-chain", "tee-rust", "infra-yaml",
            "dx-rust", "lsp-rust", "quality-rust", "crypto-rust",
            "delegate-rust", "arena-rust", "econ-rust", "framework-ts",
            "lineage-rust", "vendor-coord", "customer-coord"
          ]
        },
        "review_required": {
          "type": "array",
          "items": { "type": "string", "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?(?:/[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?)?$" },
          "description": "GitHub handles."
        },
        "first_commit_sha": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          ]
        },
        "merged_sha": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "pattern": "^[0-9a-f]{40}$" }
          ]
        },
        "opened_ts": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "merged_ts": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        }
      }
    }
  }
}
