{
  "name": "chio-world",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "lint": "next lint",
    "db:migrate": "tsx src/db/migrate.ts",
    "audit:pages": "tsx scripts/audit-docs-pages.ts",
    "audit:pages:ci": "tsx scripts/audit-docs-pages.ts --baseline .pages-audit-baseline --fail-on-new",
    "audit:prose": "tsx scripts/audit-prose.ts",
    "audit:prose:ci": "tsx scripts/audit-prose.ts --baseline .prose-audit-baseline --fail-on-new",
    "audit:arc": "tsx scripts/audit-docs-arc-refs.ts",
    "audit:arc:ci": "tsx scripts/audit-docs-arc-refs.ts --surface src/data/arc/docs-surface.json --no-binary",
    "arc:sync": "tsx scripts/sync-arc-data.ts",
    "arc:check": "tsx scripts/sync-arc-data.ts --check",
    "arc:pin": "tsx scripts/sync-arc-data.ts --pin",
    "snippets:sync": "tsx scripts/sync-snippets.ts",
    "snippets:check": "tsx scripts/sync-snippets.ts --check",
    "transcripts:capture": "tsx scripts/capture-transcripts.ts",
    "transcripts:check": "tsx scripts/capture-transcripts.ts --check",
    "transcripts:verify": "tsx scripts/capture-transcripts.ts --verify",
    "docs:cli": "tsx scripts/generate-cli-reference.ts",
    "docs:cli:check": "tsx scripts/generate-cli-reference.ts --check",
    "docs:check": "bun run docs:catalog:check && bun run test && bunx tsc --noEmit && bun run audit:prose:ci && bun run audit:pages:ci && bun run arc:check && bun run snippets:check && bun run docs:cli:check && bun run transcripts:verify && bun run audit:arc:ci",
    "docs:figures:shots": "node scripts/screenshot-diagrams.mjs --accents",
    "docs:reading:check": "playwright test tests/docs-reading-journey.spec.ts tests/docs-reading-zoom.spec.ts tests/docs-diagrams.spec.ts --project=chromium --workers=2",
    "build:search": "tsx scripts/build-search-index.ts",
    "build:search:dry": "tsx scripts/build-search-index.ts --dry-run",
    "smoke:code": "tsx scripts/smoke-code-workspace.ts",
    "docs:search:check": "tsx scripts/verify-docs-search.ts",
    "docs:agent-os:check": "python3 scripts/check-agent-os-release.py && vitest run src/lib/agentic-os/__tests__/input.test.ts",
    "docs:rust:check": "python3 scripts/check-rust-examples.py --format && python3 scripts/sync-example-runtime.py --check && python3 scripts/package-rust-examples.py --check && python3 scripts/package-megastart.py --check",
    "docs:rust:test": "python3 scripts/check-rust-examples.py --compile --clippy --test",
    "docs:rust:sync": "python3 scripts/sync-example-runtime.py && python3 scripts/check-rust-examples.py --sync && python3 scripts/package-rust-examples.py && python3 scripts/package-megastart.py",
    "docs:megastart:check": "python3 scripts/package-megastart.py --check && vitest run src/components/docs/megastart/megastart.test.tsx",
    "game:dead-drop:build": "node scripts/build-dead-drop.mjs",
    "game:dead-drop:check": "node scripts/build-dead-drop.mjs --check",
    "agents:evaluate": "tsx scripts/playground-agent/evaluate.ts",
    "agents:compare": "tsx scripts/playground-agent/compare.ts",
    "agents:coach": "tsx scripts/playground-agent/coach.ts",
    "docs:processes:check": "python3 scripts/process-examples/sync-projects.py --check && python3 scripts/sync-process-languages.py --check && tsx scripts/check-process-docs.ts && tsx scripts/process-examples/review-inventory.ts --check && python3 scripts/package-process-examples.py --check",
    "docs:catalog": "tsx scripts/generate-docs-catalog.ts",
    "docs:catalog:check": "tsx scripts/generate-docs-catalog.ts --check",
    "workshop:build": "node scripts/build-workshop-local.mjs",
    "workshop:check": "node scripts/build-workshop-local.mjs --check && vitest run src/lib/workshop src/components/workshop"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.85",
    "@ai-sdk/openai": "3.0.74",
    "@ai-sdk/react": "^3.0.210",
    "@auth/pg-adapter": "^1.11.3",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.2.3",
    "@noble/ed25519": "^3.1.0",
    "@pixiv/three-vrm": "3.5.3",
    "@pixiv/three-vrm-animation": "3.5.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@react-three/postprocessing": "^3.0.4",
    "@vercel/sandbox": "3.2.2",
    "ai": "^6.0.208",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "flags": "^4.0.6",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "mermaid": "^11.14.0",
    "next": "^15",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.20.0",
    "postprocessing": "^6.39.0",
    "react": "^19",
    "react-dom": "^19",
    "shiki": "^4.0.2",
    "thinking-orbs": "^0.1.1",
    "three": "0.183.2",
    "zod": "^4.3.6",
    "parse5": "8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@babel/parser": "^7.29.2",
    "@babel/traverse": "^7.29.0",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^22",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.183.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "yaml": "^2.9.0",
    "esbuild": "0.27.7"
  }
}
