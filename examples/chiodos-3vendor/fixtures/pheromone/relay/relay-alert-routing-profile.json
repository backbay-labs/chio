      "routeId": "auth-watch",
      "severity": "critical",
      "minWindowMs": 120000,
      "unsuppressible": true,
      "requireEventEvidence": true
    },
    {
      "alertCode": "endpoint_denied",
      "routeId": "auth-watch",
      "severity": "critical",
      "minWindowMs": 120000,
      "unsuppressible": true,
      "requireEventEvidence": false
    },
    {
      "alertCode": "catchup_denied",
      "routeId": "ops-digest",
      "severity": "warning",
      "minWindowMs": 300000,
      "unsuppressible": false,
      "requireEventEvidence": false
    },
    {
      "alertCode": "directory_expiring",
      "routeId": "ops-digest",
      "severity": "warning",
      "minWindowMs": 600000,
      "unsuppressible": false,
      "requireEventEvidence": false
    },
    {
      "alertCode": "retries_pending",
      "routeId": "ops-digest",
      "severity": "info",
      "minWindowMs": 600000,
      "unsuppressible": false,
      "requireEventEvidence": false
