    },
    {
      "id": "critical-hidden-by-suppression",
      "description": "critical firing visibility is not routeable downstream",
      "expectedCode": "alert_handoff_invalid"
    },
    {
      "id": "missing-event-evidence",
      "description": "severe alert source lacks required bounded evidence",
      "expectedCode": "alert_source_invalid"
    },
    {
      "id": "downstream-route-missing",
      "description": "routing profile route has no handoff receiver",
      "expectedCode": "alert_handoff_invalid"
