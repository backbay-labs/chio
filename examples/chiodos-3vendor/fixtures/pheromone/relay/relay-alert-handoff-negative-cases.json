  "cases": [
    {
      "id": "inline-token",
      "description": "handoff receiver target carries credential-looking material",
      "expectedCode": "alert_handoff_invalid"
    },
    {
      "id": "dynamic-url",
      "description": "handoff receiver target is a dynamic endpoint",
      "expectedCode": "alert_handoff_invalid"
    },
    {
      "id": "credential-target-ref",
      "description": "handoff receiver target ref resembles credential material",
      "expectedCode": "alert_handoff_invalid"
    },
    {
      "id": "unbounded-label",
      "description": "alert report carries an unbounded routing label",
      "expectedCode": "alert_source_invalid"
    },
    {
