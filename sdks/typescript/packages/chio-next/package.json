{
  "name": "@chio-protocol/next",
  "version": "0.1.0",
  "type": "module",
  "description": "Chio App Router route-handler and server-action wrappers for Next.js. Streaming-friendly on Allow, typed denial response on Deny. App Router only.",
  "license": "Apache-2.0",
  "keywords": [
    "chio",
    "nextjs",
    "app-router",
    "route-handler",
    "server-action",
    "verdict",
    "agent-protocol"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "next": ">=14.2 <16",
    "react": ">=18.2 <20"
  },
  "publishConfig": {
    "access": "public"
  }
}
