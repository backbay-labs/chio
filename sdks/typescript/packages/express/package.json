{
  "name": "@chio-protocol/express",
  "version": "0.1.0",
  "type": "module",
  "description": "Chio protocol middleware for Express.js",
  "license": "Apache-2.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc && npm run build:cjs",
    "build:cjs": "esbuild src/index.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@chio-protocol/node-http": "0.1.0"
  },
  "peerDependencies": {
    "express": ">=4.18.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.1",
    "express": "^5.1.0",
    "typescript": "~5.7.0",
    "vitest": "^3.0.0"
  },
  "overrides": {
    "vite": {
      ".": "7.3.5",
      "esbuild": "0.28.1"
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
