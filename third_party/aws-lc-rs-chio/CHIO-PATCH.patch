+#![allow(deprecated)]
+use aws_lc_rs::cipher::{DecryptingKey, EncryptingKey, StreamingEncryptingKey,
+ UnboundCipherKey, DES_FOR_LEGACY_USE_ONLY, DES_EDE_FOR_LEGACY_USE_ONLY,
+ DES_EDE3_FOR_LEGACY_USE_ONLY};
+fn variant(mut key: [u8;8], mask: u8) -> [u8;8] {
+ for (i, b) in key.iter_mut().enumerate() { *b ^= (mask >> i) & 1; }
+ key
+}
+#[test]
+fn rejects_every_parity_variant_of_weak_des_key() {
+ let weak_keys = [
+  [0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01, 0x01],
+  [0xFE, 0xFE, 0xFE, 0xFE, 0xFE, 0xFE, 0xFE, 0xFE],
+  [0x1F, 0x1F, 0x1F, 0x1F, 0x0E, 0x0E, 0x0E, 0x0E],
+  [0xE0, 0xE0, 0xE0, 0xE0, 0xF1, 0xF1, 0xF1, 0xF1],
+  [0x01, 0xFE, 0x01, 0xFE, 0x01, 0xFE, 0x01, 0xFE],
+  [0xFE, 0x01, 0xFE, 0x01, 0xFE, 0x01, 0xFE, 0x01],
+  [0x1F, 0xE0, 0x1F, 0xE0, 0x0E, 0xF1, 0x0E, 0xF1],
+  [0xE0, 0x1F, 0xE0, 0x1F, 0xF1, 0x0E, 0xF1, 0x0E],
+  [0x01, 0xE0, 0x01, 0xE0, 0x01, 0xF1, 0x01, 0xF1],
+  [0xE0, 0x01, 0xE0, 0x01, 0xF1, 0x01, 0xF1, 0x01],
+  [0x1F, 0xFE, 0x1F, 0xFE, 0x0E, 0xFE, 0x0E, 0xFE],
+  [0xFE, 0x1F, 0xFE, 0x1F, 0xFE, 0x0E, 0xFE, 0x0E],
+  [0x01, 0x1F, 0x01, 0x1F, 0x01, 0x0E, 0x01, 0x0E],
+  [0x1F, 0x01, 0x1F, 0x01, 0x0E, 0x01, 0x0E, 0x01],
+  [0xE0, 0xFE, 0xE0, 0xFE, 0xF1, 0xFE, 0xF1, 0xFE],
+  [0xFE, 0xE0, 0xFE, 0xE0, 0xFE, 0xF1, 0xFE, 0xF1],
+ ];
+ for weak in weak_keys {
+ for mask in 0..=255 {
+  let key=variant(weak,mask);
+  assert!(EncryptingKey::cbc(UnboundCipherKey::new(&DES_FOR_LEGACY_USE_ONLY,&key).unwrap()).is_err(), "weak parity mask {mask}");
+  assert!(StreamingEncryptingKey::cbc_pkcs7(UnboundCipherKey::new(&DES_FOR_LEGACY_USE_ONLY,&key).unwrap()).is_err(), "streaming weak parity mask {mask}");
+ }
+ }
+}
+#[test]
+fn rejects_effectively_equal_tdea_subkeys() {
+ let first=[0x01,0x23,0x45,0x67,0x89,0xab,0xcd,0xef];
+ let distinct=[0x23,0x45,0x67,0x89,0xab,0xcd,0xef,0x01];
+ for mask in 0..=255 {
+  let second=variant(first,mask);
+  let pair=[first,second].concat();
+  assert!(EncryptingKey::cbc(UnboundCipherKey::new(&DES_EDE_FOR_LEGACY_USE_ONLY,&pair).unwrap()).is_err(), "2TDEA parity mask {mask}");
+  for keys in [[first,second,distinct],[distinct,first,second],[first,distinct,second]] {
+   let bytes=keys.concat();
+   assert!(EncryptingKey::cbc(UnboundCipherKey::new(&DES_EDE3_FOR_LEGACY_USE_ONLY,&bytes).unwrap()).is_err(), "3TDEA parity mask {mask}");
+   assert!(DecryptingKey::cbc(UnboundCipherKey::new(&DES_EDE3_FOR_LEGACY_USE_ONLY,&bytes).unwrap()).is_err(), "3TDEA decrypt parity mask {mask}");
+   assert!(StreamingEncryptingKey::cbc_pkcs7(UnboundCipherKey::new(&DES_EDE3_FOR_LEGACY_USE_ONLY,&bytes).unwrap()).is_err(), "3TDEA streaming parity mask {mask}");
+  }
+ }
+}
+#[test]
+fn accepts_distinct_nonweak_keys_with_arbitrary_parity() {
+ let key=[0x00,0x22,0x44,0x66,0x88,0xaa,0xcc,0xee,0x22,0x44,0x66,0x88,0xaa,0xcc,0xee,0x00];
+ assert!(EncryptingKey::cbc(UnboundCipherKey::new(&DES_EDE_FOR_LEGACY_USE_ONLY,&key).unwrap()).is_ok());
+}
