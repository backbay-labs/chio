# Copy this file to .env before running the stack.
#
# Secrets stay local. The repository tracks this template only.

# Graphiti and optional CocoIndex LLM extraction.
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
CHIO_KB_LLM_MODEL=openai/gpt-4o-mini
CHIO_KB_LLM_EXTRACT=1
CHIO_KB_EMBED_MODEL=text-embedding-3-small
# Optional later local profile: replace the embedding backend with sentence-transformers
# before setting a local embedding model here. OpenAI embeddings are the default.
CHIO_KB_MAX_INFLIGHT_COMPONENTS=8
COCOINDEX_SOURCE_MAX_INFLIGHT_ROWS=8
SEMAPHORE_LIMIT=5

# Local graph database.
NEO4J_USER=neo4j
NEO4J_PASSWORD=demodemo
NEO4J_DATABASE=neo4j
NEO4J_URI=bolt://localhost:7687
GRAPHITI_GROUP_ID=chio-repo
GRAPHITI_TELEMETRY_ENABLED=false

# Local vector and CocoIndex storage.
COCOINDEX_DB=.cocoindex/chio-kb
POSTGRES_DB=chio_kb
POSTGRES_USER=cocoindex
POSTGRES_PASSWORD=cocoindex
POSTGRES_URL=postgres://cocoindex:cocoindex@localhost:55432/chio_kb

# Repo and service ports.
CHIO_KB_REPO_ROOT=../..
# Repository identity returned by kb_manifest. Deployment automation should
# pin SHA and indexed-at to the exact snapshot used for ingestion.
CHIO_KB_REPOSITORY=bb-connor/arc
CHIO_KB_REPOSITORY_URL=https://github.com/bb-connor/arc
CHIO_KB_GIT_REF=
CHIO_KB_GIT_SHA=
CHIO_KB_INDEXED_AT=
CHIO_KB_INDEX_ID=
CHIO_KB_MCP_HOST=127.0.0.1
CHIO_KB_MCP_PORT=8111
# Required for kb_add_episode when the MCP server is reached from a
# non-loopback peer, such as Docker bridge traffic to a container listener.
CHIO_KB_MCP_BEARER_TOKEN=
GRAPHITI_MCP_URL=http://localhost:8000/mcp
GRAPHITI_MCP_HOST_HEADER=
