#!/bin/sh
# kramdown-rfc runs "aasvg --spaces=1" for ~~~ aasvg figures. aasvg styles its
# output with a <style> element, which the RFC 7996 SVG profile does not allow.
# This wrapper runs the real aasvg (the next one on PATH) with --compatible and
# moves its style rules onto the elements as attributes.
self_dir=$(cd "$(dirname "$0")" && pwd)
IFS=:
for dir in $PATH; do
  [ "$dir" = "$self_dir" ] && continue
  if [ -x "$dir/aasvg" ]; then
    "$dir/aasvg" "$@" --compatible | python3 "$self_dir/../svg_inline_styles.py"
    exit $?
  fi
done
echo "aasvg: not found on PATH (npm install -g aasvg)" >&2
exit 127
