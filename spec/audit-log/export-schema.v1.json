{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/spec/audit-log/export-schema.v1.json",
  "title": "Chio Audit Log Export Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "tenant_id",
    "capability_id",
    "tool_id",
    "decision",
    "guard_id",
    "reason_code",
    "timestamp",
    "actor_subject",
    "redaction_status",
    "policy_hash",
    "checkpoint_id",
    "ocsf",
    "cef"
  ],
  "properties": {
    "schema_version": {
      "const": "chio.audit-log.export.v1"
    },
    "receipt_id": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "description": "Single healthcare design-partner tenant identifier. Public partner identity is not embedded."
    },
    "capability_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "decision": {
      "enum": ["allow", "deny", "cancelled", "incomplete"]
    },
    "guard_id": {
      "type": "string",
      "minLength": 1
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "actor_subject": {
      "type": "string",
      "minLength": 1
    },
    "redaction_status": {
      "enum": ["clean", "redacted", "blocked", "unknown"]
    },
    "policy_hash": {
      "type": "string",
      "minLength": 1
    },
    "checkpoint_id": {
      "type": "string",
      "minLength": 1
    },
    "ocsf": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema_version", "category_uid", "class_uid", "class_name"],
      "properties": {
        "schema_version": {
          "const": "1.3.0"
        },
        "category_uid": {
          "const": 3,
          "description": "OCSF IAM category."
        },
        "class_uid": {
          "const": 3002,
          "description": "OCSF Authorization class."
        },
        "class_name": {
          "const": "Authorization"
        }
      },
      "description": "OCSF 1.3.0 Authorization mapping from crates/chio-siem/src/ocsf.rs."
    },
    "cef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "device_vendor", "device_product", "signature_id", "name", "severity", "extension"],
      "properties": {
        "version": {
          "const": "CEF:0"
        },
        "device_vendor": {
          "const": "Backbay Labs"
        },
        "device_product": {
          "const": "Chio"
        },
        "signature_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "extension": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "required": ["rt", "msg", "cs1Label", "cs1", "cs2Label", "cs2", "cs3Label", "cs3", "cs4Label", "cs4"]
        }
      },
      "description": "CEF v1 export profile. The design-partner SOC preference is ArcSight-compatible CEF; LEEF is reserved for QRadar deployments."
    },
    "splunk_hec": {
      "type": "object",
      "additionalProperties": true,
      "description": "Optional transport envelope for Splunk HEC sinks."
    },
    "leef": {
      "type": "object",
      "additionalProperties": true,
      "description": "Reserved for QRadar-shaped deployments. v1 ships CEF, not LEEF."
    }
  }
}
