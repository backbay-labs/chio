{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-lineage/v1/signed-subgraph.schema.json",
  "title": "Chio Signed Lineage Subgraph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "transaction_passport_ref",
    "policy_profile_id",
    "generated_at",
    "audience",
    "challenge_nonce",
    "frontier_sha256",
    "checkpoint_ref",
    "checkpoint_inclusion_sha256",
    "max_depth",
    "required_evidence_class",
    "lineage_anchor_ref",
    "redaction_map_sha256",
    "leakage_ledger_sha256",
    "projection_manifest_sha256",
    "root_receipt_ids",
    "nodes",
    "edges",
    "redactions",
    "subgraph_sha256",
    "signature"
  ],
  "properties": {
    "schema": { "const": "chio.lineage.signed-subgraph.v1" },
    "id": { "type": "string", "minLength": 1 },
    "transaction_passport_ref": { "type": "string", "minLength": 1 },
    "policy_profile_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "challenge_nonce": { "type": "string", "minLength": 1 },
    "frontier_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "checkpoint_ref": { "type": "string", "minLength": 1 },
    "checkpoint_inclusion_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "max_depth": { "type": "integer", "minimum": 0 },
    "required_evidence_class": { "enum": ["asserted", "observed", "verified", "derived"] },
    "lineage_anchor_ref": { "type": "string", "minLength": 1 },
    "redaction_map_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "leakage_ledger_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "projection_manifest_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "root_receipt_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "receipt_ref",
          "artifact_sha256",
          "artifact_schema",
          "evidence_class",
          "tenant_hash",
          "source_table",
          "source_id_hash",
          "depth",
          "parent_ids",
          "disclosure_state"
        ],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": [
              "receipt",
              "capability_snapshot",
              "session_anchor",
              "request_lineage_record",
              "receipt_lineage_statement",
              "continuation_token",
              "checkpoint",
              "bbs_projection",
              "bbs_proof",
              "passport_presentation",
              "governed_intent",
              "approval_token",
              "runtime_assurance"
            ]
          },
          "receipt_ref": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "artifact_schema": { "type": "string", "minLength": 1 },
          "evidence_class": { "enum": ["observed", "verified", "asserted", "derived"] },
          "tenant_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "source_table": { "type": "string", "minLength": 1 },
          "source_id_hash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "depth": { "type": "integer", "minimum": 0 },
          "parent_ids": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "disclosure_state": { "enum": ["disclosed", "redacted"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edge_id",
          "from",
          "to",
          "relation",
          "kind",
          "evidence_class",
          "source_artifact_sha256",
          "statement_sha256",
          "disclosure_state"
        ],
        "properties": {
          "edge_id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "relation": { "enum": ["continued", "derived", "delegated"] },
          "kind": {
            "enum": [
              "parent_of",
              "issued_under",
              "observed_in_session",
              "continued_by",
              "signed_lineage_statement",
              "included_in_checkpoint",
              "proves_projection",
              "governs_transaction",
              "approves_intent",
              "presented_by"
            ]
          },
          "evidence_class": { "enum": ["observed", "verified", "asserted", "derived"] },
          "source_artifact_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "statement_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "disclosure_state": { "enum": ["disclosed", "redacted"] }
        }
      }
    },
    "redactions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "reason"],
        "properties": {
          "node_id": { "type": "string", "minLength": 1 },
          "reason": { "enum": ["privacy_profile", "data_minimization", "legal_hold"] }
        }
      }
    },
    "subgraph_sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "signature": { "type": "string", "minLength": 1 }
  }
}
