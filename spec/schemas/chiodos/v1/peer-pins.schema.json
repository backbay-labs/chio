{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "peer-pins.schema.json",
  "title": "Chiodos Peer Pins",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "peers", "vendors", "actionClasses"],
  "properties": {
    "schema": { "const": "chio.chiodos.peer-pins.v1" },
    "peers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "verifier-trust-bundle.schema.json#/$defs/peerLadderBinding" }
    },
    "vendors": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "verifier-trust-bundle.schema.json#/$defs/vendorKeyBinding" }
    },
    "actionClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "verifier-trust-bundle.schema.json#/$defs/actionClass" }
    }
  }
}
