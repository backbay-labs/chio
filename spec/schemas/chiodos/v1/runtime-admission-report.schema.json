{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-admission-report.schema.json",
  "title": "Chiodos Runtime Admission Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admissionId",
    "accepted",
    "checks",
    "receiptMetadata"
  ],
  "properties": {
    "schema": { "const": "chio.chiodos.runtime-admission-report.v1" },
    "admissionId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "pheromoneAdvisory": { "$ref": "#/$defs/pheromoneAdvisory" },
    "pheromonePolicyDecision": {
      "$ref": "runtime-pheromone-policy-decision.schema.json"
    },
    "receiptMetadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" }
      }
    },
    "pheromoneAdvisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceReportSha256",
        "accepted",
        "subjectClass",
        "subjectClassNamespace",
        "totalStrength",
        "distinctOriginPairs",
        "reputationEpoch",
        "evaluatedAtUnixMs",
        "observeOnly"
      ],
      "properties": {
        "sourceReportSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "accepted": { "type": "boolean" },
        "subjectClass": { "type": "string", "minLength": 1 },
        "subjectClassNamespace": { "type": "string", "minLength": 1 },
        "totalStrength": { "type": "number", "minimum": 0 },
        "distinctOriginPairs": { "type": "integer", "minimum": 0 },
        "reputationEpoch": { "type": "integer", "minimum": 0 },
        "evaluatedAtUnixMs": { "type": "integer", "minimum": 0 },
        "observeOnly": { "const": true }
      }
    }
  }
}
