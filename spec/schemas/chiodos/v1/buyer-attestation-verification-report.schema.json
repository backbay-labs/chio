{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "buyer-attestation-verification-report.schema.json",
  "title": "Chiodos Buyer Attestation Verification Report",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "accepted": { "const": false } },
        "required": ["accepted"]
      },
      "then": { "required": ["failureCode"] }
    }
  ],
  "required": ["schema", "packetId", "accepted", "checks"],
  "properties": {
    "schema": { "const": "chio.chiodos.buyer-attestation-verification-report.v1" },
    "packetId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
