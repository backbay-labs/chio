{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.dev/schemas/chiodos/v1/verifier-report.schema.json",
  "title": "Chiodos Verifier Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "packageSha256", "accepted", "checks"],
  "properties": {
    "schema": { "const": "chio.chiodos.verifier-report.v1" },
    "packageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "accepted": { "type": "boolean" },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name", "passed"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "detail": { "type": "string" }
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
      "then": {
        "properties": {
          "checks": { "minItems": 1 }
        },
        "not": { "required": ["failure"] }
      }
    },
    {
      "if": { "properties": { "accepted": { "const": false } }, "required": ["accepted"] },
      "then": { "required": ["failure"] }
    }
  ]
}
