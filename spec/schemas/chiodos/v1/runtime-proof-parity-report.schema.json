{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-proof-parity-report.schema.json",
  "title": "Chiodos Runtime Proof Parity Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "accepted",
    "generatedAtUnixMs",
    "staticProofPackageSha256",
    "runtimeProofPackageSha256",
    "staticVerifierReportSha256",
    "runtimeVerifierReportSha256",
    "comparedFields",
    "mismatches"
  ],
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": false } }, "required": ["accepted"] },
      "then": { "required": ["failureCode"] }
    },
    {
      "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
      "then": { "not": { "required": ["failureCode"] } }
    }
  ],
  "properties": {
    "schema": { "const": "chio.chiodos.runtime-proof-parity-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "staticProofPackageSha256": { "$ref": "#/$defs/sha256" },
    "runtimeProofPackageSha256": { "$ref": "#/$defs/sha256" },
    "staticVerifierReportSha256": { "$ref": "#/$defs/sha256" },
    "runtimeVerifierReportSha256": { "$ref": "#/$defs/sha256" },
    "comparedFields": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "mismatches": {
      "type": "array",
      "items": { "$ref": "#/$defs/mismatch" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "staticValueSha256", "runtimeValueSha256"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "staticValueSha256": { "$ref": "#/$defs/sha256" },
        "runtimeValueSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
