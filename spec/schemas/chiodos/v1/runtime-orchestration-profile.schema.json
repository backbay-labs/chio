{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-orchestration-profile.schema.json",
  "title": "Chiodos Runtime Orchestration Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "profileId", "localKernelId", "verifierId", "mode", "issuedAtUnixMs", "expiresAtUnixMs", "maxConcurrentRuns", "failClosedOn"],
  "properties": {
    "schema": { "const": "chio.chiodos.runtime-orchestration-profile.v1" },
    "profileId": { "type": "string", "minLength": 1 },
    "localKernelId": { "type": "string", "minLength": 1 },
    "verifierId": { "type": "string", "minLength": 1 },
    "mode": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "maxConcurrentRuns": { "type": "integer", "minimum": 1 },
    "failClosedOn": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_]+$" } }
  }
}
