{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-proof-regeneration-report.schema.json",
  "title": "Chiodos Runtime Proof Regeneration Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "accepted",
    "generatedAtUnixMs",
    "sourceRecords",
    "checks"
  ],
  "properties": {
    "schema": { "const": "chio.chiodos.runtime-proof-regeneration-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "proofPackageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "verifierReportSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowReceiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRecords": {
      "type": "array",
      "items": { "$ref": "#/$defs/sourceRecord" }
    },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "accepted": { "const": true } },
        "required": ["accepted"]
      },
      "then": {
        "required": [
          "proofPackageSha256",
          "verifierReportSha256",
          "workflowReceiptSha256"
        ]
      }
    }
  ],
  "$defs": {
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stepIndex",
        "admissionReportSha256",
        "toolReceiptSha256",
        "bilateralDsseSha256",
        "workflowStepSha256"
      ],
      "properties": {
        "stepIndex": { "type": "integer", "minimum": 0 },
        "admissionReportSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "toolReceiptSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "bilateralDsseSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "workflowStepSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
