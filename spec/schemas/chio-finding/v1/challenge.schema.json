{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/challenge.schema.json",
  "title": "Chio Finding Challenge (signed envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "signerKey",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "challenge_id",
        "finding_id",
        "finding_artifact_sha256",
        "listing_id",
        "terms_envelope_sha256",
        "profile_envelope_sha256",
        "venue_admission_envelope_sha256",
        "backing_envelope_sha256",
        "filed_at",
        "affected_deliveries",
        "authorization",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "chio.finding.challenge.v1"
        },
        "challenge_id": {
          "$ref": "#/$defs/sha256"
        },
        "finding_id": {
          "$ref": "#/$defs/sha256"
        },
        "finding_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "listing_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "terms_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "profile_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "venue_admission_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "backing_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "filed_at": {
          "$ref": "#/$defs/iJsonU64NonZero"
        },
        "affected_deliveries": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/affectedDelivery"
          }
        },
        "authorization": {
          "$ref": "#/$defs/authorization"
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "signerKey": {
      "$ref": "#/$defs/ed25519PublicKey"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "$defs": {
    "affectedDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_sha256",
        "checkpoint_ref",
        "checkpoint_sha256"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "checkpoint_ref": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "buyer_submission"
          ],
          "properties": {
            "buyer_submission": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "challenger",
                "dispute_fee_terminal",
                "dispute_lock_ref",
                "standing"
              ],
              "properties": {
                "challenger": {
                  "$ref": "#/$defs/ed25519PublicKey"
                },
                "dispute_fee_terminal": {
                  "$ref": "#/$defs/disputeFeeTerminal"
                },
                "dispute_lock_ref": {
                  "$ref": "#/$defs/disputeLockRef"
                },
                "standing": {
                  "$ref": "#/$defs/standing"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "venue_audit"
          ],
          "properties": {
            "venue_audit": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "audit_epoch_envelope_sha256",
                "selection_digest",
                "authorization_digest"
              ],
              "properties": {
                "audit_epoch_envelope_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "selection_digest": {
                  "$ref": "#/$defs/sha256"
                },
                "authorization_digest": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      ]
    },
    "boundedIdentifier": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 512
    },
    "checkpointRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_ref",
        "checkpoint_sha256"
      ],
      "properties": {
        "checkpoint_ref": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "disputeFeeTerminal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fee_schedule_envelope_sha256",
        "event",
        "payer",
        "amount",
        "beneficiary_pool_principal_id",
        "rail_destination"
      ],
      "properties": {
        "fee_schedule_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event": {
          "enum": [
            "challenge_filing"
          ]
        },
        "payer": {
          "$ref": "#/$defs/ed25519PublicKey"
        },
        "amount": {
          "$ref": "#/$defs/monetaryAmount"
        },
        "beneficiary_pool_principal_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "rail_destination": {
          "$ref": "#/$defs/boundedIdentifier"
        }
      }
    },
    "disputeLockRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lock_id",
        "class",
        "fee_schedule_envelope_sha256",
        "amount",
        "expiry"
      ],
      "properties": {
        "lock_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "class": {
          "enum": [
            "dispute"
          ]
        },
        "fee_schedule_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "amount": {
          "$ref": "#/$defs/monetaryAmount"
        },
        "expiry": {
          "$ref": "#/$defs/iJsonU64NonZero"
        }
      }
    },
    "ed25519PublicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "digest_mismatch"
          ],
          "properties": {
            "digest_mismatch": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "failed_delivery_envelope_sha256",
                "deny_receipt_ref",
                "deny_checkpoint_ref"
              ],
              "properties": {
                "failed_delivery_envelope_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "deny_receipt_ref": {
                  "$ref": "#/$defs/receiptRef"
                },
                "deny_checkpoint_ref": {
                  "$ref": "#/$defs/checkpointRef"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "evidence_invalid"
          ],
          "properties": {
            "evidence_invalid": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "challenged_evidence_receipt_refs",
                "challenged_checkpoint_ref",
                "purchase_record_envelope_sha256"
              ],
              "properties": {
                "challenged_evidence_receipt_refs": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "uniqueItems": true,
                  "items": {
                    "$ref": "#/$defs/receiptRef"
                  }
                },
                "challenged_checkpoint_ref": {
                  "$ref": "#/$defs/checkpointRef"
                },
                "purchase_record_envelope_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replay_contradiction"
          ],
          "properties": {
            "replay_contradiction": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "reproduction",
                "recipe_preimage",
                "purchase_record_envelope_sha256"
              ],
              "properties": {
                "reproduction": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "receipt_ref",
                      "checkpoint_ref",
                      "observation_bytes"
                    ],
                    "properties": {
                      "receipt_ref": {
                        "$ref": "#/$defs/receiptRef"
                      },
                      "checkpoint_ref": {
                        "$ref": "#/$defs/checkpointRef"
                      },
                      "observation_bytes": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 16384
                      }
                    }
                  }
                },
                "recipe_preimage": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 65536
                },
                "purchase_record_envelope_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      ]
    },
    "iJsonU64NonZero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "monetaryAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "currency"
      ],
      "properties": {
        "units": {
          "$ref": "#/$defs/iJsonU64NonZero"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "receiptRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "receipt_sha256"
      ],
      "properties": {
        "receipt_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "receipt_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "standing": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "failed_delivery"
          ],
          "properties": {
            "failed_delivery": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "failed_delivery_id",
                "failed_delivery_envelope_sha256"
              ],
              "properties": {
                "failed_delivery_id": {
                  "$ref": "#/$defs/sha256"
                },
                "failed_delivery_envelope_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "finalized_purchase"
          ],
          "properties": {
            "finalized_purchase": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "purchase_key",
                "purchase_record_envelope_sha256"
              ],
              "properties": {
                "purchase_key": {
                  "$ref": "#/$defs/sha256"
                },
                "purchase_record_envelope_sha256": {
                  "$ref": "#/$defs/sha256"
                }
              }
            }
          }
        }
      ]
    }
  }
}
