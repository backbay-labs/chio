{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-finding/bond-observation-request/v1",
  "title": "Chio Finding Bond Observation Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "enforcementEnvelopeSha256",
    "bondSnapshotEnvelopeSha256",
    "enforcementId",
    "liabilityKey",
    "chainId",
    "vaultContract",
    "vaultId",
    "blockNumber",
    "blockHash",
    "identityRegistryRecord",
    "operatorKeyHash",
    "operatorKeyEpoch",
    "finalityRequirement"
  ],
  "properties": {
    "schema": { "const": "chio.finding.bond-observation-request.v1" },
    "operation": { "enum": ["observe", "observe_reconciliation"] },
    "enforcementEnvelopeSha256": { "$ref": "#/$defs/digest" },
    "bondSnapshotEnvelopeSha256": { "$ref": "#/$defs/digest" },
    "enforcementId": { "$ref": "#/$defs/digest" },
    "liabilityKey": { "$ref": "#/$defs/digest" },
    "chainId": { "$ref": "#/$defs/text" },
    "vaultContract": { "$ref": "#/$defs/text" },
    "vaultId": { "$ref": "#/$defs/text" },
    "blockNumber": { "$ref": "#/$defs/nonzeroIJsonU64" },
    "blockHash": { "$ref": "#/$defs/chainHash" },
    "identityRegistryRecord": { "$ref": "#/$defs/text" },
    "operatorKeyHash": { "$ref": "#/$defs/chainHash" },
    "operatorKeyEpoch": { "$ref": "#/$defs/nonzeroIJsonU64" },
    "finalityRequirement": { "$ref": "#/$defs/finalityRequirement" }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "chainHash": {
      "type": "string",
      "pattern": "^(0x)?[0-9a-f]{64}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "nonzeroIJsonU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "finalityRequirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "deterministic" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "min_depth"],
          "properties": {
            "kind": { "const": "confirmations" },
            "min_depth": { "$ref": "#/$defs/nonzeroIJsonU64" }
          }
        }
      ]
    }
  }
}
