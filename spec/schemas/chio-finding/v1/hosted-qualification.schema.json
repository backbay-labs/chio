{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/hosted-qualification.schema.json",
  "title": "Chio Hosted Finding Market Qualification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "candidateSha",
    "generatedAt",
    "source",
    "workflowRunId",
    "workflowRunAttempt",
    "mode",
    "decision",
    "codeQualified",
    "kvmQualified",
    "networkQualified",
    "productionReady",
    "promotionReady",
    "kvmEvidenceSha256",
    "claims",
    "gates"
  ],
  "properties": {
    "schema": {
      "const": "chio.finding.hosted-qualification.v1"
    },
    "candidateSha": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "enum": ["github-actions", "local"]
    },
    "workflowRunId": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "workflowRunAttempt": {
      "$ref": "#/$defs/nullableIdentifier"
    },
    "mode": {
      "enum": ["code-only", "kvm-boundary"]
    },
    "decision": {
      "enum": ["qualified-code-boundary", "qualified-kvm-boundary"]
    },
    "codeQualified": {
      "const": true
    },
    "kvmQualified": {
      "type": "boolean"
    },
    "networkQualified": {
      "const": false
    },
    "productionReady": {
      "const": false
    },
    "promotionReady": {
      "const": false
    },
    "kvmEvidenceSha256": {
      "oneOf": [
        { "$ref": "#/$defs/sha256" },
        { "type": "null" }
      ]
    },
    "claims": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "claim.finding.hosted_postgres_rls_forced",
          "claim.finding.hosted_runtime_role_least_privilege",
          "claim.finding.hosted_remote_custody",
          "claim.finding.hosted_settlement_transport",
          "claim.finding.hosted_worker_protocol"
        ]
      }
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "command", "result", "log", "logSha256"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192,
            "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
          },
          "result": {
            "const": "passed"
          },
          "log": {
            "type": "string",
            "pattern": "^logs/[a-z0-9][a-z0-9-]{0,63}\\.log$"
          },
          "logSha256": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "mode": { "const": "code-only" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "decision": { "const": "qualified-code-boundary" },
          "kvmQualified": { "const": false },
          "kvmEvidenceSha256": { "type": "null" }
        }
      }
    },
    {
      "if": {
        "properties": { "mode": { "const": "kvm-boundary" } },
        "required": ["mode"]
      },
      "then": {
        "properties": {
          "decision": { "const": "qualified-kvm-boundary" },
          "kvmQualified": { "const": true },
          "kvmEvidenceSha256": { "$ref": "#/$defs/sha256" }
        }
      }
    }
  ],
  "$defs": {
    "nullableIdentifier": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
        },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
