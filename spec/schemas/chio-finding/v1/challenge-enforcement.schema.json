{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/challenge-enforcement.schema.json",
  "title": "Chio Finding Challenge Enforcement (signed envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "signerKey",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "enforcement_id",
        "liability_key",
        "finding_id",
        "listing_id",
        "outcome_id",
        "outcome_envelope_sha256",
        "penalty_envelope_sha256",
        "bond_snapshot_envelope_sha256",
        "purchase_snapshot_digest",
        "deterministic_allocation_digest",
        "seller_allocation_id",
        "vault",
        "amount",
        "destinations",
        "effect_intents",
        "finalized_at"
      ],
      "properties": {
        "schema": {
          "const": "chio.finding.challenge-enforcement.v1"
        },
        "enforcement_id": {
          "$ref": "#/$defs/sha256"
        },
        "liability_key": {
          "$ref": "#/$defs/sha256"
        },
        "finding_id": {
          "$ref": "#/$defs/sha256"
        },
        "listing_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "outcome_id": {
          "$ref": "#/$defs/sha256"
        },
        "outcome_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "penalty_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bond_snapshot_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "purchase_snapshot_digest": {
          "$ref": "#/$defs/sha256"
        },
        "deterministic_allocation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "seller_allocation_id": {
          "$ref": "#/$defs/sha256"
        },
        "vault": {
          "$ref": "#/$defs/vaultReference"
        },
        "amount": {
          "$ref": "#/$defs/monetaryAmount"
        },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "destination",
              "amount"
            ],
            "properties": {
              "destination": {
                "$ref": "#/$defs/boundedIdentifier"
              },
              "amount": {
                "$ref": "#/$defs/monetaryAmount"
              }
            }
          }
        },
        "effect_intents": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "intent_id"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "seller_impair",
                  "challenge_bond",
                  "fee",
                  "root_intent",
                  "retraction"
                ]
              },
              "intent_id": {
                "$ref": "#/$defs/sha256"
              }
            }
          },
          "allOf": [
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "seller_impair"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "root_intent"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            {
              "contains": {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "retraction"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            }
          ]
        },
        "finalized_at": {
          "$ref": "#/$defs/iJsonU64NonZero"
        }
      }
    },
    "signerKey": {
      "$ref": "#/$defs/ed25519PublicKey"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "$defs": {
    "boundedIdentifier": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 512
    },
    "ed25519PublicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "iJsonU64NonZero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "monetaryAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "units",
        "currency"
      ],
      "properties": {
        "units": {
          "$ref": "#/$defs/iJsonU64NonZero"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "vaultReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chain_id",
        "vault_contract",
        "vault_id"
      ],
      "properties": {
        "chain_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "vault_contract": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "vault_id": {
          "$ref": "#/$defs/boundedIdentifier"
        }
      }
    }
  }
}
