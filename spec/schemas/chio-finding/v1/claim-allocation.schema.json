{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/claim-allocation.schema.json",
  "title": "Chio Finding Claim Allocation",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "allocation_id", "liability_key", "purchase_snapshot_sha256", "deterministic_allocation_sha256", "cutoff_slot", "total_realized_spend_units", "slash", "buyer_pool_units", "community_fund_units", "entries", "recorded_at"],
      "properties": {
        "schema": { "const": "chio.finding.claim-allocation.v1" },
        "allocation_id": { "$ref": "#/$defs/sha256" },
        "liability_key": { "$ref": "#/$defs/sha256" },
        "purchase_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "deterministic_allocation_sha256": { "$ref": "#/$defs/sha256" },
        "cutoff_slot": { "$ref": "#/$defs/nonzero" },
        "total_realized_spend_units": { "$ref": "#/$defs/u64" },
        "slash": { "$ref": "#/$defs/nonzeroMoney" },
        "buyer_pool_units": { "$ref": "#/$defs/u64" },
        "community_fund_units": { "$ref": "#/$defs/u64" },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["beneficiary_kind", "destination", "amount_units"],
            "properties": {
              "beneficiary_kind": { "enum": ["buyer", "community_fund"] },
              "destination": { "$ref": "#/$defs/id" },
              "amount_units": { "$ref": "#/$defs/nonzero" }
            }
          }
        },
        "recorded_at": { "$ref": "#/$defs/nonzero" }
      }
    },
    "signerKey": { "$ref": "#/$defs/key" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "key": { "$ref": "#/$defs/sha256" },
    "id": { "type": "string", "pattern": "\\S", "maxLength": 512 },
    "u64": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nonzero": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonzeroMoney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/nonzero" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
