{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/verifier-report.schema.json",
  "title": "Chio Finding Verifier Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "signerKey",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "report_id",
        "finding_id",
        "finding_artifact_sha256",
        "verifier_profile_id",
        "verifier_profile_envelope_sha256",
        "verifier_implementation_id",
        "resolved_evidence_bundle_sha256",
        "trust_root_snapshot_sha256",
        "resolver_policy_sha256",
        "trusted_time_input_sha256",
        "facets",
        "verifier_authority",
        "verifier_key_epoch",
        "evaluation_time"
      ],
      "properties": {
        "schema": {
          "const": "chio.finding.verifier-report.v1"
        },
        "report_id": {
          "$ref": "#/$defs/sha256"
        },
        "finding_id": {
          "$ref": "#/$defs/sha256"
        },
        "finding_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_profile_id": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_profile_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_implementation_id": {
          "$ref": "#/$defs/nonBlankString"
        },
        "resolved_evidence_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "replay_recipe_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "status_proof_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "finding_delivery_receipt_id": {
          "$ref": "#/$defs/sha256"
        },
        "finding_delivery": {
          "$ref": "#/$defs/findingDelivery"
        },
        "trust_root_snapshot_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolver_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "trusted_time_input_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "facets": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "prefixItems": [
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "artifact_integrity"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "receipt_authenticity"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "checkpoint_membership"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "kernel_and_revocation_trust"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "issuer_lineage"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "recipe_binding"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "intent_binding"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "metered_exposure_backing"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "settled_spend_backing"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "runtime_assurance_backing"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "bond_backing"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "status_liveness"
                }
              }
            },
            {
              "$ref": "#/$defs/facetResult",
              "properties": {
                "facet": {
                  "const": "guarantee_consistency"
                }
              }
            }
          ]
        },
        "backing_allocation_id": {
          "$ref": "#/$defs/sha256"
        },
        "verifier_authority": {
          "$ref": "#/$defs/ed25519PublicKey"
        },
        "verifier_key_epoch": {
          "$ref": "#/$defs/iJsonU64NonZero"
        },
        "evaluation_time": {
          "$ref": "#/$defs/iJsonU64NonZero"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "facets"
            ],
            "properties": {
              "facets": {
                "prefixItems": [
                  true,
                  true,
                  true,
                  true,
                  true,
                  true,
                  true,
                  true,
                  true,
                  true,
                  {
                    "required": [
                      "outcome"
                    ],
                    "properties": {
                      "outcome": {
                        "const": "verified"
                      }
                    }
                  }
                ]
              }
            }
          },
          "then": {
            "required": [
              "backing_allocation_id"
            ]
          },
          "else": {
            "not": {
              "required": [
                "backing_allocation_id"
              ]
            }
          }
        },
        {
          "if": {
            "required": [
              "finding_delivery_receipt_id"
            ]
          },
          "then": {
            "required": [
              "finding_delivery"
            ]
          },
          "else": {
            "not": {
              "required": [
                "finding_delivery"
              ]
            }
          }
        }
      ]
    },
    "signerKey": {
      "$ref": "#/$defs/ed25519PublicKey"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "$defs": {
    "ed25519PublicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "facetResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet",
        "outcome",
        "reason"
      ],
      "properties": {
        "facet": {
          "enum": [
            "artifact_integrity",
            "receipt_authenticity",
            "checkpoint_membership",
            "kernel_and_revocation_trust",
            "issuer_lineage",
            "recipe_binding",
            "intent_binding",
            "metered_exposure_backing",
            "settled_spend_backing",
            "runtime_assurance_backing",
            "bond_backing",
            "status_liveness",
            "guarantee_consistency"
          ]
        },
        "outcome": {
          "enum": [
            "verified",
            "asserted",
            "unavailable",
            "failed"
          ]
        },
        "reason": {
          "$ref": "#/$defs/nonBlankString"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/nonBlankString"
          }
        }
      }
    },
    "findingDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "finding_id",
        "listing_id",
        "transform_profile",
        "digest_check",
        "media_type_check",
        "settlement_mode",
        "accepted_bid_envelope_sha256",
        "venue_admission_envelope_sha256",
        "reservation_id",
        "purchase_intent_id",
        "authoritative_payment_operation_id"
      ],
      "properties": {
        "schema": {
          "const": "chio.finding.delivery.v1"
        },
        "finding_id": {
          "$ref": "#/$defs/sha256"
        },
        "listing_id": {
          "$ref": "#/$defs/identifier"
        },
        "transform_profile": {
          "const": "identity"
        },
        "digest_check": {
          "enum": [
            "matched",
            "mismatched"
          ]
        },
        "media_type_check": {
          "enum": [
            "matched",
            "mismatched",
            "not_evaluated"
          ]
        },
        "settlement_mode": {
          "const": "local_reversible_hold"
        },
        "accepted_bid_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "venue_admission_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reservation_id": {
          "$ref": "#/$defs/identifier"
        },
        "purchase_intent_id": {
          "$ref": "#/$defs/identifier"
        },
        "authoritative_payment_operation_id": {
          "$ref": "#/$defs/identifier"
        },
        "status_proof": {
          "$ref": "#/$defs/findingStatusProof"
        }
      }
    },
    "findingStatusProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feed_id",
        "key_domain_nonce",
        "map_epoch",
        "status_epoch_artifact_sha256",
        "proof_sha256",
        "root_hash",
        "non_inclusion_checked_at"
      ],
      "properties": {
        "feed_id": {
          "$ref": "#/$defs/hierarchicalIdentifier"
        },
        "key_domain_nonce": {
          "const": 3318287169837494
        },
        "map_epoch": {
          "$ref": "#/$defs/iJsonU64NonZero"
        },
        "status_epoch_artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "proof_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "root_hash": {
          "$ref": "#/$defs/sha256"
        },
        "non_inclusion_checked_at": {
          "$ref": "#/$defs/iJsonU64NonZero"
        }
      }
    },
    "iJsonU64": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "iJsonU64NonZero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,512}$"
    },
    "hierarchicalIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,512}$"
    },
    "nonBlankString": {
      "type": "string",
      "maxLength": 512,
      "pattern": "\\S"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
