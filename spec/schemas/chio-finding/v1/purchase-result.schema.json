{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/purchase-result.schema.json",
  "title": "Chio Finding Purchase Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "result_id", "request_id", "finding_id", "payer", "reservation_id", "purchase_intent_id", "authoritative_payment_operation_id", "verdict", "settlement", "accepted_price", "realized_spend", "delivery_receipt_sha256", "recorded_at"],
      "properties": {
        "schema": { "const": "chio.finding.purchase-result.v1" },
        "result_id": { "$ref": "#/$defs/sha256" },
        "request_id": { "$ref": "#/$defs/sha256" },
        "finding_id": { "$ref": "#/$defs/sha256" },
        "payer": { "$ref": "#/$defs/key" },
        "reservation_id": { "$ref": "#/$defs/id" },
        "purchase_intent_id": { "$ref": "#/$defs/id" },
        "authoritative_payment_operation_id": { "$ref": "#/$defs/id" },
        "verdict": { "enum": ["allow", "deny"] },
        "settlement": { "enum": ["captured", "released"] },
        "accepted_price": { "$ref": "#/$defs/nonzeroMoney" },
        "realized_spend": { "$ref": "#/$defs/money" },
        "delivery_receipt_sha256": { "$ref": "#/$defs/sha256" },
        "purchase_record_sha256": { "$ref": "#/$defs/sha256" },
        "failed_delivery_sha256": { "$ref": "#/$defs/sha256" },
        "output_sha256": { "$ref": "#/$defs/sha256" },
        "recorded_at": { "$ref": "#/$defs/nonzero" }
      },
      "oneOf": [
        {
          "properties": { "verdict": { "const": "allow" }, "settlement": { "const": "captured" }, "realized_spend": { "properties": { "units": { "$ref": "#/$defs/nonzero" } } } },
          "required": ["purchase_record_sha256", "output_sha256"],
          "not": { "required": ["failed_delivery_sha256"] }
        },
        {
          "properties": { "verdict": { "const": "deny" }, "settlement": { "const": "released" }, "realized_spend": { "properties": { "units": { "const": 0 } } } },
          "required": ["failed_delivery_sha256"],
          "not": { "anyOf": [{ "required": ["purchase_record_sha256"] }, { "required": ["output_sha256"] }] }
        }
      ]
    },
    "signerKey": { "$ref": "#/$defs/key" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "key": { "$ref": "#/$defs/sha256" },
    "id": { "type": "string", "pattern": "\\S", "maxLength": 512 },
    "u64": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "nonzero": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "money": { "type": "object", "additionalProperties": false, "required": ["units", "currency"], "properties": { "units": { "$ref": "#/$defs/u64" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } } },
    "nonzeroMoney": { "type": "object", "additionalProperties": false, "required": ["units", "currency"], "properties": { "units": { "$ref": "#/$defs/nonzero" }, "currency": { "type": "string", "pattern": "^[A-Z]{3}$" } } }
  }
}
