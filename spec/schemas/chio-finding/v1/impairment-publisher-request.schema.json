{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-finding/impairment-publisher-request/v1",
  "title": "Chio Finding Impairment Publisher Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "operation", "intent", "call"],
  "properties": {
    "schema": { "const": "chio.finding.impairment-publisher-request.v1" },
    "operation": { "enum": ["dispatch", "observe"] },
    "intent": { "$ref": "#/$defs/intent" },
    "call": { "$ref": "#/$defs/call" }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "digest": { "type": "string", "pattern": "^(0x)?[0-9a-fA-F]{64}$" },
    "address": { "type": "string", "pattern": "^0x[0-9a-fA-F]{40}$" },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "type": "integer", "minimum": 0 },
        "currency": { "type": "string", "minLength": 1, "maxLength": 32 }
      }
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["destination", "amount", "share_minor_units"],
      "properties": {
        "destination": { "$ref": "#/$defs/address" },
        "amount": { "$ref": "#/$defs/amount" },
        "share_minor_units": { "type": "integer", "minimum": 0 }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "enforcement_id",
        "liability_key",
        "bond_snapshot_envelope_sha256",
        "chain_id",
        "target_contract",
        "vault_id",
        "evidence_hash",
        "merkle_root",
        "amount",
        "slash_amount_minor_units",
        "destinations"
      ],
      "properties": {
        "intent_id": { "$ref": "#/$defs/text" },
        "enforcement_id": { "$ref": "#/$defs/text" },
        "liability_key": { "$ref": "#/$defs/text" },
        "bond_snapshot_envelope_sha256": { "$ref": "#/$defs/digest" },
        "chain_id": { "$ref": "#/$defs/text" },
        "target_contract": { "$ref": "#/$defs/address" },
        "vault_id": { "$ref": "#/$defs/digest" },
        "evidence_hash": { "$ref": "#/$defs/digest" },
        "merkle_root": { "$ref": "#/$defs/digest" },
        "amount": { "$ref": "#/$defs/amount" },
        "slash_amount_minor_units": { "type": "integer", "minimum": 0 },
        "destinations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/destination" }
        }
      }
    },
    "call": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_address", "to_address", "data"],
      "properties": {
        "from_address": { "$ref": "#/$defs/address" },
        "to_address": { "$ref": "#/$defs/address" },
        "data": { "type": "string", "pattern": "^0x[0-9a-fA-F]*$", "maxLength": 2097152 },
        "gas_limit": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
