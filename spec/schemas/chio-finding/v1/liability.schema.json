{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/liability.schema.json",
  "title": "Chio Finding Liability",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "liability_key", "defect_key", "finding_id", "listing_id", "backing_allocation_id", "seller", "venue_id", "chain_id", "vault_contract", "vault_id", "state", "opened_at", "updated_at"],
      "properties": {
        "schema": { "const": "chio.finding.liability.v1" },
        "liability_key": { "$ref": "#/$defs/sha256" },
        "defect_key": { "$ref": "#/$defs/sha256" },
        "finding_id": { "$ref": "#/$defs/sha256" },
        "listing_id": { "$ref": "#/$defs/id" },
        "backing_allocation_id": { "$ref": "#/$defs/id" },
        "seller": { "$ref": "#/$defs/sha256" },
        "venue_id": { "$ref": "#/$defs/id" },
        "chain_id": { "$ref": "#/$defs/id" },
        "vault_contract": { "$ref": "#/$defs/id" },
        "vault_id": { "$ref": "#/$defs/id" },
        "state": { "enum": ["open", "upheld_pending_claims", "pending_appeal", "finalizing", "settled", "quarantined"] },
        "upheld_challenge_id": { "$ref": "#/$defs/sha256" },
        "purchase_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "deterministic_allocation_sha256": { "$ref": "#/$defs/sha256" },
        "opened_at": { "$ref": "#/$defs/nonzero" },
        "updated_at": { "$ref": "#/$defs/nonzero" }
      },
      "allOf": [
        { "if": { "properties": { "state": { "const": "open" } } }, "then": { "not": { "anyOf": [{ "required": ["upheld_challenge_id"] }, { "required": ["purchase_snapshot_sha256"] }, { "required": ["deterministic_allocation_sha256"] }] } } },
        { "if": { "properties": { "state": { "const": "upheld_pending_claims" } } }, "then": { "required": ["upheld_challenge_id"], "not": { "anyOf": [{ "required": ["purchase_snapshot_sha256"] }, { "required": ["deterministic_allocation_sha256"] }] } } },
        { "if": { "properties": { "state": { "enum": ["pending_appeal", "finalizing", "settled"] } } }, "then": { "required": ["upheld_challenge_id", "purchase_snapshot_sha256", "deterministic_allocation_sha256"] } },
        { "if": { "properties": { "state": { "const": "quarantined" } } }, "then": { "required": ["upheld_challenge_id"] } }
      ]
    },
    "signerKey": { "$ref": "#/$defs/sha256" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "id": { "type": "string", "pattern": "\\S", "maxLength": 512 },
    "nonzero": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
  }
}
