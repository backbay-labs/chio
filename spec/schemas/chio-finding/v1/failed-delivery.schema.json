{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-finding/v1/failed-delivery.schema.json",
  "title": "Chio Finding Failed Delivery (signed envelope)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "signerKey",
    "signature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "failed_delivery_id",
        "buyer",
        "finding_id",
        "listing_id",
        "accepted_bid_envelope_sha256",
        "reservation_id",
        "purchase_intent_id",
        "authoritative_payment_operation_id",
        "hold_attempt_reference",
        "release_terminal",
        "deny_receipt_id",
        "deny_receipt_sha256",
        "deny_checkpoint_ref",
        "deny_checkpoint_sha256",
        "realized_spend_units",
        "currency",
        "payout_eligible",
        "recorded_at"
      ],
      "properties": {
        "schema": {
          "const": "chio.finding.failed-delivery.v1"
        },
        "failed_delivery_id": {
          "$ref": "#/$defs/sha256"
        },
        "buyer": {
          "$ref": "#/$defs/ed25519PublicKey"
        },
        "finding_id": {
          "$ref": "#/$defs/sha256"
        },
        "listing_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "accepted_bid_envelope_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reservation_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "purchase_intent_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "authoritative_payment_operation_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "hold_attempt_reference": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "release_terminal": {
          "enum": [
            "released",
            "cancelled_before_authorization"
          ]
        },
        "deny_receipt_id": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "deny_receipt_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "deny_checkpoint_ref": {
          "$ref": "#/$defs/boundedIdentifier"
        },
        "deny_checkpoint_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "realized_spend_units": {
          "const": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "payout_eligible": {
          "const": false
        },
        "recorded_at": {
          "$ref": "#/$defs/iJsonU64Nonzero"
        }
      }
    },
    "signerKey": {
      "$ref": "#/$defs/ed25519PublicKey"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "$defs": {
    "boundedIdentifier": {
      "type": "string",
      "pattern": "\\S",
      "maxLength": 512
    },
    "ed25519PublicKey": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "iJsonU64Nonzero": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
