{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/run-contract.schema.json",
  "title": "Chio Runtime Run Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "profileSha256",
    "workflowId",
    "expectedStepCount",
    "admissionIds",
    "storeId",
    "evidenceSinkId",
    "proofRegenerationRequired"
  ],
  "properties": {
    "schema": { "const": "chio.runtime.run-contract.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "profileSha256": { "$ref": "#/$defs/sha256" },
    "workflowId": { "type": "string", "minLength": 1 },
    "expectedStepCount": { "type": "integer", "minimum": 1 },
    "admissionIds": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "storeId": { "type": "string", "minLength": 1 },
    "evidenceSinkId": { "type": "string", "minLength": 1 },
    "proofRegenerationRequired": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
