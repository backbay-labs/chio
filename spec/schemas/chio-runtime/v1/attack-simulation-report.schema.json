{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/attack-simulation-report.schema.json",
  "title": "Chio Runtime Attack Simulation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "scenario_id",
    "attack_class",
    "fixture_path",
    "expected_denial_claim",
    "actual_verifier_report_digest",
    "runtime_receipt_refs",
    "status",
    "simulator_version_digest",
    "issuer",
    "signature"
  ],
  "properties": {
    "schema": { "const": "chio.runtime.attack-simulation-report.v1" },
    "scenario_id": { "type": "string", "minLength": 1 },
    "attack_class": {
      "type": "string",
      "enum": [
        "confused-deputy-route-metadata",
        "replayed-continuation-token",
        "stale-revocation-epoch",
        "policy-hot-reload-widening",
        "advisory-evidence-laundering",
        "external-payment-success-laundering",
        "route-plan-registry-downgrade",
        "tool-server-bypass-without-kernel-allow",
        "missing-denial-receipt",
        "sandbox-profile-mismatch"
      ]
    },
    "fixture_path": { "type": "string", "minLength": 1 },
    "expected_denial_claim": { "type": "string", "minLength": 1 },
    "actual_verifier_report_digest": { "$ref": "#/$defs/sha256" },
    "runtime_receipt_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "chaos_knobs": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "simulator_version_digest": { "$ref": "#/$defs/sha256" },
    "issuer": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
