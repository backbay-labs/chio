{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proof-drift-report.schema.json",
  "title": "Chio Runtime Proof Drift Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "baselineRunId", "candidateRunId", "accepted", "generatedAtUnixMs", "baselineManifestSha256", "candidateManifestSha256", "baselineProofRegenerationReportSha256", "candidateProofRegenerationReportSha256", "comparisonProfile", "normalizedFields", "semanticDrifts", "artifactDrifts", "verifierDrifts"],
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": false } }, "required": ["accepted"] },
      "then": { "required": ["failureCode"] }
    },
    {
      "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
      "then": { "not": { "required": ["failureCode"] } }
    }
  ],
  "properties": {
    "schema": { "const": "chio.runtime.proof-drift-report.v1" },
    "baselineRunId": { "type": "string", "minLength": 1 },
    "candidateRunId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "baselineManifestSha256": { "$ref": "#/$defs/sha256" },
    "candidateManifestSha256": { "$ref": "#/$defs/sha256" },
    "baselineProofRegenerationReportSha256": { "$ref": "#/$defs/sha256" },
    "candidateProofRegenerationReportSha256": { "$ref": "#/$defs/sha256" },
    "comparisonProfile": { "type": "string", "minLength": 1 },
    "normalizedFields": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "semanticDrifts": { "type": "array", "items": { "$ref": "#/$defs/drift" } },
    "artifactDrifts": { "type": "array", "items": { "$ref": "#/$defs/artifactDrift" } },
    "verifierDrifts": { "type": "array", "items": { "$ref": "#/$defs/drift" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "drift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "baselineValueSha256", "candidateValueSha256", "severity"],
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "baselineValueSha256": { "$ref": "#/$defs/sha256" },
        "candidateValueSha256": { "$ref": "#/$defs/sha256" },
        "severity": { "type": "string", "pattern": "^[a-z0-9_]+$" }
      }
    },
    "artifactDrift": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "path", "baselineSha256", "candidateSha256"],
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "baselineSha256": { "$ref": "#/$defs/sha256" },
        "candidateSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
