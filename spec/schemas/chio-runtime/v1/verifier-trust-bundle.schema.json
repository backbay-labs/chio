{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/verifier-trust-bundle.schema.json",
  "title": "Chio Runtime Verifier Trust Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "verifierId",
        "keyId",
        "version",
        "trustBundleSha256",
        "verificationContextSha256",
        "revocationCheckpointSha256",
        "revocationAuthorityRoots",
        "issuedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.runtime.verifier-trust-bundle.v1" },
        "verifierId": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 },
        "previousHashSha256": { "$ref": "#/$defs/sha256" },
        "trustBundleSha256": { "$ref": "#/$defs/sha256" },
        "verificationContextSha256": { "$ref": "#/$defs/sha256" },
        "revocationCheckpointSha256": { "$ref": "#/$defs/sha256" },
        "revocationAuthorityRoots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
        "expiresAtUnixMs": { "type": "integer", "minimum": 0 }
      }
    },
    "signerKey": { "$ref": "#/$defs/hex" },
    "signature": { "$ref": "#/$defs/hex" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
