{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/trusted-verifiers.schema.json",
  "title": "Chio Runtime Trusted Verifiers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "verifierKeys"],
  "properties": {
    "schema": { "const": "chio.runtime.trusted-verifiers.v1" },
    "verifierKeys": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "verifierId",
          "keyId",
          "publicKey",
          "validFromUnixMs",
          "validUntilUnixMs",
          "status"
        ],
        "properties": {
          "verifierId": { "type": "string", "minLength": 1 },
          "keyId": { "type": "string", "minLength": 1 },
          "publicKey": { "$ref": "#/$defs/hex" },
          "validFromUnixMs": { "type": "integer", "minimum": 0 },
          "validUntilUnixMs": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["active", "inactive", "revoked"] }
        }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^[0-9a-f]+$" }
  }
}
