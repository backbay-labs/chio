{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "evidence-sink-health-report.schema.json",
  "title": "Chio Runtime Evidence Sink Health Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "accepted", "generatedAtUnixMs", "evidenceRootSha256", "requiredRoles", "missingRoles", "missingArtifacts", "artifactHashMismatches", "artifactByteCountMismatches", "unexpectedPaths", "tempWriteOk", "atomicRenameOk", "checks"],
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": false } }, "required": ["accepted"] },
      "then": { "required": ["failureCode"] }
    },
    {
      "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
      "then": { "not": { "required": ["failureCode"] } }
    }
  ],
  "properties": {
    "schema": { "const": "chio.runtime.evidence-sink-health-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "$ref": "#/$defs/code" },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "evidenceRootSha256": { "$ref": "#/$defs/sha256" },
    "requiredRoles": { "type": "array", "items": { "$ref": "#/$defs/code" } },
    "missingRoles": { "type": "array", "items": { "$ref": "#/$defs/code" } },
    "missingArtifacts": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "artifactHashMismatches": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "artifactByteCountMismatches": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "unexpectedPaths": { "type": "array", "items": { "$ref": "#/$defs/path" } },
    "tempWriteOk": { "type": "boolean" },
    "atomicRenameOk": { "type": "boolean" },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "check": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "path": { "type": "string", "minLength": 1, "not": { "pattern": "(^/|(^|/)\\.\\.(/|$))" } }
  }
}
