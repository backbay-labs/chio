{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "proof-regeneration-input.schema.json",
  "title": "Chio Runtime Proof Regeneration Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "evidenceManifestSha256",
    "workflowRunReportSha256",
    "admissionReportSha256",
    "trustBundleSha256",
    "verificationContextSha256",
    "sourceRecords"
  ],
  "properties": {
    "schema": { "const": "chio.runtime.proof-regeneration-input.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "evidenceManifestSha256": { "$ref": "#/$defs/sha256" },
    "workflowRunReportSha256": { "$ref": "#/$defs/sha256" },
    "admissionReportSha256": { "$ref": "#/$defs/sha256" },
    "trustBundleSha256": { "$ref": "#/$defs/sha256" },
    "verificationContextSha256": { "$ref": "#/$defs/sha256" },
    "sourceRecords": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "proof-regeneration-report.schema.json#/$defs/sourceRecord" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
