{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/admission-report.schema.json",
  "title": "Chio Runtime Admission Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "admissionId",
    "accepted",
    "checks",
    "receiptMetadata"
  ],
  "allOf": [
    {
      "if": {
        "properties": { "accepted": { "const": false } },
        "required": ["accepted"]
      },
      "then": { "required": ["failureCode"] }
    },
    {
      "if": {
        "properties": { "accepted": { "const": true } },
        "required": ["accepted"]
      },
      "then": { "not": { "required": ["failureCode"] } }
    }
  ],
  "properties": {
    "schema": { "const": "chio.runtime.admission-report.v1" },
    "admissionId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    },
    "pheromoneAdvisory": { "$ref": "#/$defs/pheromoneAdvisory" },
    "pheromonePolicyDecision": {
      "$ref": "pheromone-policy-decision.schema.json"
    },
    "receiptMetadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" }
      }
    },
    "pheromoneAdvisory": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceReportSha256",
        "accepted",
        "subjectClass",
        "subjectClassNamespace",
        "totalStrength",
        "distinctOriginPairs",
        "reputationEpoch",
        "evaluatedAtUnixMs",
        "observeOnly"
      ],
      "properties": {
        "sourceReportSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "accepted": { "type": "boolean" },
        "subjectClass": { "type": "string", "minLength": 1 },
        "subjectClassNamespace": { "type": "string", "minLength": 1 },
        "totalStrength": { "type": "number", "minimum": 0 },
        "distinctOriginPairs": { "type": "integer", "minimum": 0 },
        "reputationEpoch": { "type": "integer", "minimum": 0 },
        "evaluatedAtUnixMs": { "type": "integer", "minimum": 0 },
        "observeOnly": { "const": true }
      }
    }
  }
}
