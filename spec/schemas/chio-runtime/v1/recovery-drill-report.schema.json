{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "recovery-drill-report.schema.json",
  "title": "Chio Runtime Recovery Drill Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runId", "accepted", "generatedAtUnixMs", "resumable", "blocked", "reusableStepIndices", "checks"],
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": false } }, "required": ["accepted"] },
      "then": { "required": ["failureCode"] }
    },
    {
      "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
      "then": { "not": { "required": ["failureCode"] } }
    }
  ],
  "properties": {
    "schema": { "const": "chio.runtime.recovery-drill-report.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "$ref": "#/$defs/code" },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "resumable": { "type": "boolean" },
    "blocked": { "type": "boolean" },
    "nextStepIndex": { "type": "integer", "minimum": 0 },
    "reusableStepIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "recoveryRequiredReason": { "$ref": "#/$defs/code" },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "code": { "type": "string", "pattern": "^[a-z0-9_]+$" },
    "check": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" }
  }
}
