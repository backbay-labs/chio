{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "orchestration-resume-plan.schema.json",
  "title": "Chio Runtime Orchestration Resume Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "runId",
    "accepted",
    "generatedAtUnixMs",
    "reusableStepIndices",
    "blocked",
    "checks"
  ],
  "allOf": [
    {
      "if": { "properties": { "accepted": { "const": false } }, "required": ["accepted"] },
      "then": { "required": ["failureCode"] }
    },
    {
      "if": { "properties": { "accepted": { "const": true } }, "required": ["accepted"] },
      "then": { "not": { "required": ["failureCode"] } }
    }
  ],
  "properties": {
    "schema": { "const": "chio.runtime.orchestration-resume-plan.v1" },
    "runId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "nextStepIndex": { "type": "integer", "minimum": 0 },
    "reusableStepIndices": { "type": "array", "items": { "type": "integer", "minimum": 0 } },
    "blocked": { "type": "boolean" },
    "checks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
