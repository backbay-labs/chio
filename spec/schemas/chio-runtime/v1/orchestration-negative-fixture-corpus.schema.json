{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/orchestration-negative-fixture-corpus.schema.json",
  "title": "Chio Runtime Orchestration Negative Fixture Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": {
      "const": "chio.runtime.orchestration-negative-fixture-corpus.v1"
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "expectedCode"],
        "properties": {
          "caseId": { "type": "string", "minLength": 1 },
          "expectedCode": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
