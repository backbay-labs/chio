{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/execution-lease.schema.json",
  "title": "Chio Runtime Execution Lease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "lease_id",
    "subject_agent",
    "tool_server_id",
    "tool_instance_id",
    "tool_manifest_digest",
    "sandbox_attestation_ref",
    "capability_digest",
    "request_digest",
    "response_policy_digest",
    "task_graph_digest",
    "child_task_id",
    "parent_receipt_ref",
    "join_receipt_ref",
    "budget_pool_ref",
    "budget_allocation_ref",
    "subject_capability_digest",
    "ancestor_capability_digest",
    "route_plan_receipt_ref",
    "revocation_freshness_ref",
    "policy_digest",
    "nonce",
    "side_effect_class",
    "issued_at",
    "expires_at",
    "issuer",
    "signature"
  ],
  "properties": {
    "schema": { "const": "chio.runtime.execution-lease.v1" },
    "lease_id": { "type": "string", "minLength": 1 },
    "subject_agent": { "type": "string", "minLength": 1 },
    "tool_server_id": { "type": "string", "minLength": 1 },
    "tool_instance_id": { "type": "string", "minLength": 1 },
    "tool_manifest_digest": { "$ref": "#/$defs/sha256" },
    "sandbox_attestation_ref": { "type": "string", "minLength": 1 },
    "capability_digest": { "$ref": "#/$defs/sha256" },
    "request_digest": { "$ref": "#/$defs/sha256" },
    "response_policy_digest": { "$ref": "#/$defs/sha256" },
    "task_graph_digest": { "$ref": "#/$defs/sha256" },
    "child_task_id": { "type": "string", "minLength": 1 },
    "parent_receipt_ref": { "type": "string", "minLength": 1 },
    "join_receipt_ref": { "type": "string", "minLength": 1 },
    "budget_pool_ref": { "type": "string", "minLength": 1 },
    "budget_allocation_ref": { "type": "string", "minLength": 1 },
    "subject_capability_digest": { "$ref": "#/$defs/sha256" },
    "ancestor_capability_digest": { "$ref": "#/$defs/sha256" },
    "revocation_epoch_ref": { "type": "string", "minLength": 1 },
    "route_plan_receipt_ref": { "type": "string", "minLength": 1 },
    "revocation_freshness_ref": { "type": "string", "minLength": 1 },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "nonce": { "type": "string", "minLength": 1 },
    "side_effect_class": {
      "type": "string",
      "enum": [
        "network-write",
        "filesystem-write",
        "process-spawn",
        "state-write"
      ]
    },
    "max_invocations": { "const": 1 },
    "issued_at": { "type": "string", "minLength": 1 },
    "expires_at": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
