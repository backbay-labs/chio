{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/chaos-run-report.schema.json",
  "title": "Chio Runtime Chaos Run Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "case_id",
    "failure_injected",
    "expected_result",
    "actual_verifier_report_digest",
    "runtime_receipt_refs",
    "deterministic_seed_digest",
    "status",
    "runner_version_digest",
    "issuer",
    "signature"
  ],
  "properties": {
    "schema": { "const": "chio.runtime.chaos-run-report.v1" },
    "case_id": {
      "type": "string",
      "enum": [
        "revocation-oracle-unavailable",
        "receipt-log-unavailable",
        "policy-reload-during-dispatch",
        "duplicate-nonce-race",
        "tool-restart-lost-lease-cache",
        "registry-split-brain",
        "clock-skew-expiry-bypass",
        "sandbox-profile-drift"
      ]
    },
    "failure_injected": { "type": "string", "minLength": 1 },
    "expected_result": { "type": "string", "minLength": 1 },
    "actual_verifier_report_digest": { "$ref": "#/$defs/sha256" },
    "runtime_receipt_refs": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "deterministic_seed_digest": { "$ref": "#/$defs/sha256" },
    "status": { "type": "string", "enum": ["passed", "failed"] },
    "runner_version_digest": { "$ref": "#/$defs/sha256" },
    "issuer": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
