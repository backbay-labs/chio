{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "step-evidence.schema.json",
  "title": "Chio Runtime Step Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "stepIndex",
    "admissionId",
    "admissionReportSha256",
    "toolReceiptId",
    "toolReceiptSha256",
    "outputSha256",
    "bilateralDsseSha256",
    "workflowStepSha256",
    "consistencyAnchor",
    "destructive"
  ],
  "properties": {
    "schema": { "const": "chio.runtime.step-evidence.v1" },
    "stepIndex": { "type": "integer", "minimum": 0 },
    "admissionId": { "type": "string", "minLength": 1 },
    "admissionReportSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "toolReceiptId": { "type": "string", "minLength": 1 },
    "toolReceiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "outputSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bilateralDsseSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "workflowStepSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "parentReceiptSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "consistencyAnchor": { "type": "string", "minLength": 1 },
    "destructive": { "type": "boolean" },
    "leaseId": { "type": "string", "minLength": 1 },
    "governanceReceiptId": { "type": "string", "minLength": 1 }
  }
}
