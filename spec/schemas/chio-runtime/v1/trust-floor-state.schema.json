{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-runtime/v1/trust-floor-state.schema.json",
  "title": "Chio Runtime Trust Floor State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "entries"],
  "properties": {
    "schema": { "const": "chio.runtime.trust-floor-state.v1" },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "verifierId",
        "keyId",
        "highestVersion",
        "latestBundleSha256",
        "latestRevocationCheckpointSha256"
      ],
      "properties": {
        "verifierId": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "highestVersion": { "type": "integer", "minimum": 1 },
        "latestBundleSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "latestRevocationCheckpointSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
