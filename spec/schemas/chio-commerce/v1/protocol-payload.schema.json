{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-commerce/v1/protocol-payload.schema.json",
  "title": "Chio Commerce Protocol Payload",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "protocol",
    "purpose",
    "order_id",
    "amount_minor",
    "currency"
  ],
  "properties": {
    "schema": { "const": "chio.commerce.protocol-payload.v1" },
    "protocol": {
      "type": "string",
      "enum": ["ap2", "acp-commerce", "x402", "chio"]
    },
    "purpose": { "type": "string", "minLength": 1 },
    "order_id": { "type": "string", "minLength": 1 },
    "amount_minor": { "type": "integer", "minimum": 1 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
  }
}
