{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-commerce/v1/order-passport.schema.json",
  "title": "Chio Commerce Order Passport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "issued_at",
    "verdict",
    "order_id",
    "current_state",
    "artifact_digests",
    "selective_disclosure_policy",
    "verified_claims"
  ],
  "properties": {
    "schema": { "const": "chio.commerce.order-passport.v1" },
    "id": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "minLength": 1 },
    "verdict": { "type": "string", "enum": ["verified", "failed"] },
    "order_id": { "type": "string", "minLength": 1 },
    "current_state": { "type": "string", "minLength": 1 },
    "artifact_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "order_context_sha256",
        "event_log_sha256",
        "payment_lifecycle_sha256",
        "mandate_ledger_sha256",
        "provider_passport_sha256",
        "reputation_snapshot_sha256",
        "federation_trust_bundle_sha256",
        "settlement_packet_sha256"
      ],
      "properties": {
        "order_context_sha256": { "$ref": "#/$defs/sha256" },
        "event_log_sha256": { "$ref": "#/$defs/sha256" },
        "payment_lifecycle_sha256": { "$ref": "#/$defs/sha256" },
        "mandate_ledger_sha256": { "$ref": "#/$defs/sha256" },
        "provider_passport_sha256": { "$ref": "#/$defs/sha256" },
        "reputation_snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "federation_trust_bundle_sha256": { "$ref": "#/$defs/sha256" },
        "settlement_packet_sha256": { "$ref": "#/$defs/sha256" },
        "risk_comptroller_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "selective_disclosure_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_id", "disclosed_fields", "redacted_fields"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "disclosed_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "redacted_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "verified_claims": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
