{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-transaction/v1/capability-proof.schema.json",
  "title": "Chio Capability Proof",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "capability_id", "issuer", "expires_at", "signature"],
  "properties": {
    "schema": { "const": "chio.capability.proof.v1" },
    "id": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "minLength": 1 },
    "subject": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "scope": { "type": "string", "minLength": 1 },
    "not_before": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "minLength": 1 }
  }
}
