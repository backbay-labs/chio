{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-transaction/v1/claim-set.schema.json",
  "title": "Chio Transaction Claim Set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "issued_at", "claims"],
  "properties": {
    "schema": { "const": "chio.transaction.claim-set.v1" },
    "id": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "minLength": 1 },
    "subject": { "$ref": "#/$defs/subject" },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" },
      "minItems": 1
    }
  },
  "$defs": {
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "artifact_sha256"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "status", "required_evidence", "evidence_refs", "verifier_module"],
      "properties": {
        "claim_id": { "type": "string", "minLength": 1 },
        "status": {
          "type": "string",
          "enum": ["verified", "failed", "omitted", "unsupported"]
        },
        "required_evidence": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "failure_reason": { "type": "string", "minLength": 1 },
        "verifier_module": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "failed" } },
            "required": ["status"]
          },
          "then": { "required": ["failure_reason"] }
        }
      ]
    }
  }
}
