{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-transaction/v1/policy-bundle.schema.json",
  "title": "Chio Policy Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "version", "rules"],
  "properties": {
    "schema": { "const": "chio.policy.bundle.v1" },
    "id": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "effect", "scope"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "effect": { "type": "string", "minLength": 1 },
          "scope": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
