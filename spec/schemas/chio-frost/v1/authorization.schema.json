{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-frost/v1/authorization.schema.json",
  "title": "Chio FROST Authorization",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "body", "suiteId", "groupSignature"],
  "properties": {
    "schema": { "const": "chio.frost.authorization.v1" },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authorizationId",
        "domain",
        "ladderActionClass",
        "ladderContractDigest",
        "quorumN",
        "quorumM",
        "quorumScope",
        "scopeId",
        "resourceId",
        "resourceVersion",
        "resourceFence",
        "actionDigest",
        "rosterDigest",
        "keyEpoch",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "schema": { "const": "chio.frost.authorization-body.v1" },
        "authorizationId": { "$ref": "#/$defs/digest" },
        "domain": { "$ref": "#/$defs/domain" },
        "ladderActionClass": { "$ref": "#/$defs/identifier" },
        "ladderContractDigest": { "$ref": "#/$defs/digest" },
        "quorumN": { "type": "integer", "minimum": 2, "maximum": 65535 },
        "quorumM": { "type": "integer", "minimum": 2, "maximum": 65535 },
        "quorumScope": { "$ref": "#/$defs/identifier" },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "resourceId": { "$ref": "#/$defs/identifier" },
        "resourceVersion": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "resourceFence": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "rosterDigest": { "$ref": "#/$defs/digest" },
        "keyEpoch": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "issuedAt": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "expiresAt": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 }
      }
    },
    "suiteId": { "const": "FROST-ED25519-SHA512-v1" },
    "groupSignature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "signature": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
    "identifier": { "type": "string", "pattern": "^[!-~]+$" },
    "domain": {
      "type": "string",
      "enum": [
        "chio.frost.channel-close.v1",
        "chio.frost.clearing-round-finalize.v1",
        "chio.frost.credentials-passport-revoke.v1",
        "chio.frost.governance-case-enforce-sanction.v1",
        "chio.frost.pouncer-revoke-credential.v1",
        "chio.frost.roster-rotate.v1",
        "chio.frost.settle-commitment.v1"
      ]
    }
  }
}
