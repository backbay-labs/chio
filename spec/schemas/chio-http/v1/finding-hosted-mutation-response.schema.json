{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-http/v1/finding-hosted-mutation-response.schema.json",
  "title": "Chio Hosted Finding Mutation Response",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "tenantId",
    "operationId",
    "outcome",
    "resourceId",
    "resourceSha256"
  ],
  "properties": {
    "schema": {
      "const": "chio.finding.hosted-mutation-response.v1"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "tenantId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,128}$"
    },
    "operationId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,256}$"
    },
    "outcome": {
      "enum": ["applied", "exact_replay", "accepted"]
    },
    "resourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:/-]{1,256}$"
    },
    "resourceSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
