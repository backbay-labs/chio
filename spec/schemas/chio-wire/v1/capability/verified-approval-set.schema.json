{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/capability/verified-approval-set.schema.json",
  "title": "Chio Verified Approval Set Body",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token_digests",
    "policy_hash",
    "threshold",
    "eligible_set_digest",
    "request_id",
    "governed_intent_hash",
    "subject",
    "authorizing_capability_digest",
    "threshold_proposal_hash",
    "proposal_id",
    "proposal_created_at",
    "proposal_deadline"
  ],
  "properties": {
    "token_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
    },
    "policy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "threshold": { "type": "integer", "minimum": 1, "maximum": 32 },
    "eligible_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "request_id": { "type": "string", "minLength": 1 },
    "governed_intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "subject": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "authorizing_capability_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "threshold_proposal_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "proposal_created_at": { "type": "integer", "minimum": 0 },
    "proposal_deadline": { "type": "integer", "minimum": 1 }
  }
}
