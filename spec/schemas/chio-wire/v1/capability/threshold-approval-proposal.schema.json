{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/capability/threshold-approval-proposal.schema.json",
  "title": "Chio Threshold Approval Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "proposal_id",
    "request_id",
    "governed_intent_hash",
    "subject",
    "authorizing_capability_digest",
    "policy_hash",
    "threshold",
    "eligible_set_digest",
    "proposal_created_at",
    "proposal_deadline",
    "policy_authority",
    "signature"
  ],
  "properties": {
    "schema": { "const": "chio.threshold-approval-proposal.v1" },
    "proposal_id": { "type": "string", "minLength": 1 },
    "request_id": { "type": "string", "minLength": 1 },
    "governed_intent_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "subject": { "$ref": "#/$defs/thresholdProposalPublicKey" },
    "authorizing_capability_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "policy_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "threshold": { "type": "integer", "minimum": 1, "maximum": 32 },
    "eligible_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "proposal_created_at": { "type": "integer", "minimum": 0 },
    "proposal_deadline": { "type": "integer", "minimum": 1 },
    "policy_authority": { "$ref": "#/$defs/thresholdProposalPublicKey" },
    "algorithm": { "enum": ["ed25519", "p256", "p384", "hybrid"] },
    "signature": { "$ref": "#/$defs/thresholdProposalSignature" }
  },
  "$defs": {
    "thresholdProposalPublicKey": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "thresholdProposalSignature": {
      "type": "string",
      "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$"
    }
  }
}
