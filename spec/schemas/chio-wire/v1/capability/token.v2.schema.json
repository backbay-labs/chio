{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/capability/token.v2",
  "title": "Chio CapabilityToken v2",
  "description": "Schema-tagged v2 capability token with typed caveats, first-class attenuation fields, an attenuation_proof witness, and a reserved hybrid algorithm enum value for the T2.1 compatibility path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "issuer",
    "subject",
    "scope",
    "issued_at",
    "expires_at",
    "attenuation_proof",
    "signature"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "chio.capability.v2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "subject": {
      "type": "string",
      "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
    },
    "scope": {
      "$ref": "#/$defs/chioScope"
    },
    "issued_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": "integer",
      "minimum": 0
    },
    "delegation_chain": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/delegationLink"
      }
    },
    "algorithm": {
      "type": "string",
      "enum": ["ed25519", "p256", "p384", "hybrid"]
    },
    "caveats": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/caveat"
      }
    },
    "scope_attenuations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "attenuation_proof": {
      "$ref": "#/$defs/attenuationProof"
    },
    "budget_share_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000,
      "description": "Fixed-point child share in basis points. Values above 10000 re-amplify budget and fail closed."
    },
    "signature": {
      "type": "string",
      "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$"
    }
  },
  "$defs": {
    "chioScope": {
      "type": "object",
      "additionalProperties": false,
      "description": "What a capability token authorizes. Mirrors `ChioScope` in `chio-core-types`.",
      "properties": {
        "grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/toolGrant"
          }
        },
        "resource_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resourceGrant"
          }
        },
        "prompt_grants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/promptGrant"
          }
        }
      }
    },
    "toolGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["server_id", "tool_name", "operations"],
      "description": "Authorization to invoke a single tool. Mirrors `ToolGrant`.",
      "properties": {
        "server_id": {
          "type": "string",
          "minLength": 1
        },
        "tool_name": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "max_invocations": {
          "type": "integer",
          "minimum": 0
        },
        "max_cost_per_invocation": {
          "$ref": "#/$defs/monetaryAmount"
        },
        "max_total_cost": {
          "$ref": "#/$defs/monetaryAmount"
        },
        "dpop_required": {
          "type": "boolean"
        }
      }
    },
    "resourceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri_pattern", "operations"],
      "description": "Authorization for reading or subscribing to a resource. Mirrors `ResourceGrant`.",
      "properties": {
        "uri_pattern": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "promptGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_name", "operations"],
      "description": "Authorization for retrieving a prompt by name. Mirrors `PromptGrant`.",
      "properties": {
        "prompt_name": {
          "type": "string",
          "minLength": 1
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "operation": {
      "enum": [
        "invoke",
        "read_result",
        "read",
        "subscribe",
        "get",
        "delegate"
      ]
    },
    "monetaryAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "currency"],
      "description": "A monetary amount in the currency's smallest minor unit. Mirrors `MonetaryAmount`.",
      "properties": {
        "units": {
          "type": "integer",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "constraint": {
      "type": "object",
      "required": ["type"],
      "description": "Tagged enum mirroring `Constraint`. Encoded as `{ type, value }`.",
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "value": true
      }
    },
    "caveat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "predicate"],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "restrict_tool",
            "bind_session",
            "restrict_audience",
            "restrict_geo",
            "restrict_time_window"
          ]
        },
        "predicate": {
          "type": "string",
          "minLength": 1
        },
        "sig": {
          "type": "string",
          "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$"
        }
      }
    },
    "attenuationProof": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parentScopeHash",
        "childScopeHash",
        "normalizedSubsetProof"
      ],
      "properties": {
        "parentScopeHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "childScopeHash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "normalizedSubsetProof": {
          "$ref": "#/$defs/attenuationWitness"
        }
      }
    },
    "delegationLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "delegator",
        "delegatee",
        "timestamp",
        "signature",
        "scope_hash"
      ],
      "description": "A single v2 delegation link. The required scope_hash binds the authorized parent scope used by the next hop's attenuation_proof.parent_scope_hash.",
      "properties": {
        "capability_id": {
          "type": "string",
          "minLength": 1
        },
        "delegator": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:[a-z0-9_-]+:[a-z0-9_-]+:[a-z0-9_+.-]+:[0-9a-f]+)$"
        },
        "delegatee": {
          "type": "string",
          "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:[a-z0-9_-]+:[a-z0-9_-]+:[a-z0-9_+.-]+:[0-9a-f]+)$"
        },
        "attenuations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type"],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true
          }
        },
        "timestamp": {
          "type": "integer",
          "minimum": 0
        },
        "signature": {
          "type": "string",
          "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:[a-z0-9_-]+:[a-z0-9_-]+:[a-z0-9_+.-]+:[0-9a-f]+:[0-9a-f]+)$"
        },
        "scope_hash": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$",
          "description": "RFC 8785 canonical scope hash for this delegation hop. Runtime v2 verification rejects links that omit it."
        }
      }
    },
    "attenuationWitness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedParentScope", "normalizedChildScope"],
      "properties": {
        "normalizedParentScope": {
          "type": "string",
          "minLength": 2
        },
        "normalizedChildScope": {
          "type": "string",
          "minLength": 2
        },
        "subsetRelations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/grantSubsetRelation"
          }
        },
        "restrictedPredicates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "grantSubsetRelation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["grantKind", "childIndex", "parentIndex", "subset"],
      "properties": {
        "grantKind": {
          "type": "string",
          "enum": ["tool", "resource", "prompt"]
        },
        "childIndex": {
          "type": "integer",
          "minimum": 0
        },
        "parentIndex": {
          "type": "integer",
          "minimum": 0
        },
        "subset": {
          "type": "boolean",
          "enum": [true]
        }
      }
    }
  }
}
