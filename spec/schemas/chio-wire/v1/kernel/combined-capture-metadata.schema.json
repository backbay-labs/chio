{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/kernel/combined-capture-metadata.schema.json",
  "title": "Chio Combined Admission Capture Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation_id",
    "hold_id",
    "quota_keys",
    "revocation_set_digest",
    "budget_commit_index",
    "revocation_commit_index",
    "leader_epoch"
  ],
  "properties": {
    "schema": { "const": "chio.admission-capture-metadata.v1" },
    "operation_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "hold_id": { "type": "string", "minLength": 1 },
    "quota_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile", "owner_id"],
        "properties": {
          "profile": { "type": "string", "minLength": 1 },
          "owner_id": { "type": "string", "minLength": 1 },
          "grant_index": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
        }
      }
    },
    "revocation_set_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "budget_commit_index": { "type": "integer", "minimum": 1 },
    "revocation_commit_index": { "type": "integer", "minimum": 1 },
    "leader_epoch": { "type": "integer", "minimum": 1 }
  }
}
