{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chio KernelMessage tool_call_response",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "result", "receipt"],
  "properties": {
    "type": {
      "const": "tool_call_response"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "value"],
          "properties": {
            "status": {
              "const": "ok"
            },
            "value": true
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "total_chunks"],
          "properties": {
            "status": {
              "const": "stream_complete"
            },
            "total_chunks": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "chunks_received"],
          "properties": {
            "status": {
              "const": "cancelled"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "chunks_received": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "reason", "chunks_received"],
          "properties": {
            "status": {
              "const": "incomplete"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            },
            "chunks_received": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "error"],
          "properties": {
            "status": {
              "const": "err"
            },
            "error": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "detail"],
                  "properties": {
                    "code": {
                      "const": "capability_denied"
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "const": "capability_expired"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code"],
                  "properties": {
                    "code": {
                      "const": "capability_revoked"
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "detail"],
                  "properties": {
                    "code": {
                      "const": "policy_denied"
                    },
                    "detail": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["guard", "reason"],
                      "properties": {
                        "guard": {
                          "type": "string",
                          "minLength": 1
                        },
                        "reason": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "detail"],
                  "properties": {
                    "code": {
                      "const": "tool_server_error"
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["code", "detail"],
                  "properties": {
                    "code": {
                      "const": "internal_error"
                    },
                    "detail": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              ]
            }
          }
        }
      ]
    },
    "receipt": {
      "$ref": "../receipt/record.schema.json"
    },
    "execution_nonce": {
      "$ref": "execution_nonce.schema.json"
    }
  }
}
