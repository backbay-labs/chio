{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/kernel/capability_list.schema.json",
  "title": "Chio KernelMessage capability_list",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "capabilities"],
  "properties": {
    "type": { "const": "capability_list" },
    "capabilities": {
      "type": "array",
      "items": { "$ref": "../capability/token.schema.json" }
    }
  }
}
