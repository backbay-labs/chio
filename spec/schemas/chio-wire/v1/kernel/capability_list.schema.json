{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chio KernelMessage capability_list",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "capabilities"],
  "properties": {
    "type": {
      "const": "capability_list"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "issuer", "subject", "scope", "issued_at", "expires_at", "signature"],
        "oneOf": [
          {
            "required": ["schema", "attenuation_proof"],
            "properties": {
              "schema": {
                "const": "chio.capability.v2"
              }
            }
          },
          {
            "properties": {
              "schema": {
                "const": "chio.capability.v1"
              }
            }
          }
        ],
        "properties": {
          "schema": {
            "type": "string",
            "enum": ["chio.capability.v1", "chio.capability.v2"],
            "default": "chio.capability.v1",
            "description": "Signed-artifact schema ID for live capability-token serialization."
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "issuer": {
            "type": "string",
            "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
          },
          "subject": {
            "type": "string",
            "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$"
          },
          "scope": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "grants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["server_id", "tool_name", "operations"],
                  "properties": {
                    "server_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "tool_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "enum": [
                          "invoke",
                          "read_result",
                          "read",
                          "subscribe",
                          "get",
                          "delegate"
                        ]
                      }
                    },
                    "constraints": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["type"],
                        "properties": {
                          "type": {
                            "type": "string",
                            "minLength": 1
                          },
                          "value": true
                        }
                      }
                    },
                    "max_invocations": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "max_cost_per_invocation": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["units", "currency"],
                      "properties": {
                        "units": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "currency": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "max_total_cost": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["units", "currency"],
                      "properties": {
                        "units": {
                          "type": "integer",
                          "minimum": 0
                        },
                        "currency": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "dpop_required": {
                      "type": "boolean"
                    }
                  }
                }
              },
              "resource_grants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["uri_pattern", "operations"],
                  "properties": {
                    "uri_pattern": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "enum": [
                          "invoke",
                          "read_result",
                          "read",
                          "subscribe",
                          "get",
                          "delegate"
                        ]
                      }
                    }
                  }
                }
              },
              "prompt_grants": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["prompt_name", "operations"],
                  "properties": {
                    "prompt_name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "operations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "enum": [
                          "invoke",
                          "read_result",
                          "read",
                          "subscribe",
                          "get",
                          "delegate"
                        ]
                      }
                    }
                  }
                }
              }
            }
          },
          "issued_at": {
            "type": "integer",
            "minimum": 0
          },
          "expires_at": {
            "type": "integer",
            "minimum": 0
          },
          "delegation_chain": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["capability_id", "delegator", "delegatee", "timestamp", "signature"],
              "properties": {
                "capability_id": {
                  "type": "string",
                  "minLength": 1
                },
                "delegator": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "delegatee": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "attenuations": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "timestamp": {
                  "type": "integer",
                  "minimum": 0
                },
                "signature": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$"
                }
              }
            }
          },
          "algorithm": {
            "type": "string",
            "enum": ["ed25519", "p256", "p384", "hybrid"]
          },
          "caveats": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "predicate"],
              "properties": {
                "kind": {
                  "type": "string",
                  "minLength": 1
                },
                "predicate": true,
                "enforced_at": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "scope_attenuations": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "attenuation_proof": {
            "type": "object",
            "additionalProperties": false,
            "required": ["parent_scope_hash", "child_scope_hash", "normalized_subset_proof"],
            "properties": {
              "parent_scope_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "child_scope_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "normalized_subset_proof": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "budget_share_bps": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "signature": {
            "type": "string",
            "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$"
          }
        }
      }
    }
  }
}
