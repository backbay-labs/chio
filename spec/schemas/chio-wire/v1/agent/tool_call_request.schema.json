{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-wire/v1/agent/tool_call_request.schema.json",
  "title": "Chio AgentMessage tool_call_request",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "id", "capability_token", "server_id", "tool", "params"],
  "properties": {
    "type": { "const": "tool_call_request" },
    "id": { "type": "string", "minLength": 1 },
    "capability_token": { "$ref": "../capability/token.schema.json" },
    "server_id": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "params": true,
    "governed_intent": { "$ref": "governed-transaction-intent.schema.json" },
    "approval_token": { "$ref": "../capability/governed-approval-token.schema.json" },
    "approval_tokens": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "../capability/governed-approval-token.schema.json" }
    },
    "threshold_approval_proposal": {
      "$ref": "../capability/threshold-approval-proposal.schema.json"
    },
    "supplemental_authorization": {
      "$ref": "../capability/supplemental-authorization.schema.json"
    },
    "execution_nonce": {
      "$ref": "../kernel/execution_nonce.schema.json"
    }
  },
  "allOf": [
    {
      "not": {
        "required": ["approval_token", "approval_tokens"]
      }
    },
    {
      "if": { "required": ["threshold_approval_proposal"] },
      "then": {
        "required": ["approval_tokens"],
        "properties": { "approval_tokens": { "minItems": 1 } }
      }
    },
    {
      "if": {
        "required": ["approval_tokens"],
        "properties": { "approval_tokens": { "minItems": 1 } }
      },
      "then": { "required": ["threshold_approval_proposal"] }
    }
  ]
}
