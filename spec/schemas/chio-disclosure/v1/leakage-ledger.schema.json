{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-disclosure/v1/leakage-ledger.schema.json",
  "title": "Chio Disclosure Leakage Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "transaction_passport_ref",
    "privacy_profile_ref",
    "entries"
  ],
  "properties": {
    "schema": { "const": "chio.disclosure.leakage-ledger.v1" },
    "id": { "type": "string", "minLength": 1 },
    "transaction_passport_ref": { "type": "string", "minLength": 1 },
    "privacy_profile_ref": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "field",
          "leakage_kind",
          "allowed_by_profile"
        ],
        "properties": {
          "field": { "type": "string", "minLength": 1 },
          "leakage_kind": {
            "enum": ["disclosed_field", "hidden_predicate", "derived_fact"]
          },
          "allowed_by_profile": { "type": "boolean" },
          "residual_inference_note": { "type": "string", "minLength": 1 }
        },
        "allOf": [
          {
            "if": {
              "properties": { "leakage_kind": { "const": "hidden_predicate" } },
              "required": ["leakage_kind"]
            },
            "then": { "required": ["residual_inference_note"] }
          }
        ]
      }
    }
  }
}
