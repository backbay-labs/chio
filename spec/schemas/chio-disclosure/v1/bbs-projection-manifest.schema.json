{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-disclosure/v1/bbs-projection-manifest.schema.json",
  "title": "Chio BBS Projection Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifest_id",
    "artifact_ref",
    "canonicalization",
    "hash_algorithm",
    "message_slots",
    "hidden_predicates"
  ],
  "properties": {
    "schema": { "const": "chio.bbs-projection.manifest.v2" },
    "manifest_id": { "type": "string", "minLength": 1 },
    "artifact_ref": { "$ref": "#/$defs/sha256" },
    "canonicalization": { "type": "string", "minLength": 1 },
    "hash_algorithm": { "const": "sha-256" },
    "message_slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/messageSlot" }
    },
    "hidden_predicates": {
      "type": "array",
      "items": { "$ref": "#/$defs/hiddenPredicate" }
    },
    "issuer_key_ref": { "type": "string", "minLength": 1 },
    "signature_ref": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "messageSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot",
        "field",
        "message_class",
        "sensitivity_class",
        "encoding",
        "wholesale_only",
        "disclosure"
      ],
      "properties": {
        "slot": { "type": "integer", "minimum": 0 },
        "field": { "type": "string", "minLength": 1 },
        "message_class": { "type": "string", "minLength": 1 },
        "sensitivity_class": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "wholesale_only": { "type": "boolean" },
        "disclosure": { "enum": ["disclosed", "hidden"] },
        "value_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "hiddenPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicate_id", "field", "operator"],
      "properties": {
        "predicate_id": { "type": "string", "minLength": 1 },
        "field": { "type": "string", "minLength": 1 },
        "operator": { "type": "string", "minLength": 1 },
        "value_sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
