{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-disclosure/v1/verifier-privacy-profile.schema.json",
  "title": "Chio Disclosure Verifier Privacy Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "profile_id",
    "allowed_proof_mechanisms",
    "transaction_passport_ref",
    "leakage_budget",
    "sensitivity_classes",
    "allowed_issuer_keys",
    "required_key_epoch_min",
    "forbidden_key_epochs",
    "required_status_freshness_seconds",
    "required_audience",
    "nonce_policy",
    "allowed_algorithms",
    "forbidden_algorithms",
    "required_transparency_state",
    "max_presentation_age_seconds",
    "allowed_disclosed_fields",
    "forbidden_disclosed_fields",
    "allowed_hidden_predicates",
    "forbidden_hidden_predicates"
  ],
  "properties": {
    "schema": { "const": "chio.disclosure.verifier-privacy-profile.v1" },
    "profile_id": { "type": "string", "minLength": 1 },
    "allowed_proof_mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "required_holder_binding": { "type": "string", "minLength": 1 },
    "transaction_passport_ref": { "type": "string", "minLength": 1 },
    "leakage_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_disclosed_fields", "max_hidden_predicates"],
      "properties": {
        "max_disclosed_fields": { "type": "integer", "minimum": 0 },
        "max_hidden_predicates": { "type": "integer", "minimum": 0 }
      }
    },
    "sensitivity_classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_id", "fields"],
        "properties": {
          "class_id": { "type": "string", "minLength": 1 },
          "fields": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          }
        }
      }
    },
    "allowed_issuer_keys": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "required_key_epoch_min": { "type": "integer", "minimum": 0 },
    "forbidden_key_epochs": {
      "type": "array",
      "items": { "type": "integer", "minimum": 0 },
      "uniqueItems": true
    },
    "required_status_freshness_seconds": { "type": "integer", "minimum": 1 },
    "required_audience": { "type": "string", "minLength": 1 },
    "nonce_policy": { "enum": ["no_replay"] },
    "allowed_algorithms": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_algorithms": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "required_transparency_state": { "enum": ["none", "preview", "anchored"] },
    "max_presentation_age_seconds": { "type": "integer", "minimum": 1 },
    "allowed_disclosed_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_disclosed_fields": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "allowed_hidden_predicates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "forbidden_hidden_predicates": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
