{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-proof-room/v1/first-run-guard-report.schema.json",
  "title": "Chio Proof Room First Run Guard Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "guard_id",
    "decision",
    "policy_digest",
    "allow_receipt_ref",
    "denial_receipt_ref",
    "request_digest",
    "response_digest",
    "signature",
    "capability_id"
  ],
  "properties": {
    "schema": { "const": "chio.proof.first-run.guard-report.v1" },
    "id": { "type": "string", "minLength": 1 },
    "guard_id": { "type": "string", "minLength": 1 },
    "decision": { "type": "string", "minLength": 1 },
    "policy_digest": { "$ref": "#/$defs/sha256" },
    "allow_receipt_ref": { "type": "string", "minLength": 1 },
    "denial_receipt_ref": { "type": "string", "minLength": 1 },
    "request_digest": { "$ref": "#/$defs/sha256" },
    "response_digest": { "$ref": "#/$defs/sha256" },
    "signature": { "type": "string", "minLength": 1 },
    "capability_id": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
