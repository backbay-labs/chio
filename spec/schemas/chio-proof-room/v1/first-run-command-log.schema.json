{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-proof-room/v1/first-run-command-log.schema.json",
  "title": "Chio Proof Room First Run Command Log",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "commands"],
  "properties": {
    "schema": { "const": "chio.proof.first-run.command-log.v1" },
    "id": { "type": "string", "minLength": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "expected_exit_code", "evidence"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "expected_exit_code": { "type": "integer", "minimum": 0 },
          "evidence": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
