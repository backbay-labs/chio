{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/deposit.schema.json",
  "title": "Chio Pheromone Deposit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kernel_id",
    "agent_passport_key_hash",
    "agent_passport_jwk_thumbprint",
    "subject_class",
    "subject_class_namespace",
    "indicator",
    "severity",
    "confidence",
    "timestamp_unix_ms",
    "decay_half_life_secs",
    "nonce",
    "treaty_scope",
    "signature"
  ],
  "properties": {
    "schema": { "const": "chio.pheromone-deposit.v1" },
    "kernel_id": { "type": "string", "minLength": 1 },
    "agent_passport_key_hash": { "$ref": "#/$defs/hex64" },
    "agent_passport_jwk_thumbprint": { "type": "string", "minLength": 1 },
    "subject_class": { "type": "string", "minLength": 1 },
    "subject_class_namespace": { "type": "string", "minLength": 1 },
    "indicator": { "type": "object" },
    "severity": { "enum": ["low", "medium", "high", "critical"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "timestamp_unix_ms": { "type": "integer", "minimum": 0 },
    "decay_half_life_secs": { "type": "number", "exclusiveMinimum": 0 },
    "evaporation_floor": { "type": "number", "minimum": 0, "maximum": 1 },
    "nonce": { "type": "string", "minLength": 1 },
    "treaty_scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cost_commitment": { "$ref": "#/$defs/costCommitment" },
    "workflow_context": { "$ref": "#/$defs/workflowContext" },
    "signature": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hex64": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "costCommitment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "statement", "signature"],
      "properties": {
        "schema": { "const": "chio.pheromone-cost-commitment.v1" },
        "statement": { "$ref": "#/$defs/costStatement" },
        "signature": { "type": "string", "minLength": 1 }
      }
    },
    "costStatement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "commitmentId",
        "verifierId",
        "verifierKeyId",
        "runtimePolicySha256",
        "scarcityPolicySha256",
        "depositBodySha256",
        "depositSignatureSha256",
        "kernelId",
        "agentPassportKeyHash",
        "treatyId",
        "subjectClassNamespace",
        "subjectClass",
        "observationWindowStartUnixMs",
        "observationWindowEndUnixMs",
        "observedAtUnixMs",
        "eventDigestSha256",
        "cost",
        "telemetry",
        "inclusionProof",
        "leafPreimageSha256"
      ],
      "properties": {
        "schema": { "const": "chio.pheromone-observation-cost-statement.v1" },
        "commitmentId": { "type": "string", "minLength": 1 },
        "verifierId": { "type": "string", "minLength": 1 },
        "verifierKeyId": { "type": "string", "minLength": 1 },
        "runtimePolicySha256": { "$ref": "#/$defs/hex64" },
        "scarcityPolicySha256": { "$ref": "#/$defs/hex64" },
        "depositBodySha256": { "$ref": "#/$defs/hex64" },
        "depositSignatureSha256": { "$ref": "#/$defs/hex64" },
        "kernelId": { "type": "string", "minLength": 1 },
        "agentPassportKeyHash": { "$ref": "#/$defs/hex64" },
        "treatyId": { "type": "string", "minLength": 1 },
        "subjectClassNamespace": { "type": "string", "minLength": 1 },
        "subjectClass": { "type": "string", "minLength": 1 },
        "observationWindowStartUnixMs": { "type": "integer", "minimum": 0 },
        "observationWindowEndUnixMs": { "type": "integer", "minimum": 0 },
        "observedAtUnixMs": { "type": "integer", "minimum": 0 },
        "eventDigestSha256": { "$ref": "#/$defs/hex64" },
        "cost": { "$ref": "#/$defs/costAmount" },
        "telemetry": { "$ref": "#/$defs/telemetryRoot" },
        "inclusionProof": { "$ref": "#/$defs/inclusionProof" },
        "leafPreimageSha256": { "$ref": "#/$defs/hex64" }
      }
    },
    "costAmount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "amount"],
      "properties": {
        "unit": { "const": "chio.observation.microunit.v1" },
        "amount": { "type": "integer", "minimum": 1 }
      }
    },
    "telemetryRoot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "algorithm",
        "rootHash",
        "treeSize",
        "verifierId",
        "verifierKeyId",
        "closedAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.pheromone-observation-cost-telemetry-root.v1" },
        "algorithm": { "const": "rfc6962-sha256-v1" },
        "rootHash": {
          "type": "string",
          "pattern": "^0x[0-9a-f]{64}$"
        },
        "treeSize": { "type": "integer", "minimum": 1 },
        "verifierId": { "type": "string", "minLength": 1 },
        "verifierKeyId": { "type": "string", "minLength": 1 },
        "closedAtUnixMs": { "type": "integer", "minimum": 0 }
      }
    },
    "inclusionProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tree_size", "leaf_index", "audit_path"],
      "properties": {
        "tree_size": { "type": "integer", "minimum": 1 },
        "leaf_index": { "type": "integer", "minimum": 0 },
        "audit_path": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^0x[0-9a-f]{64}$"
          }
        }
      }
    },
    "workflowContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "workflow_id",
        "workflow_receipt_id",
        "workflow_receipt_sha256",
        "workflow_intersection_id",
        "workflow_intersection_sha256",
        "step_index",
        "tool_receipt_id",
        "bilateral_dsse_sha256",
        "consistency_anchor"
      ],
      "properties": {
        "schema": { "const": "chio.pheromone-workflow-context.v1" },
        "workflow_id": { "type": "string", "minLength": 1 },
        "workflow_receipt_id": { "type": "string", "minLength": 1 },
        "workflow_receipt_sha256": { "$ref": "#/$defs/hex64" },
        "workflow_intersection_id": { "type": "string", "minLength": 1 },
        "workflow_intersection_sha256": { "$ref": "#/$defs/hex64" },
        "step_index": { "type": "integer", "minimum": 0 },
        "tool_receipt_id": { "type": "string", "minLength": 1 },
        "bilateral_dsse_sha256": { "$ref": "#/$defs/hex64" },
        "consistency_anchor": { "type": "string", "minLength": 1 }
      }
    }
  }
}
