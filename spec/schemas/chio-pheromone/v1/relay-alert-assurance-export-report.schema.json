{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-export-report.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Export Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "accepted",
    "code",
    "localKernelId",
    "generatedAtUnixMs",
    "bundleId",
    "manifestSha256",
    "sourcePackageSha256",
    "artifactCount",
    "checks"
  ],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-export-report.v1" },
    "accepted": { "type": "boolean" },
    "code": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "bundleId": { "type": "string", "minLength": 1 },
    "manifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourcePackageSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactCount": { "type": "integer", "minimum": 0 },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "accepted", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
