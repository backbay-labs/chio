{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-normalization-profile.schema.json",
  "title": "Chio Pheromone Relay Alert Normalization Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "localKernelId",
    "issuedAtUnixMs",
    "expiresAtUnixMs",
    "maxSourceAgeMs",
    "receivers"
  ],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-normalization-profile.v1" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "maxSourceAgeMs": { "type": "integer", "minimum": 1 },
    "receivers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/receiver" }
    }
  },
  "$defs": {
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receiverId",
        "kind",
        "targetRef",
        "notificationRoute",
        "opsgenie",
        "severityFloor",
        "maxDelayMs",
        "runbook"
      ],
      "properties": {
        "receiverId": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
        "kind": { "enum": ["alertmanager", "pagerduty", "opsgenie", "slack", "email", "webhook"] },
        "targetRef": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
        "notificationRoute": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
        "opsgenie": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
        "severityFloor": { "enum": ["info", "warning", "critical"] },
        "maxDelayMs": { "type": "integer", "minimum": 1 },
        "runbook": { "type": "string", "minLength": 1 }
      }
    }
  }
}
