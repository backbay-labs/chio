{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-archive-restore-drill-report.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Archive Restore Drill Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "accepted", "code", "localKernelId", "generatedAtUnixMs", "packageCount", "verifiedGenerationCount", "latestPackageGeneration", "quarantineCount", "blockedCount", "packages", "checks"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-archive-restore-drill-report.v1" },
    "accepted": { "type": "boolean" },
    "code": { "$ref": "#/$defs/token" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "packageCount": { "type": "integer", "minimum": 0 },
    "verifiedGenerationCount": { "type": "integer", "minimum": 0 },
    "latestPackageGeneration": { "type": "integer", "minimum": 0 },
    "quarantineCount": { "type": "integer", "minimum": 0 },
    "blockedCount": { "type": "integer", "minimum": 0 },
    "packages": { "type": "array", "items": { "$ref": "#/$defs/packageReview" } },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "packageReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packageId", "packageGeneration", "packageManifestSha256", "accepted", "code"],
      "properties": {
        "packageId": { "$ref": "#/$defs/token" },
        "packageGeneration": { "type": "integer", "minimum": 1 },
        "packageManifestSha256": { "$ref": "#/$defs/sha256" },
        "previousPackageManifestSha256": { "$ref": "#/$defs/sha256" },
        "accepted": { "type": "boolean" },
        "code": { "$ref": "#/$defs/token" }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "accepted", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
