{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-archive-package-negative-fixture-corpus.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Archive Package Negative Fixture Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-archive-package-negative-fixture-corpus.v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "expectedCode", "description"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z0-9_.-]{1,128}$" },
          "expectedCode": { "type": "string", "pattern": "^[a-z0-9_.-]{1,128}$" },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
