{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.dev/schemas/chio-pheromone/v1/relay-alert-assurance-export-negative-fixture-corpus.schema.json",
  "title": "Chiodos Pheromone Relay Alert Assurance Export Negative Fixture Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-export-negative-fixture-corpus.v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "expectedCode"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" },
          "expectedCode": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" }
        }
      }
    }
  }
}
