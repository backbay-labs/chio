{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.dev/schemas/chio-pheromone/v1/relay-alert-assurance-recovery-drill-report.schema.json",
  "title": "Chiodos Pheromone Relay Alert Assurance Recovery Drill Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "accepted", "code", "localKernelId", "generatedAtUnixMs", "drillCount", "drills", "checks"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-recovery-drill-report.v1" },
    "accepted": { "type": "boolean" },
    "code": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "drillCount": { "type": "integer", "minimum": 0 },
    "drills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "accepted", "code", "detail"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" },
          "accepted": { "type": "boolean" },
          "code": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" },
          "detail": { "type": "string", "minLength": 1 }
        }
      }
    },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "accepted", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
