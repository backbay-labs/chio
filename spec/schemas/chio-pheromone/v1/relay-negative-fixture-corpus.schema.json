{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-negative-fixture-corpus.schema.json",
  "title": "Chio Pheromone Relay Negative Fixture Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-negative-fixture-corpus.v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "target", "expectedFailureCode"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "expectedFailureCode": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
