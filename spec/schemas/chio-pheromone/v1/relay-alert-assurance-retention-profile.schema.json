{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.dev/schemas/chio-pheromone/v1/relay-alert-assurance-retention-profile.schema.json",
  "title": "Chiodos Pheromone Relay Alert Assurance Retention Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "localKernelId", "issuedAtUnixMs", "expiresAtUnixMs", "warningWindowMs", "rules"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-retention-profile.v1" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "warningWindowMs": { "type": "integer", "minimum": 0 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifactRole", "retainForMs", "legalHold"],
        "properties": {
          "artifactRole": { "type": "string", "pattern": "^[a-z0-9_.*-]{1,96}$" },
          "retainForMs": { "type": "integer", "minimum": 1 },
          "legalHold": { "type": "boolean" }
        }
      }
    }
  }
}
