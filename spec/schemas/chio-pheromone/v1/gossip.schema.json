{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/gossip.schema.json",
  "title": "Chio Pheromone Deposit Gossip",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "deposit",
    "origin_kernel_id",
    "gossiping_peer_kernel_id",
    "treaty_id",
    "ts_unix_ms"
  ],
  "properties": {
    "schema": { "const": "chio.pheromone-deposit-gossip.v1" },
    "deposit": {
      "type": "object",
      "additionalProperties": true,
      "required": ["schema", "signature"],
      "properties": {
        "schema": { "const": "chio.pheromone-deposit.v1" },
        "signature": { "type": "string", "minLength": 1 }
      }
    },
    "origin_kernel_id": { "type": "string", "minLength": 1 },
    "gossiping_peer_kernel_id": { "type": "string", "minLength": 1 },
    "treaty_id": { "type": "string", "minLength": 1 },
    "ts_unix_ms": { "type": "integer", "minimum": 0 },
    "transit_chain": { "$ref": "#/$defs/transitChain" }
  },
  "$defs": {
    "transitChain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hops"],
      "properties": {
        "hops": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/transitHop" }
        }
      }
    },
    "transitHop": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_kernel_id",
        "to_kernel_id",
        "treaty_id",
        "ladder_manifest_id",
        "ladder_manifest_sha256",
        "ladder_manifest_expires_at_unix_ms",
        "ladder_intersection_id",
        "ladder_intersection_sha256",
        "action_class_id",
        "emitted_at_unix_ms"
      ],
      "properties": {
        "from_kernel_id": { "type": "string", "minLength": 1 },
        "to_kernel_id": { "type": "string", "minLength": 1 },
        "treaty_id": { "type": "string", "minLength": 1 },
        "ladder_manifest_id": { "type": "string", "minLength": 1 },
        "ladder_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "ladder_manifest_expires_at_unix_ms": { "type": "integer", "minimum": 0 },
        "ladder_intersection_id": { "type": "string", "minLength": 1 },
        "ladder_intersection_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "action_class_id": { "type": "string", "minLength": 1 },
        "emitted_at_unix_ms": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
