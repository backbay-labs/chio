{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/negative-fixture-corpus.schema.json",
  "title": "Chio Pheromone Negative Fixture Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "cases"],
  "properties": {
    "schema": { "const": "chio.pheromone.negative-fixture-corpus.v1" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target", "mutation", "expected_failure_code"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "target": { "enum": ["deposit", "gossip", "policy"] },
        "mutation": {
          "type": "object",
          "additionalProperties": true,
          "required": ["op", "path"],
          "properties": {
            "op": { "enum": ["set", "remove"] },
            "path": {
              "type": "array",
              "minItems": 1,
              "items": {
                "anyOf": [
                  { "type": "string", "minLength": 1 },
                  { "type": "integer", "minimum": 0 }
                ]
              }
            }
          }
        },
        "expected_failure_code": { "type": "string", "minLength": 1 }
      }
    }
  }
}
