{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.dev/schemas/chio-pheromone/v1/relay-alert-handoff-profile.schema.json",
  "title": "Chiodos Pheromone Relay Alert Handoff Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "localKernelId",
    "issuedAtUnixMs",
    "expiresAtUnixMs",
    "maxAlertReportAgeMs",
    "maxTrendReportAgeMs",
    "receivers",
    "escalations"
  ],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-handoff-profile.v1" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "maxAlertReportAgeMs": { "type": "integer", "minimum": 1 },
    "maxTrendReportAgeMs": { "type": "integer", "minimum": 1 },
    "receivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "receiverId",
          "kind",
          "targetRef",
          "notificationRoute",
          "opsgenie",
          "severityFloor",
          "escalationRef",
          "runbook"
        ],
        "properties": {
          "receiverId": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
          "kind": {
            "enum": ["alertmanager", "pagerduty", "opsgenie", "slack", "email", "webhook"]
          },
          "targetRef": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
          "notificationRoute": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
          "opsgenie": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
          "severityFloor": { "enum": ["info", "warning", "critical"] },
          "escalationRef": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
          "runbook": { "type": "string", "minLength": 1 }
        }
      }
    },
    "escalations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["escalationRef", "severity", "maxDelayMs", "recommendationCode"],
        "properties": {
          "escalationRef": { "type": "string", "pattern": "^[a-z0-9_.:/-]{1,128}$" },
          "severity": { "enum": ["info", "warning", "critical"] },
          "maxDelayMs": { "type": "integer", "minimum": 1 },
          "recommendationCode": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" }
        }
      }
    }
  }
}
