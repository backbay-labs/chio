{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/batch.schema.json",
  "title": "Chio Pheromone Batch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "recipient_kernel_id",
    "treaty_id",
    "frames",
    "flushed_at_unix_ms"
  ],
  "properties": {
    "schema": { "const": "chio.pheromone-batch.v1" },
    "recipient_kernel_id": { "type": "string", "minLength": 1 },
    "treaty_id": { "type": "string", "minLength": 1 },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["schema", "deposit", "origin_kernel_id", "treaty_id"],
        "properties": {
          "schema": { "const": "chio.pheromone-deposit-gossip.v1" }
        }
      }
    },
    "flushed_at_unix_ms": { "type": "integer", "minimum": 0 }
  }
}
