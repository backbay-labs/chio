{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/peer-directory-bundle.schema.json",
  "title": "Chio Pheromone Peer Directory Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "body", "directory", "signature"],
  "properties": {
    "schema": { "const": "chio.pheromone.peer-directory-bundle.v1" },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "issuer",
        "keyId",
        "directorySha256",
        "version",
        "issuedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.pheromone.peer-directory-bundle.v1" },
        "issuer": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "directorySha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "integer", "minimum": 0 },
        "previousVersionSha256": {
          "anyOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        },
        "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
        "expiresAtUnixMs": { "type": "integer", "minimum": 0 }
      }
    },
    "directory": { "$ref": "#/$defs/directory" },
    "signature": { "type": "string", "minLength": 64 }
  },
  "$defs": {
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "localKernelId", "issuedAtUnixMs", "expiresAtUnixMs", "peers"],
      "properties": {
        "schema": { "const": "chio.pheromone.peer-directory.v1" },
        "localKernelId": { "type": "string", "minLength": 1 },
        "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
        "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
        "peers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/peer" }
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernelId",
        "publicKey",
        "endpoint",
        "treatySubscriptions",
        "relayRole",
        "allowedSubjectClassNamespaces",
        "acceptedLadderRefs",
        "maxBatchFrames",
        "maxCatchupFrames",
        "maxCatchupBytes"
      ],
      "properties": {
        "kernelId": { "type": "string", "minLength": 1 },
        "publicKey": { "type": "string", "minLength": 64 },
        "endpoint": { "type": "string", "format": "uri" },
        "treatySubscriptions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "relayRole": { "enum": ["origin", "hub", "receiver"] },
        "allowedSubjectClassNamespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "acceptedLadderRefs": {
          "type": "array",
          "items": { "$ref": "#/$defs/ladderRef" }
        },
        "maxBatchFrames": { "type": "integer", "minimum": 1 },
        "maxCatchupFrames": { "type": "integer", "minimum": 1 },
        "maxCatchupBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "ladderRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ladderManifestId", "ladderManifestSha256", "expiresAtUnixMs"],
      "properties": {
        "ladderManifestId": { "type": "string", "minLength": 1 },
        "ladderManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "expiresAtUnixMs": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
