{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-trusted-exporters.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Trusted Exporters",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "localKernelId", "minExportedAtUnixMs", "exporters"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-trusted-exporters.v1" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "minExportedAtUnixMs": { "type": "integer", "minimum": 0 },
    "exporters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exporterId",
          "keyId",
          "publicKey",
          "validFromUnixMs",
          "validUntilUnixMs",
          "status"
        ],
        "properties": {
          "exporterId": { "type": "string", "minLength": 1 },
          "keyId": { "type": "string", "minLength": 1 },
          "publicKey": { "type": "string", "minLength": 64 },
          "validFromUnixMs": { "type": "integer", "minimum": 0 },
          "validUntilUnixMs": { "type": "integer", "minimum": 0 },
          "status": { "enum": ["active", "inactive", "revoked"] }
        }
      }
    }
  }
}
