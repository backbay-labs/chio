{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-trusted-archive-packagers.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Trusted Archive Packagers",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "localKernelId", "minCreatedAtUnixMs", "packagers"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-trusted-archive-packagers.v1" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "minCreatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "packagers": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/packager" } }
  },
  "$defs": {
    "packager": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packagerId", "keyId", "publicKey", "validFromUnixMs", "validUntilUnixMs", "status"],
      "properties": {
        "packagerId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "keyId": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" },
        "publicKey": { "type": "string", "minLength": 64 },
        "validFromUnixMs": { "type": "integer", "minimum": 0 },
        "validUntilUnixMs": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["active", "inactive", "revoked"] }
      }
    }
  }
}
