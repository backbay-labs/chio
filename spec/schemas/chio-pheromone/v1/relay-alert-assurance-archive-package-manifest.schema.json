{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-archive-package-manifest.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Archive Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "body",
    "signerPublicKey",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "chio.pheromone.relay-alert-assurance-archive-package-manifest.v1"
    },
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "packageId",
        "localKernelId",
        "packagerId",
        "packagerKeyId",
        "createdAtUnixMs",
        "packageGeneration",
        "compressionFormat",
        "sourceArchiveReportSha256",
        "sourceCloseoutReportSha256",
        "bundleCount",
        "memberCount",
        "totalByteCount",
        "bundles",
        "members",
        "safetyClaims"
      ],
      "properties": {
        "schema": {
          "const": "chio.pheromone.relay-alert-assurance-archive-package-manifest.v1"
        },
        "packageId": {
          "$ref": "#/$defs/token"
        },
        "localKernelId": {
          "type": "string",
          "minLength": 1
        },
        "packagerId": {
          "$ref": "#/$defs/token"
        },
        "packagerKeyId": {
          "$ref": "#/$defs/token"
        },
        "createdAtUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "packageGeneration": {
          "type": "integer",
          "minimum": 1
        },
        "previousPackageManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "compressionFormat": {
          "const": "tar.gz"
        },
        "sourceArchiveReportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourceCloseoutReportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "bundleCount": {
          "type": "integer",
          "minimum": 1
        },
        "memberCount": {
          "type": "integer",
          "minimum": 1
        },
        "totalByteCount": {
          "type": "integer",
          "minimum": 1
        },
        "bundles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/bundle"
          }
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/member"
          }
        },
        "safetyClaims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/token"
          }
        }
      }
    },
    "signerPublicKey": {
      "type": "string",
      "minLength": 64
    },
    "signature": {
      "type": "string",
      "minLength": 64
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]{1,128}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "^(?:/|.*\\.\\.|.*\\\\|.*:|.*//|.*\\s)"
      }
    },
    "bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleId",
        "bundlePath",
        "exportManifestSha256",
        "exportReportSha256",
        "sourcePackageSha256",
        "artifactCount"
      ],
      "properties": {
        "bundleId": {
          "$ref": "#/$defs/token"
        },
        "bundlePath": {
          "$ref": "#/$defs/path"
        },
        "exportManifestSha256": {
          "$ref": "#/$defs/sha256"
        },
        "exportReportSha256": {
          "$ref": "#/$defs/sha256"
        },
        "sourcePackageSha256": {
          "$ref": "#/$defs/sha256"
        },
        "artifactCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "member": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "bundleId",
        "artifactRole",
        "schema",
        "sha256",
        "byteCount",
        "retentionClass"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "kind": {
          "const": "regular_file"
        },
        "bundleId": {
          "$ref": "#/$defs/token"
        },
        "artifactRole": {
          "$ref": "#/$defs/token"
        },
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0
        },
        "retentionClass": {
          "$ref": "#/$defs/token"
        }
      }
    }
  }
}
