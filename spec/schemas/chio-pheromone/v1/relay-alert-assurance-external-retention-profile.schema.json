{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-external-retention-profile.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance External Retention Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "localKernelId", "allowedRetentionSystemAliases", "maxPackageCount", "maxEvidenceAgeMs", "requireGenerationContinuity", "requireRestoreAccepted", "requirePhysicalReadback", "requireRetentionHandoffReady", "minSampledMembers", "minSampleCoverageBasisPoints", "recommendationCodes", "issuedAtUnixMs", "expiresAtUnixMs"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-external-retention-profile.v1" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "allowedRetentionSystemAliases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token" }, "uniqueItems": true },
    "maxPackageCount": { "type": "integer", "minimum": 1 },
    "maxEvidenceAgeMs": { "type": "integer", "minimum": 1 },
    "requireGenerationContinuity": { "type": "boolean" },
    "requireRestoreAccepted": { "type": "boolean" },
    "requirePhysicalReadback": { "type": "boolean" },
    "requireRetentionHandoffReady": { "type": "boolean" },
    "minSampledMembers": { "type": "integer", "minimum": 1 },
    "minSampleCoverageBasisPoints": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "recommendationCodes": { "type": "array", "items": { "$ref": "#/$defs/token" }, "uniqueItems": true },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" }
  }
}
