{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-retention-report.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Retention Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "accepted",
    "code",
    "localKernelId",
    "generatedAtUnixMs",
    "retainedCount",
    "expiringSoonCount",
    "eligibleForDeleteCount",
    "blockedCount",
    "missingCount",
    "quarantineCount",
    "entries",
    "checks"
  ],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-retention-report.v1" },
    "accepted": { "type": "boolean" },
    "code": { "type": "string", "pattern": "^[a-z0-9_.-]{1,96}$" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "retainedCount": { "type": "integer", "minimum": 0 },
    "expiringSoonCount": { "type": "integer", "minimum": 0 },
    "eligibleForDeleteCount": { "type": "integer", "minimum": 0 },
    "blockedCount": { "type": "integer", "minimum": 0 },
    "missingCount": { "type": "integer", "minimum": 0 },
    "quarantineCount": { "type": "integer", "minimum": 0 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    },
    "checks": { "type": "array", "items": { "$ref": "#/$defs/check" } }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundleId", "artifactRole", "path", "state", "retainUntilUnixMs", "detail"],
      "properties": {
        "bundleId": { "type": "string", "minLength": 1 },
        "artifactRole": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["retain", "expiring_soon", "eligible_for_delete", "blocked", "missing", "quarantine"]
        },
        "retainUntilUnixMs": {
          "anyOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "accepted", "detail"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "accepted": { "type": "boolean" },
        "detail": { "type": "string", "minLength": 1 }
      }
    }
  }
}
