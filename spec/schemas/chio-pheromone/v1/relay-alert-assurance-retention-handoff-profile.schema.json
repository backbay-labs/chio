{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/relay-alert-assurance-retention-handoff-profile.schema.json",
  "title": "Chio Pheromone Relay Alert Assurance Retention Handoff Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "localKernelId", "issuedAtUnixMs", "expiresAtUnixMs", "allowedSystemAliases"],
  "properties": {
    "schema": { "const": "chio.pheromone.relay-alert-assurance-retention-handoff-profile.v1" },
    "localKernelId": { "type": "string", "minLength": 1 },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "allowedSystemAliases": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,128}$" } }
  }
}
