{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-outcome/eligibility/v1",
  "title": "Chio Outcome Eligibility V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "eligibilityId",
        "requestId",
        "capabilityId",
        "toolServer",
        "toolName",
        "providerId",
        "listingId",
        "listingDigest",
        "providerBindingDigest",
        "pricingId",
        "pricingDigest",
        "predicateId",
        "predicateDigest",
        "quoteDigest",
        "outcomePrice",
        "settlementMode",
        "requestExtensionDigest",
        "preActionAuthorityDigest",
        "postGuardPolicyDigest",
        "receiverBindingDigest",
        "deliveryAckDeadlineUnixMs",
        "qualifiedRailId",
        "qualifiedRailCapabilityDigest",
        "railCaptureDeadlineUnixMs",
        "issuedAtUnixMs",
        "expiresAtUnixMs",
        "kernelAuthorityId",
        "kernelKeyEpoch"
      ],
      "properties": {
        "schema": { "const": "chio.outcome.eligibility.v1" },
        "eligibilityId": { "$ref": "#/$defs/digest" },
        "requestId": { "$ref": "#/$defs/text" },
        "capabilityId": { "$ref": "#/$defs/text" },
        "toolServer": { "$ref": "#/$defs/text" },
        "toolName": { "$ref": "#/$defs/text" },
        "providerId": { "$ref": "#/$defs/text" },
        "listingId": { "$ref": "#/$defs/text" },
        "listingDigest": { "$ref": "#/$defs/digest" },
        "providerBindingDigest": { "$ref": "#/$defs/digest" },
        "pricingId": { "$ref": "#/$defs/digest" },
        "pricingDigest": { "$ref": "#/$defs/digest" },
        "predicateId": { "$ref": "#/$defs/digest" },
        "predicateDigest": { "$ref": "#/$defs/digest" },
        "quoteDigest": { "$ref": "#/$defs/digest" },
        "slaDigest": { "$ref": "#/$defs/digest" },
        "outcomePrice": { "$ref": "#/$defs/positiveMoney" },
        "settlementMode": { "const": "hold_capture" },
        "requestExtensionDigest": { "$ref": "#/$defs/digest" },
        "preActionAuthorityDigest": { "$ref": "#/$defs/digest" },
        "postGuardPolicyDigest": { "$ref": "#/$defs/digest" },
        "receiverBindingDigest": { "$ref": "#/$defs/digest" },
        "deliveryAckDeadlineUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "qualifiedRailId": { "$ref": "#/$defs/text" },
        "qualifiedRailCapabilityDigest": { "$ref": "#/$defs/digest" },
        "railCaptureDeadlineUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "issuedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "kernelAuthorityId": { "$ref": "#/$defs/text" },
        "kernelKeyEpoch": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveMoney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "units"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "units": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
