{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-outcome/delivery-nonacceptance/v1",
  "title": "Chio Outcome Delivery Nonacceptance V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "nonacceptanceId",
        "requestId",
        "eligibilityDigest",
        "providerAcceptanceDigest",
        "outputDigest",
        "receiverBindingDigest",
        "deliveryId",
        "idempotencyKey",
        "receiverQueueId",
        "cancelledAtUnixMs",
        "receiverKeyId",
        "receiverKeyEpoch",
        "deliveryCheckpointSequence",
        "deliveryCheckpointDigest",
        "blobAbsenceProofDigest",
        "cancellationFenceDigest"
      ],
      "properties": {
        "schema": { "const": "chio.outcome.delivery-nonacceptance.v1" },
        "nonacceptanceId": { "$ref": "#/$defs/digest" },
        "requestId": { "$ref": "#/$defs/text" },
        "eligibilityDigest": { "$ref": "#/$defs/digest" },
        "providerAcceptanceDigest": { "$ref": "#/$defs/digest" },
        "outputDigest": { "$ref": "#/$defs/digest" },
        "receiverBindingDigest": { "$ref": "#/$defs/digest" },
        "deliveryId": { "$ref": "#/$defs/text" },
        "idempotencyKey": { "$ref": "#/$defs/text" },
        "receiverQueueId": { "$ref": "#/$defs/text" },
        "cancelledAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "receiverKeyId": { "$ref": "#/$defs/text" },
        "receiverKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "deliveryCheckpointSequence": { "$ref": "#/$defs/positiveInteger" },
        "deliveryCheckpointDigest": { "$ref": "#/$defs/digest" },
        "blobAbsenceProofDigest": { "$ref": "#/$defs/digest" },
        "cancellationFenceDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
