{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-outcome/request/v1",
  "title": "Chio Verified Outcome Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "listingId",
    "listingDigest",
    "providerBindingDigest",
    "pricingId",
    "pricingDigest",
    "predicateId",
    "predicateDigest",
    "receiverBindingDigest"
  ],
  "properties": {
    "schema": { "const": "chio.outcome.request.v1" },
    "listingId": { "$ref": "#/$defs/text" },
    "listingDigest": { "$ref": "#/$defs/digest" },
    "providerBindingDigest": { "$ref": "#/$defs/digest" },
    "pricingId": { "$ref": "#/$defs/digest" },
    "pricingDigest": { "$ref": "#/$defs/digest" },
    "predicateId": { "$ref": "#/$defs/digest" },
    "predicateDigest": { "$ref": "#/$defs/digest" },
    "slaDigest": { "$ref": "#/$defs/digest" },
    "receiverBindingDigest": { "$ref": "#/$defs/digest" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    }
  }
}
