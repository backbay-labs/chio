{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-outcome/pricing/v1",
  "title": "Chio Outcome Pricing V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "pricingId",
        "providerId",
        "predicateId",
        "predicateDigest",
        "outcomePrice",
        "failureMode",
        "issuedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.outcome.pricing.v1" },
        "pricingId": { "$ref": "#/$defs/digest" },
        "providerId": { "$ref": "#/$defs/text" },
        "predicateId": { "$ref": "#/$defs/digest" },
        "predicateDigest": { "$ref": "#/$defs/digest" },
        "outcomePrice": { "$ref": "#/$defs/positiveMoney" },
        "failureMode": { "const": "zero_charge" },
        "slaDigest": { "$ref": "#/$defs/digest" },
        "issuedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "positiveMoney": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "units"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "units": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
