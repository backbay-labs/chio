{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/financial-credential-defs/v1.schema.json",
  "$defs": {
    "iJsonInteger": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveIJsonInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "publicKey": {
      "$ref": "#/$defs/digest"
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    },
    "did": {
      "type": "string",
      "pattern": "^did:chio:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "financialFamily": {
      "enum": [
        "credit_scorecard",
        "exposure_history",
        "settlement_reliability",
        "premium_history",
        "loss_history"
      ]
    },
    "passportCredentialFamily": {
      "enum": [
        "reputation",
        "credit_scorecard",
        "exposure_history",
        "settlement_reliability",
        "premium_history",
        "loss_history"
      ]
    },
    "evidenceClass": {
      "enum": ["asserted", "observed", "verified"]
    },
    "money": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/iJsonInteger" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startsAt", "endsAt"],
      "properties": {
        "startsAt": { "$ref": "#/$defs/iJsonInteger" },
        "endsAt": { "$ref": "#/$defs/iJsonInteger" }
      }
    },
    "queryKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceFamily", "subject", "occurredAt", "artifactId"],
      "properties": {
        "sourceFamily": { "$ref": "#/$defs/financialFamily" },
        "subject": { "$ref": "#/$defs/did" },
        "occurredAt": { "$ref": "#/$defs/iJsonInteger" },
        "artifactId": { "$ref": "#/$defs/identifier" }
      }
    },
    "sourceBundleArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "artifactSchema", "artifactDigest", "canonicalArtifact"],
      "properties": {
        "role": { "enum": ["claim", "member"] },
        "artifactSchema": { "$ref": "#/$defs/identifier" },
        "artifactDigest": { "$ref": "#/$defs/digest" },
        "canonicalArtifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 524288
        }
      }
    },
    "sourceDisclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "artifacts"],
      "properties": {
        "kind": { "const": "bundled" },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/sourceBundleArtifact" }
        }
      }
    },
    "merkleProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["treeSize", "leafIndex", "auditPath"],
      "properties": {
        "treeSize": { "$ref": "#/$defs/positiveIJsonInteger" },
        "leafIndex": { "$ref": "#/$defs/iJsonInteger" },
        "auditPath": {
          "type": "array",
          "maxItems": 64,
          "items": { "$ref": "#/$defs/digest" }
        }
      }
    },
    "committedLeaf": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "queryKey", "sourceArtifactDigest"],
      "properties": {
        "index": { "$ref": "#/$defs/iJsonInteger" },
        "queryKey": { "$ref": "#/$defs/queryKey" },
        "sourceArtifactDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "committedLeafProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf", "indexProof"],
      "properties": {
        "leaf": { "$ref": "#/$defs/committedLeaf" },
        "indexProof": { "$ref": "#/$defs/merkleProof" }
      }
    },
    "completenessBoundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "source_edge" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "leafProof"],
          "properties": {
            "kind": { "const": "adjacent" },
            "leafProof": { "$ref": "#/$defs/committedLeafProof" }
          }
        }
      ]
    },
    "sourceMemberBody": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "queryKey", "artifactSchema", "canonicalArtifact"],
      "properties": {
        "schema": { "const": "chio.fincred.source-member.v1" },
        "queryKey": { "$ref": "#/$defs/queryKey" },
        "artifactSchema": {
          "enum": [
            "chio.fincred.exposure-receipt-member.v1",
            "chio.fincred.exposure-decision-member.v1"
          ]
        },
        "canonicalArtifact": {
          "type": "string",
          "minLength": 1,
          "maxLength": 524288
        }
      }
    },
    "sourceCheckpointBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceId",
        "checkpointAuthorityEpoch",
        "checkpointAuthorityKey",
        "storeGeneration",
        "checkpointSequence",
        "cutoff",
        "window",
        "indexSize",
        "rangeRoot",
        "indexRoot",
        "lowerBoundary",
        "upperBoundary",
        "issuedAt",
        "expiresAt"
      ],
      "properties": {
        "schema": { "const": "chio.fincred.source-checkpoint.v1" },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "checkpointAuthorityEpoch": { "$ref": "#/$defs/positiveIJsonInteger" },
        "checkpointAuthorityKey": { "$ref": "#/$defs/publicKey" },
        "storeGeneration": { "$ref": "#/$defs/positiveIJsonInteger" },
        "checkpointSequence": { "$ref": "#/$defs/positiveIJsonInteger" },
        "cutoff": { "$ref": "#/$defs/iJsonInteger" },
        "window": { "$ref": "#/$defs/window" },
        "indexSize": { "$ref": "#/$defs/positiveIJsonInteger" },
        "rangeRoot": { "$ref": "#/$defs/digest" },
        "indexRoot": { "$ref": "#/$defs/digest" },
        "lowerBoundary": { "$ref": "#/$defs/completenessBoundary" },
        "upperBoundary": { "$ref": "#/$defs/completenessBoundary" },
        "issuedAt": { "$ref": "#/$defs/iJsonInteger" },
        "expiresAt": { "$ref": "#/$defs/iJsonInteger" }
      }
    },
    "sourceCompletenessAttestationBody": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "sourceId",
        "sourceFamily",
        "subject",
        "sourceSignerKey",
        "checkpointAuthorityEpoch",
        "checkpointAuthorityKey",
        "storeGeneration",
        "checkpointSequence",
        "checkpointDigest",
        "cutoff",
        "window",
        "committedLeaves",
        "rangeRoot",
        "indexRoot",
        "lowerBoundary",
        "upperBoundary",
        "sourceArtifactDigests",
        "disclosureDigest",
        "attestationReference",
        "issuedAt",
        "expiresAt",
        "sourceEvidenceClass"
      ],
      "properties": {
        "schema": { "const": "chio.fincred.source-completeness-attestation.v1" },
        "sourceId": { "$ref": "#/$defs/identifier" },
        "sourceFamily": { "$ref": "#/$defs/financialFamily" },
        "subject": { "$ref": "#/$defs/did" },
        "sourceSignerKey": { "$ref": "#/$defs/publicKey" },
        "checkpointAuthorityEpoch": { "$ref": "#/$defs/positiveIJsonInteger" },
        "checkpointAuthorityKey": { "$ref": "#/$defs/publicKey" },
        "storeGeneration": { "$ref": "#/$defs/positiveIJsonInteger" },
        "checkpointSequence": { "$ref": "#/$defs/positiveIJsonInteger" },
        "checkpointDigest": { "$ref": "#/$defs/digest" },
        "cutoff": { "$ref": "#/$defs/iJsonInteger" },
        "window": { "$ref": "#/$defs/window" },
        "committedLeaves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": { "$ref": "#/$defs/committedLeafProof" }
        },
        "rangeRoot": { "$ref": "#/$defs/digest" },
        "indexRoot": { "$ref": "#/$defs/digest" },
        "lowerBoundary": { "$ref": "#/$defs/completenessBoundary" },
        "upperBoundary": { "$ref": "#/$defs/completenessBoundary" },
        "sourceArtifactDigests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        },
        "disclosureDigest": { "$ref": "#/$defs/digest" },
        "attestationReference": { "$ref": "#/$defs/identifier" },
        "issuedAt": { "$ref": "#/$defs/iJsonInteger" },
        "expiresAt": { "$ref": "#/$defs/iJsonInteger" },
        "sourceEvidenceClass": { "$ref": "#/$defs/evidenceClass" }
      }
    },
    "signedSourceMember": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "signerKey", "signature"],
      "properties": {
        "body": { "$ref": "#/$defs/sourceMemberBody" },
        "signerKey": { "$ref": "#/$defs/publicKey" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "signedSourceCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "signerKey", "signature"],
      "properties": {
        "body": { "$ref": "#/$defs/sourceCheckpointBody" },
        "signerKey": { "$ref": "#/$defs/publicKey" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "signedSourceCompletenessAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["body", "signerKey", "signature"],
      "properties": {
        "body": { "$ref": "#/$defs/sourceCompletenessAttestationBody" },
        "signerKey": { "$ref": "#/$defs/publicKey" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window", "sourceDisclosure", "sourceCompletenessAttestations"],
      "properties": {
        "window": { "$ref": "#/$defs/window" },
        "sourceDisclosure": { "$ref": "#/$defs/sourceDisclosure" },
        "sourceCompletenessAttestations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": { "$ref": "#/$defs/signedSourceCompletenessAttestation" }
        }
      }
    },
    "proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "created", "proofPurpose", "verificationMethod", "proofValue"],
      "properties": {
        "type": { "const": "Ed25519Signature2020" },
        "created": { "type": "string", "format": "date-time" },
        "proofPurpose": { "const": "assertionMethod" },
        "verificationMethod": {
          "type": "string",
          "pattern": "^did:chio:[0-9a-f]{64}#key-1$"
        },
        "proofValue": { "$ref": "#/$defs/signature" }
      }
    },
    "credential": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "family",
        "credentialId",
        "@context",
        "type",
        "issuer",
        "issuerKeyEpoch",
        "issuanceDate",
        "expirationDate",
        "credentialSubject",
        "evidence",
        "sourceEvidenceClass",
        "presentationEvidenceClass",
        "proof"
      ],
      "properties": {
        "schema": { "type": "string" },
        "family": { "$ref": "#/$defs/financialFamily" },
        "credentialId": { "$ref": "#/$defs/digest" },
        "@context": {
          "const": [
            "https://www.w3.org/2018/credentials/v1",
            "https://chio.world/credentials/v1"
          ]
        },
        "type": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "string" }
        },
        "issuer": { "$ref": "#/$defs/did" },
        "issuerKeyEpoch": { "$ref": "#/$defs/positiveIJsonInteger" },
        "issuanceDate": { "type": "string", "format": "date-time" },
        "expirationDate": { "type": "string", "format": "date-time" },
        "credentialSubject": { "type": "object" },
        "evidence": { "$ref": "#/$defs/evidence" },
        "sourceEvidenceClass": { "$ref": "#/$defs/evidenceClass" },
        "presentationEvidenceClass": { "const": "asserted" },
        "proof": { "$ref": "#/$defs/proof" }
      }
    },
    "exposurePosition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "governedMax",
        "reserved",
        "settled",
        "pending",
        "failed",
        "provisionalLoss",
        "recovered"
      ],
      "properties": {
        "governedMax": { "$ref": "#/$defs/money" },
        "reserved": { "$ref": "#/$defs/money" },
        "settled": { "$ref": "#/$defs/money" },
        "pending": { "$ref": "#/$defs/money" },
        "failed": { "$ref": "#/$defs/money" },
        "provisionalLoss": { "$ref": "#/$defs/money" },
        "recovered": { "$ref": "#/$defs/money" }
      }
    }
  }
}
