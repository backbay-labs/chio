{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/clearing-participant-snapshot-acknowledgement/v1",
  "title": "Chio Clearing Participant Snapshot Acknowledgement V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "participantSnapshotDigest",
        "participantId",
        "algorithmVersion",
        "keyEpoch",
        "acceptedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.clearing.participant-snapshot-acknowledgement.v1" },
        "participantSnapshotDigest": { "$ref": "#/$defs/digest" },
        "participantId": { "$ref": "#/$defs/text" },
        "algorithmVersion": { "const": "balance_match.v1" },
        "keyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "acceptedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
