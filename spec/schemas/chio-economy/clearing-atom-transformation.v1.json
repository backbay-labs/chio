{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/clearing-atom-transformation/v1",
  "title": "Chio Clearing Atom Transformation V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "roundCoreDigest",
        "sourceSequence",
        "obligationId",
        "atomDigest",
        "debtorIdentity",
        "creditorIdentity",
        "debtorParticipantId",
        "creditorParticipantId",
        "amount"
      ],
      "properties": {
        "schema": { "const": "chio.clearing.atom-transformation.v1" },
        "roundCoreDigest": { "$ref": "#/$defs/digest" },
        "sourceSequence": { "$ref": "#/$defs/positiveInteger" },
        "obligationId": { "$ref": "#/$defs/digest" },
        "atomDigest": { "$ref": "#/$defs/digest" },
        "debtorIdentity": { "$ref": "#/$defs/text" },
        "creditorIdentity": { "$ref": "#/$defs/text" },
        "debtorParticipantId": { "$ref": "#/$defs/text" },
        "creditorParticipantId": { "$ref": "#/$defs/text" },
        "amount": { "$ref": "#/$defs/amount" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/positiveInteger" },
        "currency": { "$ref": "#/$defs/currency" }
      }
    }
  }
}
