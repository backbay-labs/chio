{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/factor-discount-quote/v1",
  "title": "Chio Discount Quote V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "quoteId", "claimId", "claimDigest",
    "underwritingDecisionDigest", "scorecardDigest", "outcome"
  ],
  "properties": {
    "schema": { "const": "chio.factor.discount-quote.v1" },
    "quoteId": { "$ref": "#/$defs/digest" },
    "claimId": { "$ref": "#/$defs/digest" },
    "claimDigest": { "$ref": "#/$defs/digest" },
    "underwritingDecisionDigest": { "$ref": "#/$defs/digest" },
    "scorecardDigest": { "$ref": "#/$defs/digest" },
    "outcome": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "resolved_discount_bps", "quoted_price"],
          "properties": {
            "kind": { "const": "quoted" },
            "resolved_discount_bps": { "$ref": "#/$defs/basisPoints" },
            "quoted_price": { "$ref": "#/$defs/amount" }
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "refusal_reason"],
          "properties": {
            "kind": { "const": "refused" },
            "refusal_reason": { "$ref": "#/$defs/text" }
          }
        }
      ]
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "basisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "amount": {
      "type": "object", "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/safeInteger" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
