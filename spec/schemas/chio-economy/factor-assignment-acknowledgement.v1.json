{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/factor-assignment-acknowledgement/v1",
  "title": "Signed Chio Factor Assignment Acknowledgement V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "acknowledgementId",
        "operationId",
        "normalizedRequestDigest",
        "agreementId",
        "agreementBodyDigest",
        "obligationId",
        "obligationAtomDigest",
        "priorDispositionKind",
        "buyerId",
        "buyerSettlementDestinationRef",
        "assignmentAuthorizationSetDigest",
        "statusProofDigest",
        "priorDispositionVersion",
        "priorDispositionLifecycleFence",
        "priorDispositionDigest",
        "resultingDispositionVersion",
        "resultingDispositionLifecycleFence",
        "resultingDispositionDigest",
        "expectedSnapshotVersion",
        "resultingSnapshotVersion",
        "expectedResourceFence",
        "resultingResourceFence",
        "authorityId",
        "authorityKeyEpoch",
        "effectiveAtUnixMs",
        "dueAtUnixMs",
        "acknowledgedAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.factor.assignment-acknowledgement.v1" },
        "acknowledgementId": { "$ref": "#/$defs/digest" },
        "operationId": { "$ref": "#/$defs/digest" },
        "normalizedRequestDigest": { "$ref": "#/$defs/digest" },
        "agreementId": { "$ref": "#/$defs/text" },
        "agreementBodyDigest": { "$ref": "#/$defs/digest" },
        "obligationId": { "$ref": "#/$defs/digest" },
        "obligationAtomDigest": { "$ref": "#/$defs/digest" },
        "priorDispositionKind": { "const": "per_call" },
        "buyerId": { "$ref": "#/$defs/text" },
        "buyerSettlementDestinationRef": { "$ref": "#/$defs/text" },
        "assignmentAuthorizationSetDigest": { "$ref": "#/$defs/digest" },
        "statusProofDigest": { "$ref": "#/$defs/digest" },
        "priorDispositionVersion": { "$ref": "#/$defs/positiveInteger" },
        "priorDispositionLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
        "priorDispositionDigest": { "$ref": "#/$defs/digest" },
        "resultingDispositionVersion": { "$ref": "#/$defs/positiveInteger" },
        "resultingDispositionLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
        "resultingDispositionDigest": { "$ref": "#/$defs/digest" },
        "expectedSnapshotVersion": { "$ref": "#/$defs/positiveInteger" },
        "resultingSnapshotVersion": { "$ref": "#/$defs/positiveInteger" },
        "expectedResourceFence": { "$ref": "#/$defs/positiveInteger" },
        "resultingResourceFence": { "$ref": "#/$defs/positiveInteger" },
        "authorityId": { "$ref": "#/$defs/text" },
        "authorityKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "effectiveAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "dueAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "acknowledgedAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
