{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/factor-assignment-offer/v1",
  "title": "Chio Assignment Offer V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "offerId", "claimId", "claimDigest", "sellerId",
    "askingDiscountBps", "minimumPrice", "issuedAtUnixMs",
    "expiresAtUnixMs", "dueAtUnixMs"
  ],
  "properties": {
    "schema": { "const": "chio.factor.assignment-offer.v1" },
    "offerId": { "$ref": "#/$defs/digest" },
    "claimId": { "$ref": "#/$defs/digest" },
    "claimDigest": { "$ref": "#/$defs/digest" },
    "sellerId": { "$ref": "#/$defs/text" },
    "askingDiscountBps": { "$ref": "#/$defs/basisPoints" },
    "minimumPrice": { "$ref": "#/$defs/amount" },
    "issuedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
    "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
    "dueAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "basisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "amount": {
      "type": "object", "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/safeInteger" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
