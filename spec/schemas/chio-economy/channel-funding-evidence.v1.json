{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/channel-funding-evidence/v1",
  "title": "Chio Channel Funding Evidence V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "authoritySignature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "escrowReference",
        "escrowTerms",
        "escrowState",
        "escrowStateRead",
        "creationEvent",
        "identityObservation",
        "tokenObservation",
        "assetBinding",
        "blockPin",
        "evidenceExpiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.channel.funding-evidence.v1" },
        "escrowReference": { "$ref": "#/$defs/escrowReference" },
        "escrowTerms": { "$ref": "#/$defs/escrowTerms" },
        "escrowState": { "$ref": "#/$defs/escrowState" },
        "escrowStateRead": { "$ref": "#/$defs/pinnedStateRead" },
        "creationEvent": { "$ref": "#/$defs/creationEvent" },
        "identityObservation": { "$ref": "#/$defs/identityObservation" },
        "tokenObservation": { "$ref": "#/$defs/tokenObservation" },
        "assetBinding": { "$ref": "#/$defs/assetBinding" },
        "blockPin": { "$ref": "#/$defs/blockPin" },
        "evidenceExpiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "authoritySignature": { "$ref": "#/$defs/channelSignature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chainId": { "type": "string", "pattern": "^eip155:([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$" },
    "evmAddress": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "evmHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "baseUnits": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,37}|[1-2][0-9]{38}|3[0-3][0-9]{37}|340[0-1][0-9]{35}|3402[0-7][0-9]{34}|34028[0-1][0-9]{33}|340282[0-2][0-9]{32}|3402823[0-5][0-9]{31}|34028236[0-5][0-9]{30}|340282366[0-8][0-9]{29}|3402823669[0-1][0-9]{28}|340282366920[0-8][0-9]{26}|3402823669209[0-2][0-9]{25}|34028236692093[0-7][0-9]{24}|340282366920938[0-3][0-9]{23}|3402823669209384[0-5][0-9]{22}|34028236692093846[0-2][0-9]{21}|340282366920938463[0-3][0-9]{20}|3402823669209384634[0-5][0-9]{19}|34028236692093846346[0-2][0-9]{18}|340282366920938463463[0-2][0-9]{17}|3402823669209384634633[0-6][0-9]{16}|34028236692093846346337[0-3][0-9]{15}|340282366920938463463374[0-5][0-9]{14}|34028236692093846346337460[0-6][0-9]{12}|340282366920938463463374607[0-3][0-9]{11}|3402823669209384634633746074[0-2][0-9]{10}|340282366920938463463374607430[0-9]{9}|340282366920938463463374607431[0-6][0-9]{8}|3402823669209384634633746074317[0-5][0-9]{7}|34028236692093846346337460743176[0-7][0-9]{6}|340282366920938463463374607431768[0-1][0-9]{5}|34028236692093846346337460743176820[0-9]{4}|340282366920938463463374607431768210[0-9]{3}|340282366920938463463374607431768211[0-3][0-9]{2}|3402823669209384634633746074317682114[0-4][0-9]|34028236692093846346337460743176821145[0-4]|340282366920938463463374607431768211455)$" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "nonNegativeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "publicKey": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$", "maxLength": 16384 },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$", "maxLength": 16384 },
    "escrowReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "escrowContract", "escrowId"],
      "properties": {
        "chainId": { "$ref": "#/$defs/chainId" },
        "escrowContract": { "$ref": "#/$defs/evmAddress" },
        "escrowId": { "$ref": "#/$defs/evmHash" }
      }
    },
    "escrowTerms": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capabilityId",
        "depositor",
        "beneficiary",
        "tokenAddress",
        "maxTokenBaseUnits",
        "deadlineUnixSecs",
        "operator",
        "operatorKeyHash"
      ],
      "properties": {
        "capabilityId": { "$ref": "#/$defs/evmHash" },
        "depositor": { "$ref": "#/$defs/evmAddress" },
        "beneficiary": { "$ref": "#/$defs/evmAddress" },
        "tokenAddress": { "$ref": "#/$defs/evmAddress" },
        "maxTokenBaseUnits": { "$ref": "#/$defs/baseUnits" },
        "deadlineUnixSecs": { "$ref": "#/$defs/positiveInteger" },
        "operator": { "$ref": "#/$defs/evmAddress" },
        "operatorKeyHash": { "$ref": "#/$defs/evmHash" }
      }
    },
    "escrowState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "depositedTokenBaseUnits",
        "releasedTokenBaseUnits",
        "refundedTokenBaseUnits",
        "refunded"
      ],
      "properties": {
        "depositedTokenBaseUnits": { "$ref": "#/$defs/baseUnits" },
        "releasedTokenBaseUnits": { "$ref": "#/$defs/baseUnits" },
        "refundedTokenBaseUnits": { "$ref": "#/$defs/baseUnits" },
        "refunded": { "type": "boolean" }
      }
    },
    "pinnedStateRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "blockNumber", "blockHash", "callDataDigest", "returnDataDigest"],
      "properties": {
        "contract": { "$ref": "#/$defs/evmAddress" },
        "blockNumber": { "$ref": "#/$defs/positiveInteger" },
        "blockHash": { "$ref": "#/$defs/evmHash" },
        "callDataDigest": { "$ref": "#/$defs/evmHash" },
        "returnDataDigest": { "$ref": "#/$defs/evmHash" }
      }
    },
    "creationEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transactionHash",
        "transactionTo",
        "transactionSucceeded",
        "receiptBlockNumber",
        "receiptBlockHash",
        "logEmitter",
        "logIndex",
        "eventSignature",
        "escrowId",
        "capabilityId",
        "depositor",
        "beneficiary",
        "tokenAddress",
        "maxTokenBaseUnits",
        "deadlineUnixSecs",
        "operator"
      ],
      "properties": {
        "transactionHash": { "$ref": "#/$defs/evmHash" },
        "transactionTo": { "$ref": "#/$defs/evmAddress" },
        "transactionSucceeded": { "const": true },
        "receiptBlockNumber": { "$ref": "#/$defs/positiveInteger" },
        "receiptBlockHash": { "$ref": "#/$defs/evmHash" },
        "logEmitter": { "$ref": "#/$defs/evmAddress" },
        "logIndex": { "$ref": "#/$defs/nonNegativeInteger" },
        "eventSignature": { "$ref": "#/$defs/evmHash" },
        "escrowId": { "$ref": "#/$defs/evmHash" },
        "capabilityId": { "$ref": "#/$defs/evmHash" },
        "depositor": { "$ref": "#/$defs/evmAddress" },
        "beneficiary": { "$ref": "#/$defs/evmAddress" },
        "tokenAddress": { "$ref": "#/$defs/evmAddress" },
        "maxTokenBaseUnits": { "$ref": "#/$defs/baseUnits" },
        "deadlineUnixSecs": { "$ref": "#/$defs/positiveInteger" },
        "operator": { "$ref": "#/$defs/evmAddress" }
      }
    },
    "identityObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryContract", "operator", "active", "operatorKeyHash", "blockNumber", "blockHash"],
      "properties": {
        "registryContract": { "$ref": "#/$defs/evmAddress" },
        "operator": { "$ref": "#/$defs/evmAddress" },
        "active": { "const": true },
        "operatorKeyHash": { "$ref": "#/$defs/evmHash" },
        "blockNumber": { "$ref": "#/$defs/positiveInteger" },
        "blockHash": { "$ref": "#/$defs/evmHash" }
      }
    },
    "tokenObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokenAddress", "tokenSymbol", "tokenDecimals", "allowed", "escrowContract", "blockNumber", "blockHash"],
      "properties": {
        "tokenAddress": { "$ref": "#/$defs/evmAddress" },
        "tokenSymbol": { "$ref": "#/$defs/text" },
        "tokenDecimals": { "type": "integer", "minimum": 0, "maximum": 38 },
        "allowed": { "const": true },
        "escrowContract": { "$ref": "#/$defs/evmAddress" },
        "blockNumber": { "$ref": "#/$defs/positiveInteger" },
        "blockHash": { "$ref": "#/$defs/evmHash" }
      }
    },
    "assetBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "currency",
        "protocolMinorUnitDecimals",
        "chainId",
        "tokenAddress",
        "tokenSymbol",
        "tokenDecimals",
        "settlementPolicyDigest"
      ],
      "properties": {
        "schema": { "const": "chio.channel.asset-binding.v1" },
        "currency": { "$ref": "#/$defs/currency" },
        "protocolMinorUnitDecimals": { "type": "integer", "minimum": 0, "maximum": 38 },
        "chainId": { "$ref": "#/$defs/chainId" },
        "tokenAddress": { "$ref": "#/$defs/evmAddress" },
        "tokenSymbol": { "$ref": "#/$defs/text" },
        "tokenDecimals": { "type": "integer", "minimum": 0, "maximum": 38 },
        "settlementPolicyDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "blockPin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blockNumber",
        "blockHash",
        "blockTimestampUnixSecs",
        "observedAtUnixMs",
        "requiredConfirmations",
        "observedConfirmations",
        "finalizedHeadNumber",
        "finalizedHeadHash",
        "finalityMode",
        "finalityStatus"
      ],
      "properties": {
        "blockNumber": { "$ref": "#/$defs/positiveInteger" },
        "blockHash": { "$ref": "#/$defs/evmHash" },
        "blockTimestampUnixSecs": { "$ref": "#/$defs/positiveInteger" },
        "observedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "requiredConfirmations": { "$ref": "#/$defs/positiveInteger" },
        "observedConfirmations": { "$ref": "#/$defs/nonNegativeInteger" },
        "finalizedHeadNumber": { "$ref": "#/$defs/positiveInteger" },
        "finalizedHeadHash": { "$ref": "#/$defs/evmHash" },
        "finalityMode": { "const": "l1_finalized" },
        "finalityStatus": { "const": "finalized" }
      }
    },
    "channelSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "keyEpoch", "signerKey", "signature"],
      "properties": {
        "signerId": { "$ref": "#/$defs/text" },
        "keyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "signerKey": { "$ref": "#/$defs/publicKey" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
