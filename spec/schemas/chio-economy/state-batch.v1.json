{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/state-batch/v1",
  "title": "Chio Economic State Batch V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "batchId",
    "checkpointDigest",
    "anchorId",
    "namespace",
    "checkpointSequence",
    "expectedHeadsRoot",
    "nextHeadsRoot",
    "transitions",
    "effectSlots",
    "requestReplays",
    "issuedAt",
    "signerKeyId",
    "signerKeyEpoch",
    "anchorSignature"
  ],
  "properties": {
    "schema": { "const": "chio.economy.state-batch.v1" },
    "batchId": { "$ref": "#/$defs/digest" },
    "checkpointDigest": { "$ref": "#/$defs/digest" },
    "anchorId": { "$ref": "#/$defs/identifier" },
    "namespace": { "$ref": "#/$defs/identifier" },
    "checkpointSequence": { "$ref": "#/$defs/positiveInteger" },
    "previousCheckpointDigest": { "$ref": "#/$defs/digest" },
    "expectedHeadsRoot": { "$ref": "#/$defs/digest" },
    "nextHeadsRoot": { "$ref": "#/$defs/digest" },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": { "$ref": "#/$defs/transition" }
    },
    "effectSlots": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "https://chio-protocol.dev/schemas/chio-economy/effect-slot/v1"
      }
    },
    "requestReplays": {
      "type": "array",
      "maxItems": 128,
      "items": { "$ref": "#/$defs/requestReplay" }
    },
    "operationId": { "$ref": "#/$defs/digest" },
    "issuedAt": { "$ref": "#/$defs/positiveInteger" },
    "signerKeyId": { "$ref": "#/$defs/identifier" },
    "signerKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
    "anchorSignature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "checkpointSequence": { "const": 1 } },
        "required": ["checkpointSequence"]
      },
      "then": { "not": { "required": ["previousCheckpointDigest"] } },
      "else": { "required": ["previousCheckpointDigest"] }
    }
  ],
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "resourceKey": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceFamily", "scopeId", "resourceId"],
      "properties": {
        "resourceFamily": { "$ref": "#/$defs/identifier" },
        "scopeId": { "$ref": "#/$defs/identifier" },
        "resourceId": { "$ref": "#/$defs/identifier" }
      }
    },
    "frost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizationSlotId",
        "authorizationId",
        "actionDigest",
        "signedEnvelopeDigest"
      ],
      "properties": {
        "authorizationSlotId": { "$ref": "#/$defs/digest" },
        "authorizationId": { "$ref": "#/$defs/digest" },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "signedEnvelopeDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "authorization": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "direct" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "frost"],
          "properties": {
            "mode": { "const": "n_of_m" },
            "frost": { "$ref": "#/$defs/frost" }
          }
        }
      ]
    },
    "preparedEffect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "actionDigest",
        "effectSlotId",
        "effectSlotDigest",
        "authorization"
      ],
      "properties": {
        "operationId": { "$ref": "#/$defs/digest" },
        "actionDigest": { "$ref": "#/$defs/digest" },
        "effectSlotId": { "$ref": "#/$defs/digest" },
        "effectSlotDigest": { "$ref": "#/$defs/digest" },
        "authorization": { "$ref": "#/$defs/authorization" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resourceKey", "nextHead", "transitionProofDigest"],
      "properties": {
        "resourceKey": { "$ref": "#/$defs/resourceKey" },
        "expectedHeadDigest": { "$ref": "#/$defs/digest" },
        "nextHead": {
          "$ref": "https://chio-protocol.dev/schemas/chio-economy/resource-head/v1"
        },
        "transitionProofDigest": { "$ref": "#/$defs/digest" },
        "preparedEffect": { "$ref": "#/$defs/preparedEffect" }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestNamespaceDigest",
        "requestId",
        "requestBindingDigest"
      ],
      "properties": {
        "requestNamespaceDigest": { "$ref": "#/$defs/digest" },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "requestBindingDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "requestReplay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "operationId", "effectSlotIds"],
      "properties": {
        "request": { "$ref": "#/$defs/request" },
        "operationId": { "$ref": "#/$defs/digest" },
        "effectSlotIds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest" }
        }
      }
    }
  }
}
