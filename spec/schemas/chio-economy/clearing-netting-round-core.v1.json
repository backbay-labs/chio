{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/clearing-netting-round-core/v1",
  "title": "Chio Clearing Netting Round Core V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "roundId",
        "epoch",
        "governanceScopeId",
        "clearingAuthorityId",
        "clearingAuthorityKeyEpoch",
        "currency",
        "algorithmVersion",
        "participantSnapshotDigest",
        "inputManifestDigest",
        "inputCount",
        "reservationRoot",
        "disputeWindowEndsAtUnixMs",
        "generatedAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.clearing.netting-round-core.v1" },
        "roundId": { "$ref": "#/$defs/text" },
        "epoch": { "$ref": "#/$defs/positiveInteger" },
        "governanceScopeId": { "$ref": "#/$defs/text" },
        "clearingAuthorityId": { "$ref": "#/$defs/text" },
        "clearingAuthorityKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "currency": { "$ref": "#/$defs/currency" },
        "algorithmVersion": { "const": "balance_match.v1" },
        "participantSnapshotDigest": { "$ref": "#/$defs/digest" },
        "inputManifestDigest": { "$ref": "#/$defs/digest" },
        "inputCount": { "$ref": "#/$defs/positiveInteger" },
        "reservationRoot": { "$ref": "#/$defs/digest" },
        "disputeWindowEndsAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "generatedAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
