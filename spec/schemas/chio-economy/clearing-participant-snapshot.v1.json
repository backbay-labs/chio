{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/clearing-participant-snapshot/v1",
  "title": "Chio Clearing Participant Snapshot V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "authorityId",
        "keyEpoch",
        "algorithmVersion",
        "validFromUnixMs",
        "expiresAtUnixMs",
        "participants"
      ],
      "properties": {
        "schema": { "const": "chio.clearing.participant-snapshot.v1" },
        "authorityId": { "$ref": "#/$defs/text" },
        "keyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "algorithmVersion": { "const": "balance_match.v1" },
        "validFromUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "participants": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1024,
          "items": { "$ref": "#/$defs/participant" }
        }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "participantId",
        "identities",
        "settlementDestination",
        "acknowledgementKey",
        "acknowledgementKeyEpoch"
      ],
      "properties": {
        "participantId": { "$ref": "#/$defs/text" },
        "identities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/text" }
        },
        "settlementDestination": { "$ref": "#/$defs/text" },
        "acknowledgementKey": { "$ref": "#/$defs/cryptoMaterial" },
        "acknowledgementKeyEpoch": { "$ref": "#/$defs/positiveInteger" }
      }
    }
  }
}
