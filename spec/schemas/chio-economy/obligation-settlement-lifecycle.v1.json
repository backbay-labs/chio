{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/obligation-settlement-lifecycle/v1",
  "title": "Chio Obligation Settlement Lifecycle V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "obligationId",
    "atomDigest",
    "state",
    "version",
    "lifecycleFence",
    "lastTransition"
  ],
  "properties": {
    "schema": { "const": "chio.obligation.settlement-lifecycle.v1" },
    "obligationId": { "$ref": "#/$defs/digest" },
    "atomDigest": { "$ref": "#/$defs/digest" },
    "state": { "$ref": "#/$defs/state" },
    "version": { "$ref": "#/$defs/positiveInteger" },
    "lifecycleFence": { "$ref": "#/$defs/positiveInteger" },
    "lastTransition": { "$ref": "#/$defs/transition" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "state": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "pending" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "settlement_id", "evidence_digest"],
          "properties": {
            "kind": { "const": "settled" },
            "settlement_id": { "$ref": "#/$defs/text" },
            "evidence_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failure_digest"],
          "properties": {
            "kind": { "const": "failed" },
            "failure_digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authority_digest"],
          "properties": {
            "kind": { "const": "produced" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "settlement_id", "evidence_digest", "authority_digest"],
          "properties": {
            "kind": { "const": "settle" },
            "settlement_id": { "$ref": "#/$defs/text" },
            "evidence_digest": { "$ref": "#/$defs/digest" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "failure_digest", "authority_digest"],
          "properties": {
            "kind": { "const": "fail" },
            "failure_digest": { "$ref": "#/$defs/digest" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    }
  }
}
