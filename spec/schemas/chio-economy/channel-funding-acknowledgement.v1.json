{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/channel-funding-acknowledgement/v1",
  "title": "Chio Channel Funding Acknowledgement V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "authoritySignature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "openIntentDigest",
        "escrowReference",
        "priorState",
        "priorVersion",
        "priorHeadDigest",
        "newState",
        "newVersion",
        "anchoredHeadDigest",
        "reservedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.channel.funding-acknowledgement.v1" },
        "openIntentDigest": { "$ref": "#/$defs/digest" },
        "escrowReference": { "$ref": "#/$defs/escrowReference" },
        "priorState": { "const": "unreserved" },
        "priorVersion": { "$ref": "#/$defs/positiveInteger" },
        "priorHeadDigest": { "$ref": "#/$defs/digest" },
        "newState": { "const": "opening" },
        "newVersion": { "$ref": "#/$defs/positiveInteger" },
        "anchoredHeadDigest": { "$ref": "#/$defs/digest" },
        "reservedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "authoritySignature": { "$ref": "#/$defs/channelSignature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chainId": { "type": "string", "pattern": "^eip155:([1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-4]|18446744073709551615)$" },
    "evmAddress": { "type": "string", "pattern": "^0x[0-9a-f]{40}$" },
    "evmHash": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "publicKey": { "type": "string", "pattern": "^([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}|hybrid:([0-9a-f]{64}|p256:[0-9a-f]{130}|p384:[0-9a-f]{194}):[0-9a-f]{3904}:(ed25519|p256|p384)\\+mldsa65)$", "maxLength": 16384 },
    "signature": { "type": "string", "pattern": "^([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+|hybrid:([0-9a-f]{128}|p256:[0-9a-f]+|p384:[0-9a-f]+):[0-9a-f]{6618}:(ed25519|p256|p384)\\+mldsa65)$", "maxLength": 16384 },
    "escrowReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["chainId", "escrowContract", "escrowId"],
      "properties": {
        "chainId": { "$ref": "#/$defs/chainId" },
        "escrowContract": { "$ref": "#/$defs/evmAddress" },
        "escrowId": { "$ref": "#/$defs/evmHash" }
      }
    },
    "channelSignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["signerId", "keyEpoch", "signerKey", "signature"],
      "properties": {
        "signerId": { "$ref": "#/$defs/text" },
        "keyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "signerKey": { "$ref": "#/$defs/publicKey" },
        "signature": { "$ref": "#/$defs/signature" }
      }
    }
  }
}
