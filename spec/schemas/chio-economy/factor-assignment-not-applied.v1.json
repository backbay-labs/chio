{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/factor-assignment-not-applied/v1",
  "title": "Signed Chio Factor Assignment Not Applied V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "resultId",
        "operationId",
        "normalizedRequestDigest",
        "agreementId",
        "agreementBodyDigest",
        "obligationId",
        "obligationAtomDigest",
        "assignmentAuthorizationSetDigest",
        "statusProofDigest",
        "expectedDispositionVersion",
        "expectedDispositionLifecycleFence",
        "expectedSettlementLifecycleVersion",
        "expectedSettlementLifecycleFence",
        "expectedSnapshotVersion",
        "expectedResourceFence",
        "observedDispositionVersion",
        "observedDispositionLifecycleFence",
        "observedDispositionDigest",
        "observedSettlementLifecycleVersion",
        "observedSettlementLifecycleFence",
        "observedSettlementLifecycleDigest",
        "observedSnapshotVersion",
        "resourceFence",
        "reason",
        "noMutationProofDigest",
        "authorityId",
        "authorityKeyEpoch",
        "decidedAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.factor.assignment-not-applied.v1" },
        "resultId": { "$ref": "#/$defs/digest" },
        "operationId": { "$ref": "#/$defs/digest" },
        "normalizedRequestDigest": { "$ref": "#/$defs/digest" },
        "agreementId": { "$ref": "#/$defs/text" },
        "agreementBodyDigest": { "$ref": "#/$defs/digest" },
        "obligationId": { "$ref": "#/$defs/digest" },
        "obligationAtomDigest": { "$ref": "#/$defs/digest" },
        "assignmentAuthorizationSetDigest": { "$ref": "#/$defs/digest" },
        "statusProofDigest": { "$ref": "#/$defs/digest" },
        "expectedDispositionVersion": { "$ref": "#/$defs/positiveInteger" },
        "expectedDispositionLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
        "expectedSettlementLifecycleVersion": { "$ref": "#/$defs/positiveInteger" },
        "expectedSettlementLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
        "expectedSnapshotVersion": { "$ref": "#/$defs/positiveInteger" },
        "expectedResourceFence": { "$ref": "#/$defs/positiveInteger" },
        "observedDispositionVersion": { "$ref": "#/$defs/positiveInteger" },
        "observedDispositionLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
        "observedDispositionDigest": { "$ref": "#/$defs/digest" },
        "observedSettlementLifecycleVersion": { "$ref": "#/$defs/positiveInteger" },
        "observedSettlementLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
        "observedSettlementLifecycleDigest": { "$ref": "#/$defs/digest" },
        "observedSnapshotVersion": { "$ref": "#/$defs/positiveInteger" },
        "resourceFence": { "$ref": "#/$defs/positiveInteger" },
        "reason": {
          "enum": [
            "already_assigned",
            "disposition_conflict",
            "settlement_not_pending",
            "status_proof_expired",
            "authorization_expired",
            "request_expired",
            "offer_expired",
            "past_due",
            "operation_conflict"
          ]
        },
        "noMutationProofDigest": { "$ref": "#/$defs/digest" },
        "authorityId": { "$ref": "#/$defs/text" },
        "authorityKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "decidedAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
