{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/credit-facility-bind/v1",
  "title": "Signed Chio Credit Facility Bind V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "body",
    "authoritySignature",
    "debtorSignature",
    "creditorSignature"
  ],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "bindId",
        "operationId",
        "requestId",
        "economicIntentDigest",
        "scopeDigest",
        "facilityId",
        "facilityArtifactDigest",
        "authoritySetDigest",
        "debtorId",
        "originalCreditorId",
        "originalSettlementDestinationRef",
        "payeeBindingDigest",
        "capabilityId",
        "toolServer",
        "toolName",
        "amount",
        "effectiveCeiling",
        "expectedExposureVersion",
        "expectedExposureFence",
        "dueAtUnixMs",
        "actionNonce",
        "issuedAtUnixMs",
        "expiresAtUnixMs",
        "authorityId",
        "authorityKeyEpoch",
        "debtorKeyEpoch",
        "creditorKeyEpoch"
      ],
      "properties": {
        "schema": { "const": "chio.credit.facility-bind.v1" },
        "bindId": { "$ref": "#/$defs/digest" },
        "operationId": { "$ref": "#/$defs/digest" },
        "requestId": { "$ref": "#/$defs/text" },
        "economicIntentDigest": { "$ref": "#/$defs/digest" },
        "scopeDigest": { "$ref": "#/$defs/digest" },
        "facilityId": { "$ref": "#/$defs/text" },
        "facilityArtifactDigest": { "$ref": "#/$defs/digest" },
        "authoritySetDigest": { "$ref": "#/$defs/digest" },
        "debtorId": { "$ref": "#/$defs/text" },
        "originalCreditorId": { "$ref": "#/$defs/text" },
        "originalSettlementDestinationRef": { "$ref": "#/$defs/text" },
        "payeeBindingDigest": { "$ref": "#/$defs/digest" },
        "capabilityId": { "$ref": "#/$defs/text" },
        "toolServer": { "$ref": "#/$defs/text" },
        "toolName": { "$ref": "#/$defs/text" },
        "amount": { "$ref": "#/$defs/amount" },
        "effectiveCeiling": { "$ref": "#/$defs/amount" },
        "expectedExposureVersion": { "$ref": "#/$defs/positiveInteger" },
        "expectedExposureFence": { "$ref": "#/$defs/positiveInteger" },
        "dueAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "actionNonce": { "$ref": "#/$defs/text" },
        "issuedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "authorityId": { "$ref": "#/$defs/text" },
        "authorityKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "debtorKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "creditorKeyEpoch": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "authoritySignature": { "$ref": "#/$defs/partySignature" },
    "debtorSignature": { "$ref": "#/$defs/partySignature" },
    "creditorSignature": { "$ref": "#/$defs/partySignature" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "amount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/positiveInteger" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    },
    "cryptoMaterial": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16384,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "partySignature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["partyId", "partyKeyEpoch", "signerKey", "signature"],
      "properties": {
        "partyId": { "$ref": "#/$defs/text" },
        "partyKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
        "signature": { "$ref": "#/$defs/cryptoMaterial" }
      }
    }
  }
}
