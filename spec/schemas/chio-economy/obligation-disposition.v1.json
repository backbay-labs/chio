{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/obligation-disposition/v1",
  "title": "Chio Obligation Disposition V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "obligationId",
    "atomDigest",
    "disposition",
    "version",
    "lifecycleFence",
    "lastTransition"
  ],
  "properties": {
    "schema": { "const": "chio.obligation.disposition.v1" },
    "obligationId": { "$ref": "#/$defs/digest" },
    "atomDigest": { "$ref": "#/$defs/digest" },
    "disposition": { "$ref": "#/$defs/disposition" },
    "version": { "$ref": "#/$defs/positiveInteger" },
    "lifecycleFence": { "$ref": "#/$defs/positiveInteger" },
    "lastTransition": { "$ref": "#/$defs/transition" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "disposition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "per_call" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "agreement_id", "creditor_id", "settlement_destination_ref"],
          "properties": {
            "kind": { "const": "assigned" },
            "agreement_id": { "$ref": "#/$defs/text" },
            "creditor_id": { "$ref": "#/$defs/text" },
            "settlement_destination_ref": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "channel_id", "reservation_id"],
          "properties": {
            "kind": { "const": "channelized" },
            "channel_id": { "$ref": "#/$defs/text" },
            "reservation_id": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "round_id"],
          "properties": {
            "kind": { "const": "clearing_reserved" },
            "round_id": { "$ref": "#/$defs/text" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "round_id", "satisfaction_digest"],
          "properties": {
            "kind": { "const": "clearing_satisfied" },
            "round_id": { "$ref": "#/$defs/text" },
            "satisfaction_digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    },
    "transition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "authority_digest"],
          "properties": {
            "kind": { "const": "produced" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation_id", "normalized_request_digest", "status_proof_digest", "agreement_id", "creditor_id", "settlement_destination_ref", "authority_digest"],
          "properties": {
            "kind": { "const": "assign" },
            "operation_id": { "$ref": "#/$defs/digest" },
            "normalized_request_digest": { "$ref": "#/$defs/digest" },
            "status_proof_digest": { "$ref": "#/$defs/digest" },
            "agreement_id": { "$ref": "#/$defs/text" },
            "creditor_id": { "$ref": "#/$defs/text" },
            "settlement_destination_ref": { "$ref": "#/$defs/text" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "channel_id", "reservation_id", "authority_digest"],
          "properties": {
            "kind": { "const": "reserve_channel" },
            "channel_id": { "$ref": "#/$defs/text" },
            "reservation_id": { "$ref": "#/$defs/text" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "round_id", "authority_digest"],
          "properties": {
            "kind": { "const": "reserve_clearing" },
            "round_id": { "$ref": "#/$defs/text" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "round_id", "abort_digest", "zero_dispatch_proof_digest", "authority_digest"],
          "properties": {
            "kind": { "const": "release_clearing" },
            "round_id": { "$ref": "#/$defs/text" },
            "abort_digest": { "$ref": "#/$defs/digest" },
            "zero_dispatch_proof_digest": { "$ref": "#/$defs/digest" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "round_id", "satisfaction_digest", "authority_digest"],
          "properties": {
            "kind": { "const": "satisfy_clearing" },
            "round_id": { "$ref": "#/$defs/text" },
            "satisfaction_digest": { "$ref": "#/$defs/digest" },
            "authority_digest": { "$ref": "#/$defs/digest" }
          }
        }
      ]
    }
  }
}
