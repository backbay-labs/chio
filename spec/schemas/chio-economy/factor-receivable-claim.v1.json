{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/factor-receivable-claim/v1",
  "title": "Chio Receivable Claim V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "claimId", "obligationId", "obligationAtomDigest", "sellerId",
    "receiptId", "receiptDigest", "iouId", "iouDigest", "payeeBindingDigest",
    "statusProofDigest", "faceValue", "dueAtUnixMs", "builtAtUnixMs"
  ],
  "properties": {
    "schema": { "const": "chio.factor.receivable-claim.v1" },
    "claimId": { "$ref": "#/$defs/digest" },
    "obligationId": { "$ref": "#/$defs/digest" },
    "obligationAtomDigest": { "$ref": "#/$defs/digest" },
    "sellerId": { "$ref": "#/$defs/text" },
    "receiptId": { "$ref": "#/$defs/text" },
    "receiptDigest": { "$ref": "#/$defs/digest" },
    "iouId": { "$ref": "#/$defs/text" },
    "iouDigest": { "$ref": "#/$defs/digest" },
    "payeeBindingDigest": { "$ref": "#/$defs/digest" },
    "statusProofDigest": { "$ref": "#/$defs/digest" },
    "faceValue": { "$ref": "#/$defs/positiveAmount" },
    "dueAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
    "builtAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "positiveAmount": {
      "type": "object", "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/positiveInteger" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
