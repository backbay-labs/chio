{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/clearing-participant-acceptance/v1",
  "title": "Chio Clearing Participant Acceptance V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "roundId",
        "roundCoreDigest",
        "outputManifestDigest",
        "participantStatementDigest",
        "participantId",
        "keyEpoch",
        "acceptedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.clearing.participant-acceptance.v1" },
        "roundId": { "$ref": "#/$defs/text" },
        "roundCoreDigest": { "$ref": "#/$defs/digest" },
        "outputManifestDigest": { "$ref": "#/$defs/digest" },
        "participantStatementDigest": { "$ref": "#/$defs/digest" },
        "participantId": { "$ref": "#/$defs/text" },
        "keyEpoch": { "$ref": "#/$defs/positiveInteger" },
        "acceptedAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
        "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
      }
    },
    "signerKey": { "$ref": "#/$defs/cryptoMaterial" },
    "signature": { "$ref": "#/$defs/cryptoMaterial" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "cryptoMaterial": { "type": "string", "minLength": 1, "maxLength": 16384 }
  }
}
