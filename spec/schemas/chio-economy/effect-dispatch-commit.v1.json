{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/effect-dispatch-commit/v1",
  "title": "Chio Economic Effect Dispatch Commit V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "commitId",
    "anchorId",
    "namespace",
    "previousCheckpointDigest",
    "committedCheckpointDigest",
    "effectSlotId",
    "effectHeadDigest",
    "casNonceDigest",
    "committedAt",
    "signerKeyId",
    "signerKeyEpoch",
    "anchorSignature"
  ],
  "properties": {
    "schema": { "const": "chio.economy.effect-dispatch-commit.v1" },
    "commitId": { "$ref": "#/$defs/digest" },
    "anchorId": { "$ref": "#/$defs/identifier" },
    "namespace": { "$ref": "#/$defs/identifier" },
    "previousCheckpointDigest": { "$ref": "#/$defs/digest" },
    "committedCheckpointDigest": { "$ref": "#/$defs/digest" },
    "effectSlotId": { "$ref": "#/$defs/digest" },
    "effectHeadDigest": { "$ref": "#/$defs/digest" },
    "casNonceDigest": { "$ref": "#/$defs/digest" },
    "committedAt": { "$ref": "#/$defs/positiveInteger" },
    "signerKeyId": { "$ref": "#/$defs/identifier" },
    "signerKeyEpoch": { "$ref": "#/$defs/positiveInteger" },
    "anchorSignature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9._:/-]+$"
    },
    "positiveInteger": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  }
}
