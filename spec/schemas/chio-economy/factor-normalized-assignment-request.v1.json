{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-economy/factor-normalized-assignment-request/v1",
  "title": "Chio Normalized Assignment Request V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "obligationId", "obligationAtomDigest", "claimDigest", "offerDigest",
    "sellerId", "buyerId", "buyerSettlementDestinationRef", "agreedPrice",
    "agreedDiscountBps", "expectedDispositionVersion",
    "expectedDispositionLifecycleFence", "expectedSettlementLifecycleVersion",
    "expectedSettlementLifecycleFence", "actionNonce", "effectiveAtUnixMs",
    "dueAtUnixMs", "expiresAtUnixMs"
  ],
  "properties": {
    "schema": { "const": "chio.factor.normalized-assignment-request.v1" },
    "obligationId": { "$ref": "#/$defs/digest" },
    "obligationAtomDigest": { "$ref": "#/$defs/digest" },
    "claimDigest": { "$ref": "#/$defs/digest" },
    "offerDigest": { "$ref": "#/$defs/digest" },
    "sellerId": { "$ref": "#/$defs/text" },
    "buyerId": { "$ref": "#/$defs/text" },
    "buyerSettlementDestinationRef": { "$ref": "#/$defs/text" },
    "agreedPrice": { "$ref": "#/$defs/amount" },
    "agreedDiscountBps": { "$ref": "#/$defs/basisPoints" },
    "expectedDispositionVersion": { "$ref": "#/$defs/positiveInteger" },
    "expectedDispositionLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
    "expectedSettlementLifecycleVersion": { "$ref": "#/$defs/positiveInteger" },
    "expectedSettlementLifecycleFence": { "$ref": "#/$defs/positiveInteger" },
    "actionNonce": { "$ref": "#/$defs/text" },
    "effectiveAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
    "dueAtUnixMs": { "$ref": "#/$defs/positiveInteger" },
    "expiresAtUnixMs": { "$ref": "#/$defs/positiveInteger" }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "text": {
      "type": "string", "minLength": 1, "maxLength": 2048,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F](?:[^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "safeInteger": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "positiveInteger": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
    "basisPoints": { "type": "integer", "minimum": 0, "maximum": 10000 },
    "amount": {
      "type": "object", "additionalProperties": false,
      "required": ["units", "currency"],
      "properties": {
        "units": { "$ref": "#/$defs/safeInteger" },
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
      }
    }
  }
}
