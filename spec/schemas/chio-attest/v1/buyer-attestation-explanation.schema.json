{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-attest/v1/buyer-attestation-explanation.schema.json",
  "title": "Chio Buyer Attestation Explanation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packageId",
    "packetId",
    "accepted",
    "verificationState",
    "failureCode",
    "checks"
  ],
  "properties": {
    "schema": { "const": "chio.attest.buyer-attestation-explanation.v1" },
    "packageId": { "type": "string", "minLength": 1 },
    "packetId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "verificationState": {
      "enum": ["strict_verified", "provisional", "fixture_only", "rejected", "unsupported_claim"]
    },
    "failureCode": {
      "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "checks": {
      "type": "array",
      "items": { "$ref": "#/$defs/check" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "passed", "severity", "artifactRole", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "severity": { "enum": ["info", "warning", "error"] },
        "artifactRole": { "type": "string", "minLength": 1 },
        "expectedSha256": { "$ref": "#/$defs/sha256" },
        "observedSha256": { "$ref": "#/$defs/sha256" },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
