{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-attest/v1/selective-disclosure-proof.schema.json",
  "title": "Chio Attest Selective Disclosure Proof",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "projection_version",
    "subject_sha256_hex",
    "ciphersuite",
    "issuer_fingerprint",
    "issuer_public_key_hex",
    "message_count",
    "disclosed_indices",
    "disclosed",
    "proof_nonce_hex",
    "proof_bytes_hex"
  ],
  "properties": {
    "schema": { "const": "chio.attest.selective-disclosure-proof.v1" },
    "projection_version": { "const": "chio.bbs-projection.workflow.v1" },
    "subject_sha256_hex": { "$ref": "#/$defs/sha256" },
    "ciphersuite": { "const": "BBS_BLS12381G1_XMD:SHA-256_SSWU_RO_" },
    "issuer_fingerprint": { "$ref": "#/$defs/sha256" },
    "issuer_public_key_hex": { "$ref": "#/$defs/hex" },
    "message_count": { "type": "integer", "minimum": 1 },
    "disclosed_indices": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 0 }
    },
    "disclosed": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/disclosedMessage" }
    },
    "proof_nonce_hex": { "$ref": "#/$defs/hex" },
    "proof_bytes_hex": { "$ref": "#/$defs/hex" }
  },
  "not": {
    "properties": {
      "schema": { "pattern": "\\.stub$" }
    },
    "required": ["schema"]
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "disclosedMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "field", "encoding", "bytes_hex"],
      "properties": {
        "index": { "type": "integer", "minimum": 0 },
        "field": { "type": "string", "minLength": 1 },
        "encoding": { "type": "string", "minLength": 1 },
        "bytes_hex": { "$ref": "#/$defs/hex" }
      }
    }
  }
}
