{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/governance-receipt.schema.json",
  "title": "Signed Chio Governance Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["body", "signerKey", "signature"],
  "properties": {
    "body": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "receiptId",
        "authorizingKernel",
        "caseKind",
        "authorizedLeaseId",
        "workflowId",
        "stepSha256",
        "issuedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "schema": { "const": "chio.governance-receipt.v1" },
        "receiptId": { "type": "string", "minLength": 1 },
        "authorizingKernel": { "type": "string", "minLength": 1 },
        "caseKind": { "const": "destructive_authorization" },
        "authorizedLeaseId": { "type": "string", "minLength": 1 },
        "workflowId": { "type": "string", "minLength": 1 },
        "stepSha256": { "$ref": "#/$defs/sha256" },
        "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
        "expiresAtUnixMs": { "type": "integer", "minimum": 0 }
      }
    },
    "signerKey": { "$ref": "#/$defs/hex" },
    "signature": { "$ref": "#/$defs/hex" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
