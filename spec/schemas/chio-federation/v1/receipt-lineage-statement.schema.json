{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/receipt-lineage-statement.schema.json",
  "title": "Chio Federation Receipt Lineage Statement",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "statementId",
    "parentReceiptSha256",
    "childReceiptSha256",
    "continuationSha256",
    "bilateralInvocationSha256",
    "evidenceClass",
    "sourceKernelId",
    "targetKernelId"
  ],
  "properties": {
    "schema": { "const": "chio.federation.receipt-lineage-statement.v1" },
    "statementId": { "type": "string", "minLength": 1 },
    "parentReceiptSha256": { "$ref": "#/$defs/sha256" },
    "childReceiptSha256": { "$ref": "#/$defs/sha256" },
    "continuationSha256": { "$ref": "#/$defs/sha256" },
    "bilateralInvocationSha256": { "$ref": "#/$defs/sha256" },
    "evidenceClass": {
      "type": "string",
      "enum": ["verified", "observed", "asserted", "unverifiable", "rejected"]
    },
    "sourceKernelId": { "type": "string", "minLength": 1 },
    "targetKernelId": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
