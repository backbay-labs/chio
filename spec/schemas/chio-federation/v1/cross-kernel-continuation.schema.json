{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/cross-kernel-continuation.schema.json",
  "title": "Chio Federation Cross-Kernel Continuation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "continuationId",
    "sourceKernelId",
    "targetKernelId",
    "parentReceiptSha256",
    "parentSessionAnchorSha256",
    "capabilityId",
    "actionClassId",
    "audienceTool",
    "nonce",
    "issuedAtUnixMs",
    "expiresAtUnixMs"
  ],
  "properties": {
    "schema": { "const": "chio.federation.cross-kernel-continuation.v1" },
    "continuationId": { "type": "string", "minLength": 1 },
    "sourceKernelId": { "type": "string", "minLength": 1 },
    "targetKernelId": { "type": "string", "minLength": 1 },
    "parentReceiptSha256": { "$ref": "#/$defs/sha256" },
    "parentSessionAnchorSha256": { "$ref": "#/$defs/sha256" },
    "capabilityId": { "type": "string", "minLength": 1 },
    "actionClassId": { "type": "string", "minLength": 1 },
    "audienceTool": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 1 },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
