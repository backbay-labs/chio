{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/revocation-checkpoint.schema.json",
  "title": "Chio Federation Revocation Checkpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "checkpointId",
    "issuedAtUnixMs",
    "expiresAtUnixMs",
    "epochHeight",
    "revokedKeyFingerprints"
  ],
  "properties": {
    "schema": { "const": "chio.federation.revocation-checkpoint.v1" },
    "checkpointId": { "type": "string", "minLength": 1 },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "epochHeight": { "type": "integer", "minimum": 0 },
    "revokedKeyFingerprints": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/sha256" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
