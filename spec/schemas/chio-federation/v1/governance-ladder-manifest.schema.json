{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/governance-ladder-manifest.schema.json",
  "title": "Chio Federation Governance Ladder Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "manifestId",
    "kernelId",
    "issuer",
    "keyId",
    "issuedAtUnixMs",
    "expiresAtUnixMs",
    "destructiveFloor",
    "defaultUnknownMode",
    "actionClasses"
  ],
  "properties": {
    "schema": { "const": "chio.federation.governance-ladder-manifest.v1" },
    "manifestId": { "type": "string", "minLength": 1 },
    "kernelId": { "type": "string", "minLength": 1 },
    "issuer": { "type": "string", "minLength": 1 },
    "keyId": { "type": "string", "minLength": 1 },
    "issuedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "destructiveFloor": { "$ref": "#/$defs/mode" },
    "defaultUnknownMode": { "const": "deny" },
    "actionClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actionClass" }
    }
  },
  "$defs": {
    "mode": {
      "type": "string",
      "enum": [
        "observation",
        "guarded",
        "receipt_backed",
        "partition_contingency",
        "maintenance"
      ]
    },
    "consistencyModel": {
      "type": "string",
      "enum": [
        "crdt-commutative",
        "totally-ordered",
        "single-kernel",
        "quorum-required"
      ]
    },
    "coSign": {
      "type": "string",
      "enum": ["none", "bilateral_if_cross_org", "bilateral_required", "n_of_m"]
    },
    "coSignQuorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "m", "scope"],
      "properties": {
        "n": { "type": "integer", "minimum": 2 },
        "m": { "type": "integer", "minimum": 2 },
        "scope": { "enum": ["treaty", "kernel", "operator"] }
      }
    },
    "label": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "actionClass": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "coSign": { "const": "n_of_m" } },
            "required": ["coSign"]
          },
          "then": { "required": ["coSignQuorum"] },
          "else": { "not": { "required": ["coSignQuorum"] } }
        }
      ],
      "required": [
        "actionClassId",
        "mode",
        "destructive",
        "consistencyModel",
        "coSign",
        "evidenceRequired"
      ],
      "properties": {
        "actionClassId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "destructive": { "type": "boolean" },
        "consistencyModel": { "$ref": "#/$defs/consistencyModel" },
        "coSign": { "$ref": "#/$defs/coSign" },
        "coSignQuorum": { "$ref": "#/$defs/coSignQuorum" },
        "evidenceRequired": {
          "type": "array",
          "items": { "$ref": "#/$defs/label" },
          "uniqueItems": true
        },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    }
  }
}
