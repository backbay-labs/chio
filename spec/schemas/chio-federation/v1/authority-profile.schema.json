{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/authority-profile.schema.json",
  "title": "Chio Federation Authority Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trustedBbsIssuers",
    "leaseAuthorities",
    "governanceAuthorities",
    "runtimePolicyIssuerPublicKeys",
    "revocationAuthority"
  ],
  "properties": {
    "schema": { "const": "chio.federation.authority-profile.v1" },
    "trustedBbsIssuers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "verifier-trust-bundle.schema.json#/$defs/trustedBbsIssuer" }
    },
    "leaseAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "verifier-trust-bundle.schema.json#/$defs/leaseAuthority" }
    },
    "governanceAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "verifier-trust-bundle.schema.json#/$defs/governanceAuthority" }
    },
    "runtimePolicyIssuerPublicKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hex" }
    },
    "revocationAuthority": { "$ref": "#/$defs/revocationAuthority" }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^[0-9a-f]+$" },
    "revocationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorityId",
        "keyId",
        "publicKey",
        "validFromUnixMs",
        "validUntilUnixMs",
        "status"
      ],
      "properties": {
        "authorityId": { "type": "string", "minLength": 1 },
        "keyId": { "type": "string", "minLength": 1 },
        "publicKey": { "$ref": "#/$defs/hex" },
        "validFromUnixMs": { "type": "integer", "minimum": 0 },
        "validUntilUnixMs": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["active", "inactive", "revoked"] }
      }
    }
  }
}
