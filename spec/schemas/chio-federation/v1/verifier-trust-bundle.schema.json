{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/verifier-trust-bundle.schema.json",
  "title": "Chio Federation Verifier Trust Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "trustedBbsIssuers",
    "peers",
    "vendors",
    "actionClasses",
    "workflowIntersections",
    "runtimePolicyIssuerPublicKeys",
    "leaseAuthorities",
    "governanceAuthorities",
    "disclosurePolicy",
    "revocation"
  ],
  "properties": {
    "schema": {
      "const": "chio.federation.verifier-trust-bundle.v1"
    },
    "trustedBbsIssuers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/trustedBbsIssuer"
      }
    },
    "peers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/peerLadderBinding"
      }
    },
    "vendors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/vendorKeyBinding"
      }
    },
    "actionClasses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/actionClass"
      }
    },
    "workflowIntersections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflowIntersectionTrust"
      }
    },
    "runtimePolicyIssuerPublicKeys": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/hex" }
    },
    "leaseAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/leaseAuthority"
      }
    },
    "governanceAuthorities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/governanceAuthority"
      }
    },
    "disclosurePolicy": {
      "$ref": "#/$defs/disclosurePolicy"
    },
    "revocation": {
      "$ref": "#/$defs/signedRevocationCheckpoint"
    }
  },
  "$defs": {
    "hex": {
      "type": "string",
      "pattern": "^[0-9a-f]+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "trustedBbsIssuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuerFingerprint",
        "publicKeyHex"
      ],
      "properties": {
        "issuerFingerprint": {
          "$ref": "#/$defs/sha256"
        },
        "publicKeyHex": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "ladderManifestRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifestId",
        "sha256",
        "issuedAtUnixMs",
        "expiresAtUnixMs"
      ],
      "properties": {
        "manifestId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "issuedAtUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "expiresAtUnixMs": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "peerLadderBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kernelId",
        "publicKey",
        "ladderManifestRef"
      ],
      "properties": {
        "kernelId": {
          "type": "string",
          "minLength": 1
        },
        "publicKey": {
          "$ref": "#/$defs/hex"
        },
        "ladderManifestRef": {
          "$ref": "#/$defs/ladderManifestRef"
        }
      }
    },
    "vendorKeyBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "vendorId",
        "publicKey"
      ],
      "properties": {
        "vendorId": {
          "type": "string",
          "minLength": 1
        },
        "publicKey": {
          "$ref": "#/$defs/hex"
        }
      }
    },
    "actionClass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actionClassId",
        "toolName",
        "kind"
      ],
      "properties": {
        "actionClassId": {
          "type": "string",
          "minLength": 1
        },
        "toolName": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "routine",
            "receipt_backed"
          ]
        }
      }
    },
    "workflowIntersectionTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intersectionId",
        "sha256"
      ],
      "properties": {
        "intersectionId": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "leaseAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issuer",
        "keyId",
        "publicKey",
        "validFromUnixMs",
        "validUntilUnixMs",
        "status",
        "allowedActionClasses"
      ],
      "properties": {
        "issuer": {
          "type": "string",
          "minLength": 1
        },
        "keyId": {
          "$ref": "#/$defs/sha256"
        },
        "publicKey": {
          "$ref": "#/$defs/hex"
        },
        "validFromUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "validUntilUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "active"
        },
        "allowedActionClasses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "scoped_observation",
              "delegated_action",
              "narrow_destructive"
            ]
          }
        }
      }
    },
    "governanceAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authorizingKernel",
        "keyId",
        "publicKey",
        "validFromUnixMs",
        "validUntilUnixMs",
        "status",
        "allowedCaseKinds"
      ],
      "properties": {
        "authorizingKernel": {
          "type": "string",
          "minLength": 1
        },
        "keyId": {
          "$ref": "#/$defs/sha256"
        },
        "publicKey": {
          "$ref": "#/$defs/hex"
        },
        "validFromUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "validUntilUnixMs": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "const": "active"
        },
        "allowedCaseKinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "const": "destructive_authorization"
          }
        }
      }
    },
    "disclosurePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "projectionVersion",
        "ciphersuite",
        "messageCount",
        "requiredDisclosedIndices",
        "requiredDisclosedFields"
      ],
      "properties": {
        "projectionVersion": {
          "const": "chio.bbs-projection.workflow.v1"
        },
        "ciphersuite": {
          "const": "BBS_BLS12381G1_XMD:SHA-256_SSWU_RO_"
        },
        "messageCount": {
          "type": "integer",
          "minimum": 1
        },
        "requiredDisclosedIndices": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "requiredDisclosedFields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "signedRevocationCheckpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body",
        "signerKey",
        "signature"
      ],
      "properties": {
        "body": {
          "$ref": "revocation-checkpoint.schema.json"
        },
        "signerKey": {
          "$ref": "#/$defs/hex"
        },
        "signature": {
          "$ref": "#/$defs/hex"
        }
      }
    }
  }
}
