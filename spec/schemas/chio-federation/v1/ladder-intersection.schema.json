{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/ladder-intersection.schema.json",
  "title": "Chio Federation Ladder Intersection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "intersectionId",
    "treatyId",
    "participantKernelIds",
    "ladderManifestSha256s",
    "generatedAtUnixMs",
    "expiresAtUnixMs",
    "actionClasses"
  ],
  "properties": {
    "schema": { "const": "chio.federation.ladder-intersection.v1" },
    "intersectionId": { "type": "string", "minLength": 1 },
    "treatyId": { "type": "string", "minLength": 1 },
    "participantKernelIds": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "ladderManifestSha256s": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/sha256" },
      "uniqueItems": true
    },
    "generatedAtUnixMs": { "type": "integer", "minimum": 0 },
    "expiresAtUnixMs": { "type": "integer", "minimum": 0 },
    "actionClasses": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/actionClass" }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mode": {
      "type": "string",
      "enum": [
        "observation",
        "guarded",
        "receipt_backed",
        "partition_contingency",
        "maintenance"
      ]
    },
    "consistencyModel": {
      "type": "string",
      "enum": [
        "crdt-commutative",
        "totally-ordered",
        "single-kernel",
        "quorum-required"
      ]
    },
    "coSign": {
      "type": "string",
      "enum": ["none", "bilateral_if_cross_org", "bilateral_required", "n_of_m"]
    },
    "coSignQuorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "m", "scope"],
      "properties": {
        "n": { "type": "integer", "minimum": 2 },
        "m": { "type": "integer", "minimum": 2 },
        "scope": { "enum": ["treaty", "kernel", "operator"] }
      }
    },
    "actionClass": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": { "coSign": { "const": "n_of_m" } },
            "required": ["coSign"]
          },
          "then": { "required": ["coSignQuorum"] },
          "else": { "not": { "required": ["coSignQuorum"] } }
        }
      ],
      "required": [
        "actionClassId",
        "mode",
        "destructive",
        "consistencyModel",
        "coSign",
        "evidenceRequired",
        "participantModes"
      ],
      "properties": {
        "actionClassId": { "type": "string", "minLength": 1 },
        "mode": { "$ref": "#/$defs/mode" },
        "destructive": { "type": "boolean" },
        "consistencyModel": { "$ref": "#/$defs/consistencyModel" },
        "coSign": { "$ref": "#/$defs/coSign" },
        "coSignQuorum": { "$ref": "#/$defs/coSignQuorum" },
        "evidenceRequired": {
          "type": "array",
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "uniqueItems": true
        },
        "participantModes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/mode" }
        }
      }
    }
  }
}
