{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-federation/v1/cross-boundary-admission-report.schema.json",
  "title": "Chio Federation Cross-Boundary Admission Report",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "accepted": { "const": false } },
        "required": ["accepted"]
      },
      "then": { "required": ["failureCode"] }
    },
    {
      "if": {
        "properties": { "coSign": { "const": "n_of_m" } },
        "required": ["coSign"]
      },
      "then": { "required": ["coSignQuorum"] },
      "else": { "not": { "required": ["coSignQuorum"] } }
    }
  ],
  "required": [
    "schema",
    "treatyId",
    "actionClassId",
    "accepted",
    "mode",
    "consistencyModel",
    "coSign",
    "requiredEvidence",
    "presentEvidence",
    "verifiedEvidence",
    "treatyScopeSha256",
    "ladderIntersectionSha256",
    "checks"
  ],
  "properties": {
    "schema": { "const": "chio.federation.cross-boundary-admission-report.v1" },
    "treatyId": { "type": "string", "minLength": 1 },
    "actionClassId": { "type": "string", "minLength": 1 },
    "accepted": { "type": "boolean" },
    "failureCode": { "type": "string", "minLength": 1 },
    "mode": { "$ref": "#/$defs/mode" },
    "consistencyModel": { "$ref": "#/$defs/consistencyModel" },
    "coSign": { "$ref": "#/$defs/coSign" },
    "coSignQuorum": { "$ref": "#/$defs/coSignQuorum" },
    "requiredEvidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "presentEvidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "verifiedEvidence": {
      "type": "array",
      "items": { "$ref": "#/$defs/evidenceRef" }
    },
    "treatyScopeSha256": { "$ref": "#/$defs/sha256" },
    "ladderIntersectionSha256": { "$ref": "#/$defs/sha256" },
    "expectedLadderIntersectionSha256": { "$ref": "#/$defs/sha256" },
    "checks": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "mode": {
      "enum": ["observation", "guarded", "receipt_backed", "partition_contingency", "maintenance"]
    },
    "consistencyModel": {
      "enum": ["crdt-commutative", "totally-ordered", "single-kernel", "quorum-required"]
    },
    "coSign": {
      "enum": ["none", "bilateral_if_cross_org", "bilateral_required", "n_of_m"]
    },
    "coSignQuorum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n", "m", "scope"],
      "properties": {
        "n": { "type": "integer", "minimum": 2 },
        "m": { "type": "integer", "minimum": 2 },
        "scope": { "enum": ["treaty", "kernel", "operator"] }
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceClass", "artifactSha256", "verified"],
      "properties": {
        "evidenceClass": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "artifactSha256": { "$ref": "#/$defs/sha256" },
        "verified": { "type": "boolean" }
      }
    }
  }
}
