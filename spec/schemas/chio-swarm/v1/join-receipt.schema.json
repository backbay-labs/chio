{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-swarm/v1/join-receipt.schema.json",
  "title": "Chio Swarm Join Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "joinId",
    "graphId",
    "chainId",
    "parentSetHash",
    "dagOrdinal",
    "hlcUnixMs",
    "parentTaskReceipts",
    "expectedParentReceiptIds",
    "actualParentReceiptIds",
    "joinPredicate",
    "resultDigest",
    "nextTaskId",
    "issuer",
    "signature"
  ],
  "properties": {
    "schema": {
      "const": "chio.swarm.join-receipt.v1"
    },
    "joinId": {
      "type": "string",
      "minLength": 1
    },
    "graphId": {
      "type": "string",
      "minLength": 1
    },
    "chainId": {
      "type": "string",
      "minLength": 1
    },
    "parentSetHash": {
      "$ref": "#/$defs/digest"
    },
    "dagOrdinal": {
      "type": "integer",
      "minimum": 1
    },
    "hlcUnixMs": {
      "type": "integer",
      "minimum": 0
    },
    "parentTaskReceipts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "receiptId"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "receiptId": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expectedParentReceiptIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actualParentReceiptIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "joinPredicate": {
      "type": "string",
      "minLength": 1
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nextTaskId": {
      "type": "string",
      "minLength": 1
    },
    "issuer": {
      "type": "string",
      "minLength": 1
    },
    "signature": {
      "type": "string",
      "pattern": "^[0-9a-f]{128}$"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
