{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio-protocol.dev/schemas/chio-swarm/v1/join-receipt.schema.json",
  "title": "Chio Swarm Join Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "joinId",
    "graphId",
    "expectedParentReceiptIds",
    "actualParentReceiptIds",
    "joinPredicate",
    "resultDigest",
    "nextTaskId"
  ],
  "properties": {
    "schema": {
      "const": "chio.swarm.join-receipt.v1"
    },
    "joinId": {
      "type": "string",
      "minLength": 1
    },
    "graphId": {
      "type": "string",
      "minLength": 1
    },
    "expectedParentReceiptIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actualParentReceiptIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "joinPredicate": {
      "type": "string",
      "minLength": 1
    },
    "resultDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nextTaskId": {
      "type": "string",
      "minLength": 1
    }
  }
}
