{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio/agent-passport/presentation/v2.schema.json",
  "$defs": {
    "membershipProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["leaf", "proof"],
      "properties": {
        "leaf": {
          "type": "object",
          "additionalProperties": false,
          "required": ["credentialId", "family", "credentialRefDigest"],
          "properties": {
            "credentialId": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/digest" },
            "family": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/passportCredentialFamily" },
            "credentialRefDigest": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/digest" }
          }
        },
        "proof": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tree_size", "leaf_index", "audit_path"],
          "properties": {
            "tree_size": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/positiveIJsonInteger" },
            "leaf_index": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/iJsonInteger" },
            "audit_path": {
              "type": "array",
              "maxItems": 64,
              "items": { "type": "string", "pattern": "^0x[0-9a-f]{64}$" }
            }
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "sourceManifest",
    "credentials",
    "membershipProofs",
    "challengeDigest",
    "presentationDigest"
  ],
  "properties": {
    "schema": { "const": "chio.financial-agent-passport.presentation.v1" },
    "sourceManifest": { "$ref": "https://chio.world/schemas/chio/agent-passport/source-manifest/v2.schema.json" },
    "credentials": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "https://chio.world/schemas/chio/agent-passport/v2.schema.json#/$defs/passportCredential" }
    },
    "membershipProofs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": { "$ref": "#/$defs/membershipProof" }
    },
    "challengeDigest": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/digest" },
    "presentationDigest": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/digest" }
  }
}
