{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio/fincred/settlement-reliability/v1.schema.json",
  "allOf": [
    { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/credential" },
    {
      "properties": {
        "schema": { "const": "chio.fincred.settlement-reliability.v1" },
        "family": { "const": "settlement_reliability" },
        "type": { "const": ["VerifiableCredential", "ChioSettlementReliabilityCredential"] },
        "credentialSubject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "claims"],
          "properties": {
            "family": { "const": "settlement_reliability" },
            "claims": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "onTimeCount", "obligationCount", "onTimeRatioBps"],
              "properties": {
                "id": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/did" },
                "onTimeCount": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "obligationCount": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
                "onTimeRatioBps": { "type": "integer", "minimum": 0, "maximum": 10000 }
              }
            }
          }
        }
      }
    }
  ]
}
