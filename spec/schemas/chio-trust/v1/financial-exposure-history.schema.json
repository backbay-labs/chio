{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio/fincred/exposure-history/v1.schema.json",
  "allOf": [
    { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/credential" },
    {
      "properties": {
        "schema": { "const": "chio.fincred.exposure-history.v1" },
        "family": { "const": "exposure_history" },
        "type": { "const": ["VerifiableCredential", "ChioExposureHistoryCredential"] },
        "credentialSubject": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "claims"],
          "properties": {
            "family": { "const": "exposure_history" },
            "claims": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "positions"],
              "properties": {
                "id": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/did" },
                "positions": {
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 64,
                  "items": { "$ref": "https://chio.world/schemas/financial-credential-defs/v1.schema.json#/$defs/exposurePosition" }
                }
              }
            }
          }
        }
      }
    }
  ]
}
