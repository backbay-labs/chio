# Build artifacts
/target/
/target-shared/
**/*.rs.bk
# Nested cargo/qualification output dirs at any depth (not the workspace root /target/).
**/target/
# Standalone shim crate: its lib Cargo.lock is regenerated on build, not tracked.
sdks/rust/chio-guard-sdk-compat/Cargo.lock

# Transient SQLite journal files must never be committed (only the .sqlite3
# fixture itself is tracked, never its write-ahead log or shared-memory file).
*.sqlite3-wal
*.sqlite3-shm

# Release SBOM evidence is committed under supply-chain/sbom/v{tag}/.
!supply-chain/sbom/
!supply-chain/sbom/**

# Local planning / orchestration state (not part of the published project)
.worktrees/
.planning/
# Local agent scratch (untracked; never commit)
.codex/
# Coverage output is generated; keep docs, not the dir
/coverage/

# Local cleanup-audit working notes
.cleanup-audit/

# Editor files
*.swp
*.swo
*~
.idea/
.vscode/
*.iml

# OS files
.DS_Store
Thumbs.db

# Environment
.env
.env.*
!tools/knowledge-base/.env.example

# Debug
*.pdb

# Generated conformance artifacts
/tests/conformance/results/generated/
/tests/conformance/reports/generated/
examples/**/artifacts/live/
examples/**/.artifacts/
examples/internet-of-agents-incident-network/workspaces/provider-lab/operations/
output/playwright/

# Generated Python packaging and cache artifacts
__pycache__/
*.py[cod]
tools/knowledge-base/.pytest_cache/
tools/knowledge-base/.venv/
tools/knowledge-base/.cocoindex/
examples/anthropic-sdk/node_modules/
examples/openai-compatible/node_modules/
examples/langchain/*.egg-info/
examples/langchain/.venv/
sdks/python/**/.venv/

# Generated JVM and .NET build artifacts
examples/**/.gradle/
sdks/**/.gradle/
examples/**/bin/
examples/**/obj/
sdks/dotnet/**/bin/
sdks/dotnet/**/obj/
# verdict-matrix deployment-shape driver build outputs (dotnet / jvm / go)
crates/tooling/chio-conformance/verdict_matrix/drivers/**/bin/
crates/tooling/chio-conformance/verdict_matrix/drivers/**/obj/
crates/tooling/chio-conformance/verdict_matrix/drivers/**/build/
crates/tooling/chio-conformance/verdict_matrix/drivers/**/.gradle/
crates/tooling/chio-conformance/verdict_matrix/drivers/k8s/k8s

# Generated coverage artifacts
/coverage/*
!/coverage/README.md
/fuzz/artifacts/
/fuzz/coverage/
/fuzz/target/

# Claude Code session
.claude/

# graphify generated knowledge graph (regenerated via `graphify update .`; never commit)
graphify-out/

# Lean build artifacts
formal/lean4/**/.lake/
**/.lake/build/
*.egg-info/

# Generated formal verification tool caches
formal/rust-verification/creusot-core/.why3find/
formal/rust-verification/creusot-core/target/
formal/rust-verification/creusot-core/verif/

# Build outputs (flagged by scripts/check-release-inputs.sh)
sdks/typescript/chio-ts/dist/
sdks/typescript/chio-ts/node_modules/
sdks/python/chio-py/build/
sdks/python/chio-py/src/*.egg-info/
crates/products/chio-cli/dashboard/dist/
crates/products/chio-cli/dashboard/node_modules/
tests/conformance/results/generated/
tests/conformance/reports/generated/

# sdks/typescript/scripts is the codegen tool pin install root used by
# `cargo xtask codegen --lang ts`. The package-lock.json is checked in
# (see xtask/codegen-tools.lock.toml [typescript] block); node_modules is
# regenerated via `npm ci` inside the script directory.
sdks/typescript/scripts/node_modules/

# docs-demo build outputs and per-package node_modules
docs/demo/dist/
docs/demo/node_modules/
docs/demo/test-results/
docs/demo/playwright-report/
docs/demo/.vite/

# Top-level workspace and TS SDK package node_modules
/node_modules/
sdks/typescript/packages/*/node_modules/

# wasm-pack output for the browser SDK (regenerated via build-wasm.sh)
sdks/typescript/packages/browser/pkg/
sdks/typescript/packages/browser/dist/
*.pyc
*.pyo
*.pyd
.codex_agent_runs/

# Apalache local model-check output (regenerated on each `apalache-mc check`)
_apalache-out/

# Raw cargo-mutants output (dated JSON summaries stay tracked)
audits/evidence/**/mutants.out/*.txt
