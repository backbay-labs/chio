[Unit]
Description=Chiodos pheromone relay scheduler tick

[Service]
Type=oneshot
User=chio-relay
Group=chio-relay
UMask=0077
ExecStart=/usr/local/bin/chio chiodos pheromone relay tick \
  --store /var/lib/chio-pheromone-relay/relay.sqlite3 \
  --peer-directory-state /etc/chio/peer-directory-state.json \
  --profile production \
  --trusted-issuers /etc/chio/trusted-peer-directory-issuers.json \
  --now-unix-ms 1766000000500 \
  --max-batches 32 \
  --signing-key /etc/chio/private/relay-signing-key.json \
  --report /var/lib/chio-pheromone-relay/reports/tick.json \
  --report-dir /var/lib/chio-pheromone-relay/reports
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/chio-pheromone-relay
