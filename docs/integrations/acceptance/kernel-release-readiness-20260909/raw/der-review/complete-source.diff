+    fn next(&mut self) -> Option<T> {
+        match &mut self.inner {
+            InnerIterRef::BytesRef(inner_reader) => {
+                if inner_reader.is_finished() {
+                    return None;
+                }
+
+                let next_val = T::decode(inner_reader).ok()?;
+                self.length -= 1;
+                Some(next_val)
