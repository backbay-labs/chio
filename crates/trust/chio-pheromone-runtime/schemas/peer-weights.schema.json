{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chio.world/schemas/chio-pheromone/v1/peer-weights.schema.json",
  "title": "Chio Pheromone Peer Weights",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "reputationEpoch", "weights"],
  "properties": {
    "schema": { "const": "chio.pheromone.peer-weights.v1" },
    "reputationEpoch": { "type": "integer", "minimum": 0 },
    "weights": {
      "type": "array",
      "items": { "$ref": "#/$defs/weight" }
    }
  },
  "$defs": {
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kernelId", "weight"],
      "properties": {
        "kernelId": { "type": "string", "minLength": 1 },
        "weight": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
